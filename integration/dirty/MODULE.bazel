"""Stage 4 E2E dirty scenario (issue #55): one failing child test.

`dx test //...` must exit 3 here (Bazel test-failure code, preserved
verbatim by `dx` per the CLI contract). Standalone workspace: only
`rules_dx` (local override, rewritten to an absolute path by the
`//tools/ci:e2e` harness at stage time) plus one failing `sh_test`.
Paired with `clean/` (exit 0), this proves the suite is not theater:
a detector stuck always-pass would fail this scenario; stuck
always-fail would fail `clean`.
"""

module(name = "e2e_dirty")

bazel_dep(name = "rules_dx", version = "0.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# RULES_DX_ROOT is a placeholder: the harness rewrites it to the
# absolute parent checkout path when staging (the staged copy lives
# outside the parent, so no relative path survives).
local_path_override(
    module_name = "rules_dx",
    path = "RULES_DX_ROOT",
)

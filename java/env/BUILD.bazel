"""Focused Java environment plans.

Each `java_env_plan` reads the analyzed authoritative providers of one
`java_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `JavaInfo` toolchain closure by reference.
Focused-target only; repository/root/exact-target orchestration remains M25.
"""

load("//java/env:plan.bzl", "java_env_plan")
load("//java/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

java_env_plan(
    testonly = True,
    name = "hello_lib_plan",
    target = "//java/tests/fixtures/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

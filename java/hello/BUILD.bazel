"""M23 seed Java binary and library; consumer of java_* wrappers."""

load("//java/rules:defs.bzl", "java_binary", "java_library", "java_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "hello_lib",
    srcs = ["Hello.java"],
)

java_binary(
    name = "hello",
    srcs = ["Main.java"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

java_test(
    name = "hello_test",
    srcs = ["HelloTest.java"],
    test_class = "hello.HelloTest",
    deps = [":hello_lib"],
)

# Repository corpus: build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. Java sources stay
# dx-owned, never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

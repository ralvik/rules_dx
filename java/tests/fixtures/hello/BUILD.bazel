"""Seed Java binary and library; consumer of java_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//java/rules:defs.bzl", "java_binary", "java_library", "java_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

java_library(
    name = "hello_lib",
    srcs = ["Hello.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
)

java_binary(
    name = "hello",
    srcs = ["Main.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

java_test(
    name = "hello_test",
    srcs = ["HelloTest.java"],
    aspect_hints = ["//quality:corpus_checkstyle_config"],
    test_class = "hello.HelloTest",
    deps = [":hello_lib"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Hello smoke test; no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    size = "small",
    timeout = "short",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

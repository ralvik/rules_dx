# Strict include identities (issue #503).
#
# Every quoted include contributes its basename and resolves strictly or
# fails generation: `cc/tests/fixtures/strict_generation/strict.h` ->
# `strict.h`. Angle includes are toolchain-provided and never produce an
# edge (`<string>`, `<vector>`). Macro includes contribute no edge and
# synthesize no ignore (`#define HDR "foo.h"` plus `#include HDR`).
# Comments, string literals, character literals, and raw strings are inert.
# Backslash-newline continuations are joined before matching.
# Generated dependencies are the deduplicated union of literal identities.

quoted: cc/tests/fixtures/strict_generation/strict.h -> strict.h
quoted: pkg/demo/helper.h -> helper.h
angle: <string> -> no edge (toolchain-provided)
angle: <vector> -> no edge (toolchain-provided)
macro: #define HDR "foo.h" plus #include HDR contributes no edge
inert: // #include "fake/comment.h" -> no edge
inert: /* #include "fake/block.h" */ -> no edge
inert: "#include \"fake/string.h\"" literal -> no edge
continuation: backslash-newline continuations are joined before matching
union: generated dependencies are the deduplicated union of literal identities

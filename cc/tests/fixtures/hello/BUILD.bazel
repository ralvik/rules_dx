
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "hello_lib",
    srcs = ["hello.cc"],
    hdrs = ["hello.h"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello_test.cc"],
    deps = [":hello_lib"],
)

cc_library(
    name = "hello_c_lib",
    srcs = ["hello.c"],
    hdrs = ["hello_c.h"],
)

cc_test(
    name = "hello_c_test",
    srcs = ["hello_c_test.c"],
    deps = [":hello_c_lib"],
)

sh_test(
    name = "hello_output_test",
    size = "small",
    timeout = "short",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

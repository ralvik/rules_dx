"""Seed C/C++ binary and library; consumer of cc_* wrappers."""

load("//cc/rules:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "hello_lib",
    srcs = ["hello.cc"],
    hdrs = ["hello.h"],
)

cc_binary(
    name = "hello",
    srcs = ["main.cc"],
    deps = [":hello_lib"],
)

cc_test(
    name = "hello_test",
    srcs = ["hello_test.cc"],
    deps = [":hello_lib"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

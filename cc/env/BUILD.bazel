load("//cc/env:plan.bzl", "cc_env_plan")
load("//cc/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

cc_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//cc/tests/fixtures/hello:hello_lib",
)

cc_env_plan(
    name = "hello_plan",
    testonly = True,
    target = "//cc/tests/fixtures/hello",
)

cc_env_plan(
    name = "hello_test_plan",
    testonly = True,
    target = "//cc/tests/fixtures/hello:hello_test",
)

cc_env_plan(
    name = "hello_c_lib_plan",
    testonly = True,
    target = "//cc/tests/fixtures/hello:hello_c_lib",
)

cc_env_plan(
    name = "hello_c_test_plan",
    testonly = True,
    target = "//cc/tests/fixtures/hello:hello_c_test",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
        ":hello_plan",
        ":hello_test_plan",
        ":hello_c_lib_plan",
        ":hello_c_test_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

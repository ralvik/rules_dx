"""Shared validated-codec helpers for proto shards (#72)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
    "//docs:__subpackages__",
    "//env:__subpackages__",
    "//generation:__subpackages__",
    "//quality:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_proto_validate` + `dx_proto_validate_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
# `prost` is a literal third-party label (not a crate_universe crate
# name), so it travels via `extra_deps`.
dx_rust_crate(
    name = "dx_proto_validate",
    package_name = "cli/dx_proto_validate",
    extra_deps = ["@rules_rust_prost//private/3rdparty/crates:prost"],
    deps = [],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""Shared schema-version helpers."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DOCS_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_DOCS_GENERATION_QUALITY)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_schema` + `dx_schema_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_schema",
    package_name = "cli/dx_schema",
    deps = [],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""Live `dx update` planning plus resolver backends."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_update` + `dx_update_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_update",
    package_name = "cli/dx_update",
    srcs = [
        "src/backend.rs",
        "src/lib.rs",
        "src/manifest.rs",
        "src/outcome.rs",
        "src/recovery.rs",
        "src/report.rs",
        "src/selector.rs",
        "src/semantics.rs",
        "src/sets.rs",
    ],
    extra_deps = [
        "//cli/path:dx_path",
    ],
    deps = [
        "regex",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

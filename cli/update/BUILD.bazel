"""Live `dx update` planning plus resolver backends (issue #19)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_update` + `dx_update_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_update",
    package_name = "cli/dx_update",
    srcs = [
        "src/lib.rs",
        "src/backend.rs",
        "src/outcome.rs",
        "src/report.rs",
        "src/selector.rs",
        "src/semantics.rs",
        "src/sets.rs",
    ],
    deps = ["thiserror"],
)

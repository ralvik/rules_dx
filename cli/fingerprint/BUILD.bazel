"""Canonical JSON rendering for plan fingerprints."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_DEPLOY_QUALITY")

package(default_visibility = VIS_CLI_DEPLOY_QUALITY)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_fingerprint` + `dx_fingerprint_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_fingerprint",
    package_name = "cli/dx_fingerprint",
    deps = [
        "serde",
        "serde_json",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

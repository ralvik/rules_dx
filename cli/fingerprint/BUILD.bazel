"""Canonical JSON rendering for plan fingerprints (#237)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate` (issue #239 pilot): emits
# `dx_fingerprint` + `dx_fingerprint_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_fingerprint",
    package_name = "cli/dx_fingerprint",
    deps = [
        "serde",
        "serde_json",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

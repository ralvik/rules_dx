"""WP3 apply boundary for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_apply` + `dx_apply_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_apply",
    package_name = "cli/dx_apply",
    srcs = [
        "src/applier.rs",
        "src/consensus.rs",
        "src/envelope.rs",
        "src/lib.rs",
        "src/validators.rs",
    ],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = [
        "serde",
        "serde_json",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

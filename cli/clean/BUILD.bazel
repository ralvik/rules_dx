"""M25 WP5 slice 1: explicit `dx clean` pruning of unselected managed generations (O60)."""

# gazelle:resolve rust dx_env //cli/env:dx_env
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_clean` + `dx_clean_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_clean",
    package_name = "cli/dx_clean",
    deps = [
        "globset",
        "ignore",
        "thiserror",
        "walkdir",
    ],
    extra_deps = [
        "//cli/env:dx_env",
        "//cli/setup:dx_setup",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    srcs = [
        "src/flags.rs",
        "src/inventory.rs",
        "src/live.rs",
        "src/planning.rs",
        "src/records.rs",
        "src/lib.rs",
    ],
)

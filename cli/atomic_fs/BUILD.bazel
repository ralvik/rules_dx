"""Race-free atomic filesystem writes shared by every apply/commit path."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_ENV_QUALITY")

package(default_visibility = VIS_CLI_ENV_QUALITY)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_atomic_fs` + `dx_atomic_fs_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_atomic_fs",
    package_name = "cli/dx_atomic_fs",
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = ["tempfile"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""Race-free atomic filesystem writes shared by every apply/commit path (#74)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = ["//visibility:public"])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_atomic_fs` + `dx_atomic_fs_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_atomic_fs",
    package_name = "cli/dx_atomic_fs",
    deps = ["tempfile"],
)

"""Unified digest identities: BLAKE3 canonical + SHA-256 envelope shim (#73)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = ["//visibility:public"])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_digest` + `dx_digest_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_digest",
    package_name = "cli/dx_digest",
    dev_deps = [
        "proptest",
    ],
    deps = [
        "blake3",
        "hex",
        "sha2",
        "thiserror",
    ],
)

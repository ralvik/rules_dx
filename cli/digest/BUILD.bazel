"""Unified digest identities: BLAKE3 canonical + SHA-256 envelope shim."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_GENERATION_QUALITY)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_digest` + `dx_digest_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_digest",
    package_name = "cli/dx_digest",
    dev_deps = [
        "proptest",
    ],
    deps = [
        "blake3",
        "hex",
        "sha2",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

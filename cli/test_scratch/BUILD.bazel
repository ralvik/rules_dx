"""Test-only scratch directories for dx crate tests."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`.
dx_rust_crate(
    name = "dx_test_scratch",
    package_name = "cli/dx_test_scratch",
    deps = ["tempfile"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

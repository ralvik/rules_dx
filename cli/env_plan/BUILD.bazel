""" WP2 slice 3: normalized env plan collection for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:resolve rust env_shard //env/env_shard
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_env_plan` + `dx_env_plan_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_env_plan",
    package_name = "cli/dx_env_plan",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    extra_deps = [
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/roots:dx_roots",
        "//env/env_shard",
    ],
    deps = [
        "serde",
        "serde_json",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""M25 WP1 slice 3: normalized codegen plan collection for the `dx` CLI."""

# gazelle:resolve rust codegen_shard //generation/codegen_shard
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_codegen` + `dx_codegen_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_codegen",
    package_name = "cli/dx_codegen",
    deps = [
        "serde",
        "serde_json",
        "thiserror",
    ],
    extra_deps = [
        "//cli/bep:dx_bep",
        "//cli/digest:dx_digest",
        "//cli/fingerprint:dx_fingerprint",
        "//cli/roots:dx_roots",
        "//generation/codegen_shard",
    ],
)

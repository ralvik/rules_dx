"""Pure consumer-CI planning (selection, revision, scheduling, supersession, reporting, fork/aggregate, rerun/scope/retry/scanning, triggers/platforms/no-op/revalidation, caller composition/pins, audit rendering, untrusted validation/thread deltas, preset onboarding)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

dx_rust_crate(
    name = "dx_ci",
    package_name = "cli/dx_ci",
    srcs = [
        "src/audit.rs",
        "src/caller.rs",
        "src/fork.rs",
        "src/lib.rs",
        "src/preset.rs",
        "src/reporting.rs",
        "src/rerun.rs",
        "src/revision.rs",
        "src/scheduling.rs",
        "src/selection.rs",
        "src/supersession.rs",
        "src/triggers.rs",
        "src/untrusted.rs",
    ],
    extra_deps = ["//cli/digest:dx_digest"],
    deps = ["thiserror"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

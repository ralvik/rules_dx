"""Pure consumer-CI planning (selection, revision, scheduling, supersession, reporting, fork/aggregate, rerun/scope/retry/scanning, triggers/platforms/no-op/revalidation, caller composition/pins, audit rendering, untrusted validation/thread deltas, preset onboarding)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_ci` + `dx_ci_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_ci",
    package_name = "cli/dx_ci",
    srcs = [
        "src/audit.rs",
        "src/caller.rs",
        "src/fork.rs",
        "src/lib.rs",
        "src/preset.rs",
        "src/reporting.rs",
        "src/rerun.rs",
        "src/revision.rs",
        "src/scheduling.rs",
        "src/selection.rs",
        "src/supersession.rs",
        "src/triggers.rs",
        "src/untrusted.rs",
    ],
    extra_deps = ["//cli/digest:dx_digest"],
    deps = ["thiserror"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

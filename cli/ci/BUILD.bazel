"""M27 WP1 slices 1-7 + WP2 slices 8-9 + WP4 slices 10-11 + WP6 slice 12: pure consumer-CI planning (selection, revision, scheduling, supersession, reporting, fork/aggregate, rerun/scope/retry/scanning, triggers/platforms/no-op/revalidation, caller composition/pins, audit rendering, untrusted validation/thread deltas, preset onboarding)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_ci` + `dx_ci_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_ci",
    package_name = "cli/dx_ci",
    deps = ["thiserror"],
    srcs = [
        "src/lib.rs",
        "src/revision.rs",
        "src/selection.rs",
    ],
)

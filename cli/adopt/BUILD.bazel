"""M30b slices 1-3: pure adoption-scaffolding planning (dx init absent-only writes, single-version pin and rollback, hook hermeticity/overwrite/status shape, devcontainer discipline, diagnostics naming, watch locality/scope, inspect forwarding, completion single-source)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_adopt` + `dx_adopt_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "serde_json",
        "thiserror",
    ],
    dev_deps = ["insta"],
    extra_deps = ["//cli/atomic_fs:dx_atomic_fs"],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    srcs = [
        "src/completion.rs",
        "src/lib.rs",
        "src/migrate.rs",
    ],
)

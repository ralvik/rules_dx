"""Pure adoption-scaffolding planning (dx init absent-only writes, single-version pin and rollback, hook hermeticity/overwrite/status shape, devcontainer discipline, diagnostics naming, watch locality/scope, inspect forwarding, completion single-source)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_adopt` + `dx_adopt_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_adopt",
    package_name = "cli/dx_adopt",
    srcs = [
        "src/completion.rs",
        "src/defaults.rs",
        "src/error.rs",
        "src/hooks.rs",
        "src/inspect.rs",
        "src/lib.rs",
        "src/migrate.rs",
        "src/new.rs",
        "src/policy.rs",
        "src/preset_fragment.rs",
        "src/scaffold.rs",
        "src/status.rs",
        "src/upgrade.rs",
        "src/version.rs",
        "src/watch.rs",
    ],
    dev_deps = ["insta"],
    extra_deps = [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/fingerprint:dx_fingerprint",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = [
        "notify",
        "notify-debouncer-mini",
        "semver",
        "serde",
        "serde_json",
        "thiserror",
        "toml",
    ],
)

exports_files(["src/version.rs"])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

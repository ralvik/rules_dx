"""M25 WP4 slice 3: repository-root strategy planning plus query/aggregate wiring, with the cold/warm freeze."""

load("//rust/rules:defs.bzl", "dx_rust_crate")
load(":roots.bzl", "repository_roots_file", "roots_aggregate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_roots` + `dx_roots_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
# `extra_starlark_srcs` keeps `roots.bzl` owned by `corpus` alongside
# `BUILD.bazel`, matching the pre-migration `real_source_target`.
dx_rust_crate(
    name = "dx_roots",
    package_name = "cli/dx_roots",
    deps = ["thiserror"],
    extra_starlark_srcs = ["roots.bzl"],
)

exports_files(["roots.bzl"])

# Query/aggregate wiring fixtures (M25 WP4 slice 2): the pattern file
# proves the `repository_roots_file` rule writes one label per line for
# `--target_pattern_file`, while the monolithic aggregate reserves the
# one-aggregate identity over the canonical repository-wide selections.
repository_roots_file(
    name = "roots_pattern_fixture",
    out = "roots_pattern_fixture.txt",
    roots = ["//..."],
)

roots_aggregate(
    name = "roots_monolith_fixture",
    deps = [
        "//dx:codegen",
        "//dx:env",
    ],
)

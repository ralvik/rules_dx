""" WP4 slice 3: repository-root strategy planning plus query/aggregate wiring, with the cold/warm freeze."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")
load(":roots.bzl", "repository_roots_file", "roots_aggregate")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_roots` + `dx_roots_test` + fmt/clippy tests + `Cargo.toml` export,
# identical to the hand-written stanzas. Corpus splits (`corpus_starlark`
# owning `BUILD.bazel` + `roots.bzl`, `corpus_toml` owning `Cargo.toml`)
# are owned by `dx generate`.
dx_rust_crate(
    name = "dx_roots",
    package_name = "cli/dx_roots",
    deps = ["thiserror"],
)

exports_files(["roots.bzl"])

# Query/aggregate wiring fixtures: the pattern file
# proves the `repository_roots_file` rule writes one label per line for
# `--target_pattern_file`, while the monolithic aggregate reserves the
# one-aggregate identity over the canonical repository-wide selections.
repository_roots_file(
    name = "roots_pattern_fixture",
    out = "roots_pattern_fixture.txt",
    roots = ["//..."],
)

roots_aggregate(
    name = "roots_monolith_fixture",
    deps = [
        "//dx:codegen",
        "//dx:env",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "roots.bzl",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

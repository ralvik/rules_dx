load("@rules_dx//quality:fixtures.bzl", "real_source_target")

"""M30a slices 1-4: pure documentation-delivery planning (IR version/identity, validation gate, check-vs-build modes, drift upgrade gate; guides/examples corpus shape; site-build action planning; dx docs invocation planning)."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_docs` + `dx_docs_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_docs",
    package_name = "cli/dx_docs",
    deps = ["thiserror"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

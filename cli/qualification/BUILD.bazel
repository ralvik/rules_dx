"""Pure release-qualification/publication planning (blocker disposition, support-label gate, API-change classification, registry exactness, artifact identity/packaging boundary, reproducibility/verification binding, coverage/aggregate/CI-requalification/publication-handoff gates, publication-input verification, public-install/incident discipline)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_qual` + `dx_qual_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_qual",
    package_name = "cli/dx_qual",
    deps = [],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""M25 WP3 slice 3: combined setup commit through the shared lock."""

# gazelle:resolve rust dx_env //cli/env:dx_env
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_setup` + `dx_setup_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_setup",
    package_name = "cli/dx_setup",
    dev_deps = ["insta"],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/env:dx_env",
        "//cli/roots:dx_roots",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = ["thiserror"],
)

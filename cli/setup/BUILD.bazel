""" WP3 slice 3: combined setup commit through the shared lock."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")

# gazelle:resolve rust dx_env //cli/env:dx_env
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_setup` + `dx_setup_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_setup",
    package_name = "cli/dx_setup",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    dev_deps = ["insta"],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/env:dx_env",
        "//cli/roots:dx_roots",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = ["thiserror"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

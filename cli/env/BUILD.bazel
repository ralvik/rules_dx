"""WP2 managed `.dx/bin` bootstrap installer crate."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Hand-written binary crate; see docs/generation/rust.md.

# Crate aliases match lockfile; tails hand-maintained, see docs/generation/rust.md.
rust_library(
    name = "dx_env",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "dx_env",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + [
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/digest:dx_digest",
        "//env:marker_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "env",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
    ),
    crate_name = "env",
    crate_root = "src/main.rs",
    data = ["//env:default_tree"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + [
        ":dx_env",
        "//cli/output:dx_output",
        "//cli/process:dx_process",
        "@rules_rust//rust/runfiles",
    ],
)

rust_test(
    name = "dx_env_test",
    size = "small",
    aliases = aliases(
        package_name = "cli/dx_env",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_env",
    deps = crate_deps(
        [
            "clap",
            "serde",
            "serde_json",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_env",
    ) + ["//cli/test_scratch:dx_test_scratch"],
)

# Binary-crate test (dx/cli precedent): compiles `src/main.rs` under the
# test harness so the thin shim enters the coverage report, where its
# LCOV exclusion evaluates to zero eligible lines. It runs no tests; the
# library unit tests live in `dx_env_test`. Hand-maintained: preserved
# across dependency regenerations like the runfiles and digest tails.
# keep
rust_test(
    name = "dx_env_bin_test",
    size = "small",
    crate = ":env",
    deps = [
        ":dx_env",
        "@rules_rust//rust/runfiles",
    ],
)

# Authoritative quality identities (pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_env_fmt_test",
    size = "small",
    targets = [
        ":dx_env",
        ":env",
    ],
)

rust_clippy_test(
    name = "dx_env_clippy_test",
    size = "small",
    targets = [
        ":dx_env",
        ":env",
    ],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# End-to-end bootstrap proof (gazelle sh_test precedent): runs the real
# `env` binary against a spaced path under Bazel runfiles
# No-coverage: process-spawning test; see docs/contributing/build-conventions.md.
sh_test(
    name = "bootstrap_test",
    srcs = ["bootstrap_test.sh"],
    args = ["$(rootpath :env)"],
    data = [
        ":env",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

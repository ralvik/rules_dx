"""Implementation-coverage gate promoted to a dx library crate."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_TOOLS")

package(default_visibility = VIS_CLI_TOOLS)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_lcov` + `dx_lcov_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_lcov",
    package_name = "cli/dx_lcov",
    srcs = [
        "src/ignores.rs",
        "src/inventory.rs",
        "src/lib.rs",
        "src/parse.rs",
        "src/run.rs",
        "src/verdict.rs",
    ],
    extra_deps = ["//cli/output:dx_output"],
    deps = [
        "clap",
        "lcov",
        "regex",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

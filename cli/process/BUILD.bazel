"""WP1 process boundary for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
    "//deploy:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_process` + `dx_process_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_process",
    package_name = "cli/dx_process",
    srcs = [
        "src/lib.rs",
        "src/lib_tests.rs",
    ],
    extra_test_deps = ["//cli/test_scratch:dx_test_scratch"],
    deps = [
        "libc",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

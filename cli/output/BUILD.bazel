"""M06 WP2 public output modes for the `dx` CLI."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
    "//env:__subpackages__",
    "//generation:__subpackages__",
    "//quality:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_output` + `dx_output_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_output",
    package_name = "cli/dx_output",
    deps = [
        "anstream",
        "clap",
        "console",
        "serde_json",
        "thiserror",
        "tracing",
        "tracing-subscriber",
    ],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//cli/schema:dx_schema",
    ],
    srcs = [
        "src/diagnostics.rs",
        "src/lib.rs",
    ],
)

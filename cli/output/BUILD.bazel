"""WP2 public output modes for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI_ENV_GENERATION_QUALITY")

package(default_visibility = VIS_CLI_ENV_GENERATION_QUALITY)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_output` + `dx_output_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_output",
    package_name = "cli/dx_output",
    srcs = [
        "src/changes.rs",
        "src/clap_errors.rs",
        "src/diagnostics.rs",
        "src/findings.rs",
        "src/lib.rs",
        "src/lifecycle.rs",
        "src/modes.rs",
        "src/severity.rs",
        "src/validation.rs",
    ],
    extra_deps = [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//cli/schema:dx_schema",
    ],
    deps = [
        "anstream",
        "clap",
        "console",
        "serde_json",
        "thiserror",
        "tracing",
        "tracing-subscriber",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

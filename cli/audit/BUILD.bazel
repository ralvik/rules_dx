"""Pure `dx audit` request planning (pending qualification)."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_audit` + `dx_audit_test` + fmt/clippy tests +
# `Cargo.toml` export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_audit",
    package_name = "cli/dx_audit",
    srcs = [
        "src/advisory.rs",
        "src/backend.rs",
        "src/curator.rs",
        "src/exception.rs",
        "src/lib.rs",
        "src/license_expr.rs",
        "src/license_notice.rs",
        "src/license_policy.rs",
        "src/license_policy_tests.rs",
        "src/locks.rs",
        "src/locks_go.rs",
        "src/locks_licenses.rs",
        "src/locks_tests.rs",
        "src/outcome.rs",
        "src/secrets.rs",
        "src/spdx.rs",
        "src/vuln.rs",
        "src/vuln_nuget.rs",
        "src/vuln_tests.rs",
    ],
    extra_deps = ["//cli/digest:dx_digest"],
    deps = [
        "cargo-lock",
        "chrono",
        "osv",
        "packageurl",
        "regex",
        "semver",
        "serde",
        "serde-sarif",
        "serde_json",
        "spdx",
        "thiserror",
        "toml",
        "url",
        "yaml_serde",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

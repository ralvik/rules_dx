"""M06 WP2 diff renderer for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_diff` + `dx_diff_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_diff",
    package_name = "cli/dx_diff",
    deps = [
        "similar",
        "thiserror",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

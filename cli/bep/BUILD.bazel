load("@rules_dx//quality:fixtures.bzl", "real_source_target")

"""M06 WP2 streaming BEP collector for the `dx` CLI."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_bep` + `dx_bep_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_bep",
    package_name = "cli/dx_bep",
    srcs = [
        "src/lib.rs",
        "src/outputs.rs",
        "src/test_outputs.rs",
    ],
    deps = [
        "serde_json",
        "thiserror",
        "url",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""M06 WP2 streaming BEP collector for the `dx` CLI."""

load("//rust/rules:defs.bzl", "dx_rust_crate")

package(default_visibility = [
    "//cli:__pkg__",
    "//cli:__subpackages__",
])

# M02 leaf-crate pattern via `dx_rust_crate` (issue #239): emits
# `dx_bep` + `dx_bep_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_bep",
    package_name = "cli/dx_bep",
    deps = [
        "serde_json",
        "thiserror",
        "url",
    ],
)

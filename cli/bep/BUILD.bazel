"""WP2 streaming BEP collector for the `dx` CLI."""

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_crate")
load("//tools/visibility:visibility.bzl", "VIS_CLI")

package(default_visibility = VIS_CLI)

# Leaf-crate pattern via `dx_rust_crate`: emits
# `dx_bep` + `dx_bep_test` + fmt/clippy tests + `Cargo.toml`
# export + `corpus`, identical to the hand-written stanzas.
dx_rust_crate(
    name = "dx_bep",
    package_name = "cli/dx_bep",
    srcs = [
        "src/lib.rs",
        "src/outputs.rs",
        "src/remote.rs",
        "src/test_outputs.rs",
    ],
    deps = [
        "serde_json",
        "tempfile",
        "thiserror",
        "url",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

# Dogfood draft release of the standalone `dx` binary (issue #182): the
# macro assembles the seed-host binary the publish dry-run workflow
# qualifies, so workflow and macro stay consistent instead of duplicating
# logic. Draft-only with the dry-run placeholder tag: publishing a real
# draft needs the tag pushed beforehand and explicit owner approval
# per issue #5.
github_release(
    name = "github_draft",
    artifacts = [":dx"],
)

# Seed-host standalone archive (issue #26): credential-free tarball +
# sha256 of the `dx` binary proving standalone packaging without Bazel
# or Rust at install time. Seed Linux x86_64 is qualified-built-here;
# the wider matrix (Linux arm64, macOS x86_64/arm64, Windows x86_64)
# stays unqualified per #5. Publisher-identity verification of the
# release bytes is `//deploy/install:dx_verify` (Sigstore bundle +
# identity/issuer, no checksum-only fallback); the bundle itself arrives
# with the owner-approved release via the human-run signing workflow.
archive_release(
    name = "dx_standalone",
    app = ":dx",
)

# Manual-page build step (issue #225): renders man/dx.1 from the clap
# grammar at build time so the page tracks parsing, `--help`, and
# completions. Release packaging (issue #26) consumes `:man_pages`.
rust_binary(
    name = "dx_man",
    srcs = ["src/bin_man.rs"],
    aliases = aliases(
        package_name = "cli/dx_cli",
        normal = True,
    ),
    crate_name = "dx_man",
    crate_root = "src/bin_man.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "base64",
            "chrono",
            "clap",
            "clap_complete",
            "clap_mangen",
            "libc",
            "quick-junit",
            "quick-xml",
            "serde",
            "serde_json",
            "strsim",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "cli/dx_cli",
    ) + [
        ":dx_cli",
        "//cli/output:dx_output",
    ],
)

genrule(
    name = "man_pages",
    outs = ["man/dx.1"],
    cmd = "$(location :dx_man) $(OUTS)",
    tools = [":dx_man"],
    visibility = ["//visibility:public"],
)


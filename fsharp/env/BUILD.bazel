"""Focused F# environment plans.

Each `fsharp_env_plan` reads the analyzed authoritative providers of one
`fsharp_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `DotnetAssembly*` toolchain closure by reference.
Focused-target only; repository/root/exact-target orchestration remains M25.
"""

load("//fsharp/env:plan.bzl", "fsharp_env_plan")
load("//fsharp/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

fsharp_env_plan(
    name = "hello_lib_plan",
    target = "//fsharp/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

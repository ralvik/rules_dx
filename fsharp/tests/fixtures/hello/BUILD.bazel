"""Seed F# binary and library; consumer of fsharp_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//fsharp/rules:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

fsharp_library(
    name = "hello_lib",
    srcs = ["Library.fs"],
    deps = ["@paket.main//fsharp.core"],
)

fsharp_binary(
    name = "hello",
    srcs = ["Program.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

fsharp_test(
    name = "hello_test",
    srcs = ["HelloTest.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

sh_test(
    name = "hello_output_test",
    size = "small",
    timeout = "short",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

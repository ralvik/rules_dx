"""M23 seed F# binary and library; consumer of fsharp_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//fsharp/rules:defs.bzl", "fsharp_binary", "fsharp_library", "fsharp_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

fsharp_library(
    name = "hello_lib",
    srcs = ["Library.fs"],
    deps = ["@paket.main//fsharp.core"],
)

fsharp_binary(
    name = "hello",
    srcs = ["Program.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

fsharp_test(
    name = "hello_test",
    srcs = ["HelloTest.fs"],
    deps = [
        ":hello_lib",
        "@paket.main//fsharp.core",
    ],
)

# Repository corpus: build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. F# sources stay
# dx-owned, never corpus sources.
# Hello smoke as a test target (#87, same pattern as
# //rust/hello:hello_output_test): asserts the seed binary prints the
# expected greeting. Tagged `no-coverage`: process-spawning tests stay
# out of the coverage denominator per the repo coverage preset. No corpus
# entry: shell sources have no `real_source_target` class.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello"],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

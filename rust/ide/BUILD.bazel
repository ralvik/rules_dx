"""Upstream Rust IDE tool acquisition.

The environment contract reuses the pinned patched rules_rust discovery
and flycheck binaries; this package pins their acquisition. Focused
exact-target projection evidence lives in the M12 completion report.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

sh_test(
    name = "ide_acquisition_test",
    srcs = ["ide_acquisition_test.sh"],
    args = [
        "$(rootpath @rules_rust//tools/rust_analyzer:gen_rust_project)",
        "$(rootpath @rules_rust//tools/rust_analyzer:flycheck)",
    ],
    data = [
        "//tools/sh:lib",
        "@rules_rust//tools/rust_analyzer:flycheck",
        "@rules_rust//tools/rust_analyzer:gen_rust_project",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

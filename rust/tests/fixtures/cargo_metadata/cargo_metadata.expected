# Cargo metadata expected generated targets (issue #502).
#
# Public Cargo metadata in `Cargo.toml` represents every generated target
# without private serialized dependency-graph access. Each row is
# `<Bazel target> (<rule kind>) from <Cargo target> (<Cargo kind>)`:
# - package `cargo-metadata` version `0.1.0` edition `2021` feeds the
#   build-script `version` plus single-version path checks.
# - same-name lib plus bin disambiguates to `cargo_metadata_lib` plus
#   `cargo_metadata` with the Rust crate name preserved.
# - `required-features` is absent here; a nonempty list fails with the
#   kept testonly plus explicit `crate_features` route, never an
#   unconditional target.
# - the build script sees only `[build-dependencies]`; lib/bin/test/
#   example/bench never link build deps.
# - `dylib` plus multiple crate types plus unknown kinds are rejected
#   with the kept handwritten-target route, never coerced.
# - one source has only one owner; the `Cargo.Bazel.lock`,
#   `cargo-bazel.json`, and private dependency maps are never read.

cargo_metadata_lib (rust_library) from cargo_metadata ([lib] ordinary library at src/lib.rs)
cargo_metadata (rust_binary) from cargo-metadata ([[bin]] binary at src/main.rs)
integration_test (rust_test) from integration ([[test]] libtest harness at tests/integration.rs)
custom_harness (rust_test with use_libtest_harness = False) from custom-harness ([[test]] custom harness at tests/custom_harness.rs)
demo_example (rust_binary) from demo ([[example]] ordinary binary at examples/demo.rs)
demo_example_test (rust_test) from demo ([[example]] test = true wrapper over demo_example)
plain_example (rust_binary) from plain ([[example]] ordinary binary at examples/plain.rs)
criterion_bench (rust_binary) from criterion ([[bench]] harness = false at benches/criterion.rs)
cargo_metadata_build_script (cargo_build_script) from build.rs ([package] build at build.rs, version 0.1.0, pkg_name cargo-metadata)

"""M00 seed Rust binary, library, and tests; M02 consumer of dx_rust_* wrappers."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_binary", "dx_rust_library", "dx_rust_proc_macro", "dx_rust_shared_library", "dx_rust_static_library", "dx_rust_test")
load("//rust/rules:probe.bzl", "dx_wrapper_cc_subject", "dx_wrapper_subject")
load("//rust/rules:wrapper_tests.bzl", "dx_wrapper_conformance_tests", "dx_wrapper_registry_tests")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "hello_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "rust/hello",
        normal = True,
    ),
    crate_name = "hello",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/hello",
    ),
)

dx_rust_binary(
    name = "hello",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "rust/hello",
        normal = True,
    ),
    crate_name = "hello",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/hello",
    ) + [":hello_lib"],
)

# Authoritative quality identities (M02): rustfmt and Clippy resolve from
# the pinned toolchain, never from ambient host tools. Each wrapper is
# listed explicitly: lint aspects apply to the wrapper's own CrateInfo and
# do not traverse the private `_dx_upstream` edge.
rustfmt_test(
    name = "hello_fmt_test",
    size = "small",
    targets = [
        ":hello_lib",
        ":hello",
    ],
)

rust_clippy_test(
    name = "hello_clippy_test",
    size = "small",
    targets = [
        ":hello_lib",
        ":hello",
    ],
)

# M12 flavor wrappers: one subject per new dx_rust_* shape (proc macro,
# shared library, static library). No external dependencies: the
# conformance probe pins forwarding, not dependency plumbing. Cargo cannot
# express these flavors in one package, so each rule is handwritten and
# kept across regenerations.
# keep
dx_rust_proc_macro(
    name = "hello_derive",
    srcs = ["src/derive.rs"],
    crate_name = "hello_derive",
    crate_root = "src/derive.rs",
    edition = "2021",
)

# keep
dx_rust_shared_library(
    name = "hello_cdylib",
    srcs = ["src/cdylib.rs"],
    crate_name = "hello_cdylib",
    crate_root = "src/cdylib.rs",
    edition = "2021",
)

# keep
dx_rust_static_library(
    name = "hello_staticlib",
    srcs = ["src/staticlib.rs"],
    crate_name = "hello_staticlib",
    crate_root = "src/staticlib.rs",
    edition = "2021",
)

# Separate lint identities (M12): the M02 hello_fmt_test/hello_clippy_test
# pins stay untouched, so the new shapes get their own lint tests with
# their own marker sets.
rustfmt_test(
    name = "hello_flavors_fmt_test",
    size = "small",
    targets = [
        ":hello_cdylib",
        ":hello_derive",
        ":hello_staticlib",
    ],
)

rust_clippy_test(
    name = "hello_flavors_clippy_test",
    size = "small",
    targets = [
        ":hello_cdylib",
        ":hello_derive",
        ":hello_staticlib",
    ],
)

exports_files([
    "Cargo.toml",
    "Cargo.lock",
])

# Conformance subjects (M02): same package as the private `_dx_upstream`
# targets so the probe can observe both sides of the forwarding boundary.
dx_wrapper_subject(
    name = "hello_lib_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_lib_dx_upstream",
    wrapper = ":hello_lib",
)

dx_wrapper_subject(
    name = "hello_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_dx_upstream",
    wrapper = ":hello",
)

dx_wrapper_subject(
    name = "hello_test_subject",
    testonly = True,
    clippy_test = ":hello_clippy_test",
    fmt_test = ":hello_fmt_test",
    upstream = ":hello_test_dx_upstream",
    wrapper = ":hello_test",
)

dx_wrapper_subject(
    name = "hello_derive_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_derive_dx_upstream",
    wrapper = ":hello_derive",
)

dx_wrapper_cc_subject(
    name = "hello_cdylib_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_cdylib_dx_upstream",
    wrapper = ":hello_cdylib",
)

dx_wrapper_cc_subject(
    name = "hello_staticlib_subject",
    testonly = True,
    clippy_test = ":hello_flavors_clippy_test",
    fmt_test = ":hello_flavors_fmt_test",
    upstream = ":hello_staticlib_dx_upstream",
    wrapper = ":hello_staticlib",
)

dx_wrapper_registry_tests(name = "wrapper_registry_tests")

dx_wrapper_conformance_tests(
    name = "wrapper_conformance_tests",
    subjects = [
        ":hello_lib_subject",
        ":hello_subject",
        ":hello_test_subject",
        ":hello_derive_subject",
        ":hello_cdylib_subject",
        ":hello_staticlib_subject",
    ],
)

# Repository corpus (M05 WP1): build file and manifest owned for
# direct-Bazel dogfood under the canonical real_fixture_policy. Rust
# sources stay dx-owned (M02 wrappers), never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

dx_rust_test(
    name = "hello_test",
    aliases = aliases(
        package_name = "rust/hello",
        normal = True,
        normal_dev = True,
    ),
    crate = ":hello_lib",
    deps = crate_deps(
        ["anyhow"],
        package_name = "rust/hello",
    ),
)

"""Validation/codec helpers plus the shard writer for codegen plan shards."""

# gazelle:resolve rust proto //generation:codegen_proto_rs
# gazelle:resolve rust codegen_proto //generation:codegen_proto_rs
load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "codegen_shard",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
    ),
    crate_name = "codegen_shard",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
        ],
        package_name = "generation/codegen_shard",
    ) + [
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//generation:codegen_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_binary(
    name = "codegen_shard_writer",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
    ),
    crate_name = "codegen_shard_writer",
    crate_root = "src/main.rs",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
            "tracing",
        ],
        package_name = "generation/codegen_shard",
    ) + [":codegen_shard", "//cli/output:dx_output"],
)

rust_test(
    name = "codegen_shard_test",
    size = "small",
    aliases = aliases(
        package_name = "generation/codegen_shard",
        normal = True,
        normal_dev = True,
    ),
    crate = ":codegen_shard",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
        ],
        package_name = "generation/codegen_shard",
    ) + [
        "//generation:codegen_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "codegen_shard_fmt_test",
    size = "small",
    targets = [
        ":codegen_shard",
        ":codegen_shard_writer",
    ],
)

rust_clippy_test(
    name = "codegen_shard_clippy_test",
    size = "small",
    targets = [
        ":codegen_shard",
        ":codegen_shard_writer",
    ],
)

exports_files(["Cargo.toml"])

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

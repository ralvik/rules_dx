"""Validation and codec helpers for the generation result manifest."""

# M13: this package's `proto` alias re-exports generation's schema
# (`pub use result_proto::dx::generation::v1 as proto`), not quality's, so
# the package-scoped resolves override both spellings the scanner sees: the
# `use proto::{...}` alias and the `pub use result_proto::...` re-export. The
# root mappings point both at quality; without the overrides generation would
# gain a bogus `//quality:result_proto_rs` edge whose `result_proto` extern
# collides with `//generation:result_proto_rs`.
# gazelle:resolve rust proto //generation:result_proto_rs
# gazelle:resolve rust result_proto //generation:result_proto_rs
load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "generation_result",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "generation/generation_result",
        normal = True,
    ),
    crate_name = "generation_result",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["thiserror"],
        package_name = "generation/generation_result",
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//cli/schema:dx_schema",
        "//generation:result_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_test(
    name = "generation_result_test",
    size = "small",
    aliases = aliases(
        package_name = "generation/generation_result",
        normal = True,
        normal_dev = True,
    ),
    crate = ":generation_result",
    deps = crate_deps(
        ["thiserror"],
        package_name = "generation/generation_result",
    ) + ["//generation:result_proto_rs"],
)

rustfmt_test(
    name = "generation_result_fmt_test",
    size = "small",
    targets = [":generation_result"],
)

rust_clippy_test(
    name = "generation_result_clippy_test",
    size = "small",
    targets = [":generation_result"],
)

exports_files(["Cargo.toml"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""rules_dx: Bazel-first developer platform."""

module(
    name = "rules_dx",
    # 0.0.0: no releases are cut from this repository; consumers pin
    # reviewed commits (see CONTRIBUTING.md).
    version = "0.0.0",
)

# Seed pins, frozen from executed runs on the seed host.
# Bazel itself is pinned via the canonical `.bazelversion` (Bazelisk v1.29.0
# from `.github/actions/setup-bazelisk/action.yml` -> Bazel 9.2.0);
# `//tools/ci:pin_consistency_test` fails on drift.
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Pinned C/C++ test runner (ADR 0019). 1.18.0 is the
# latest stable in the Bazel Central Registry (verified against Bazel 9.2.0
# on the seed host); the 1.18.x line requires C++17 or newer per the
# upstream release notes, and the qualified toolchain floor covers it
# (qualified seed-only under issue #479 via
# `bazel run //tools/ci:googletest_qualification` with
# `cc/tests/fixtures/googletest/` over `@googletest//:gtest_main`;
# living at head rejected per the dx pin policy). MSVC interop plus SDK
# licensing stay open under ADR 0019.
bazel_dep(name = "googletest", version = "1.18.0")

# Direct dep for the artifact-metadata generator. 1.9.0 is the
# MVS-selected version in the executed graph (via aspect_rules_py 2.x).
bazel_dep(name = "rules_python", version = "1.9.0")

# Go toolchain for the first-party Rust Gazelle extension
# (ADR 0015). Pinned from the Bazel Central Registry; versions verified
# against Bazel 9.2.0 on the seed host.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.52.2")
bazel_dep(name = "rules_shell", version = "0.6.1")

gazelle_go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
# Pinned Go module deps (ADR 0019). Single-module go.mod via from_file
# (qualified seed-only under issue #483 via
# `bazel run //tools/ci:godeps_qualification` with
# `go/tests/fixtures/godeps/pins.bzl` plus the go-cmp fixture consumer;
# hand module tags rejected per Gazelle preferred; go.work only for
# multi-module layouts). Versions match gazelle 0.52.2 go.mod so the shared
# go_deps extension sees no version conflict.
gazelle_go_deps.from_file(go_mod = "//third_party/go:go.mod")
use_repo(gazelle_go_deps, "com_github_bazelbuild_buildtools", "com_github_google_go_cmp", "com_github_pmezard_go_difflib")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.6")

# Direct dep so MODULE tags can name execution-platform
# constraints. 1.1.0 is the MVS-selected version already in the executed
# graph (see the root-module warning that proposed it).
bazel_dep(name = "platforms", version = "1.1.0")

# Explicit direct deps (versions match the transitive pins above
# where they overlap, so MVS keeps the executed tree). `protobuf`/`protoc`
# itself stays transitive via rules_proto/rules_rust_prost (it resolves above
# their declared minimums, so a root pin would only add a direct-dep warning).
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust_prost", version = "0.74.0")

# Pinned Java foundation (ADR 0019). Latest stable
# per ADR 0008 currency (9.7.0, Bazel >=7.0.0; verified against Bazel 9.2.0
# on the seed host). Remote-JDK toolchain configs register through the
# upstream module; per-platform JDK acquisition selection stays open under
# ADR 0019 (the hermetic `--java_runtime_version` route from the support matrix).
bazel_dep(name = "rules_java", version = "9.7.0")

# Pinned Kotlin foundation (ADR 0019). 2.4.10 is the
# latest stable in the Bazel Central Registry (Bazel >=7.1 per upstream);
# verified against Bazel 9.2.0 on the seed host. Builds on the same JVM
# toolchain and Maven-lock story as Java; kotlinc acquisition and worker
# behavior stay open under ADR 0019.
bazel_dep(name = "rules_kotlin", version = "2.4.10")

# Pinned Scala foundation, managed route (ADR 0019;
# ADR 0019 route decision). 7.3.0 is the latest stable in the Bazel Central
# Registry (Bazel >=7.1 per upstream); verified against Bazel 9.2.0 on the
# seed host. Scala 2.13.18 is the default toolchain version (latest 2.13.x
# in the upstream-supported list); Coursier-fetched toolchains share Java's
# Maven-lock story, so no new Maven lock members land here. Scalafix
# semantic rules need semanticdb plus classpath wiring (open under ADR 0019).
bazel_dep(name = "rules_scala", version = "7.3.0")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.18")
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
scala_deps.scalatest()

# Pinned .NET foundation (ADR 0019). 0.22.1 is the
# latest stable in the Bazel Central Registry (Bazel >=9.0.0 per upstream;
# verified against Bazel 9.2.0 on the seed host). One ruleset covers both
# admitted .NET languages (csharp_* plus fsharp_* targets) with SDK
# acquisition through its `dotnet` toolchain extension. SDK 10.0.201 is the
# upstream-CI toolchain version (matches rules_dotnet's own MODULE pin);
# the default target framework is net10.0 (wrapper default, overridable per
# target). Per-platform SDK acquisition stays open
# under ADR 0019 per the provisional test-runner/lock tables; the xUnit v3
# 4.0.0 runner is pinned (issue #477) and the Paket lock wiring is qualified
# seed-only (issue #482). Needs bazel_lib 3.7.0 (rules_dotnet dep; MVS
# keeps the executed tree on our other pins).
bazel_dep(name = "rules_dotnet", version = "0.22.1")
bazel_dep(name = "bazel_lib", version = "3.7.0")

dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "10.0.201")
use_repo(dotnet, "dotnet_toolchains")

# Pinned NuGet resolver (ADR 0019). Single
# shared Paket lock for the admitted .NET foundations (C#, F#) per the
# support matrix: `paket.dependencies` plus `paket.lock` via `paket2bazel`
# into the `paket.main` hub carrying per-package sha512 (qualified seed-only
# under issue #482 via `bazel run //tools/ci:paket_qualification` with
# `csharp/tests/fixtures/paket/pins.bzl` plus hello/xunit hub consumers;
# generation consumes the Paket files and never writes them; NuGet native
# `packages.lock.json` rejected per rules_dotnet issue 444). Members are
# FSharp.Core 10.1.201 (F# assemblies need the runtime asset next to
# the app) plus the xUnit v3 4.0.0 runner closure (issue #477:
# xunit.v3 4.0.0 plus xunit.analyzers 2.0.0 with the MTP runner
# transitive). Regenerate with:
#   bazel run @rules_dotnet//tools/paket2bazel -- --dependencies-file
#   $PWD/third_party/dotnet/paket.dependencies --output-folder
#   $PWD/third_party/dotnet/deps
dotnet_nuget = use_extension("//third_party/dotnet/deps:paket.main_extension.bzl", "main_extension")
use_repo(dotnet_nuget, "paket.main")

# Pinned Maven resolver (ADR 0019). 7.1 is the
# latest stable in the Bazel Central Registry (Bazel >=7.0.0; verified
# against Bazel 9.2.0 on the seed host). Single shared lock for the admitted
# JVM foundations (Java, Kotlin, Scala managed route) per the support
# matrix: `maven_install.json` plus fail-closed repin checking (qualified
# seed-only under issue #481 via `bazel run //tools/ci:maven_lock_qualification`
# with `third_party/jvm/pins.bzl` plus the Java/Kotlin `@maven` fixtures;
# non-fail-closed rejected). JUnit 4.13.2
# seed (latest 4.x; hamcrest-core 1.3 arrives transitively) plus JUnit 6.1.3
# Jupiter/Platform/Vintage line (qualified seed-only under issue #476; JDK 17+
# per the JUnit 6 baseline, remotejdk_21 on the seed host); the 5.14.x fallback
# line (Jupiter 5.14.4 plus Platform 1.14.4 for JDK <17) stays pinned in
# `java/tests/fixtures/junit/pins.bzl` and is selected by swapping the same
# coordinates, never by floating the runner. Repository order lists the GCS
# Maven Central mirror first: this host's egress proxy serves it while
# repo1.maven.org answers Cloudflare challenges; the pinned lock hashes make
# the order irrelevant to artifact identity.
bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "junit:junit:4.13.2",
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.jupiter:junit-jupiter-params:6.1.3",
        "org.junit.platform:junit-platform-commons:6.1.3",
        "org.junit.platform:junit-platform-engine:6.1.3",
        "org.junit.platform:junit-platform-launcher:6.1.3",
        "org.junit.platform:junit-platform-console:6.1.3",
        "org.junit.vintage:junit-vintage-engine:6.1.3",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//third_party/jvm:maven_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

# Pinned Python foundation (ADR 0010). Exact 2.x prerelease is an
# explicit exception to ADR 0008 until a compatible stable 2.x exists.
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")

# Pinned JavaScript/TypeScript foundation (ADR 0013). Exact
# latest-stable per selection policy; versions verified against Bazel 9.2.0
# on the seed host (all require Bazel >=7.6.0/>=7.0.0).
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.0")
bazel_dep(name = "aspect_rules_jest", version = "0.26.0")

# TypeScript toolchain (ADR 0012 release-default). 5.9.3 is
# the latest stable 5.x in TOOL_VERSIONS of aspect_rules_ts 3.10.0; 6.x is
# the native preview and stays out. Integrity resolves from the mirrored
# TOOL_VERSIONS entry, so no manual integrity is pinned here.
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "5.9.3")
use_repo(typescript, "npm_typescript")

# Pnpm toolchain for the authoritative JS/TS package graph
# (ADR 0013). Version resolves from the root package.json packageManager
# field (pnpm 10.34.5); builds never invoke the package manager.
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# Authoritative pnpm graph (jest + framework runtimes; see
# docs/tools/tool-acquisition.md). The lock is generated with the
# Bazel-pinned pnpm (`BAZEL_BINDIR=. bazel-bin/.../pnpm install
# --lockfile-only`); builds never invoke the package manager.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)

# Private pure-JavaScript tool graph (ESLint + Prettier; see
# docs/tools/tool-acquisition.md). Separate `npm_tools` hub so the tool
# closure stays private: consumers never touch this lock or hub labels;
# public entry points live under //quality/tools/javascript. Shares the
# single root `.npmrc` (hoist=false) and the managed Node 22 toolchain
# (no ambient Node, no lifecycle scripts via allowBuilds: {}).
npm.npm_translate_lock(
    name = "npm_tools",
    npmrc = "//:.npmrc",
    pnpm_lock = "//quality/tools/javascript:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm", "npm_tools")

python_interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
python_interpreters.toolchain(python_version = "3.12")
use_repo(python_interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

# Align rules_python default with the ADR 0012 release-default
# (3.12). rules_python ships its own 3.11 default toolchain; without this
# the aspect transition falls back to 3.11 and venvs resolve to
# rules_python's 3.11 interpreter despite the 3.12 pin above.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12")

# Authoritative uv graph for the Python hello fixture. Source-only
# local graphs remain possible without this metadata; the hello test closure
# uses it for pytest/coverage.
uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(hub_name = "pypi")
uv.project(
    hub_name = "pypi",
    lock = "//python/tests/fixtures/hello:uv.lock",
    pyproject = "//python/tests/fixtures/hello:pyproject.toml",
)

# Private wheel-only Python tool graph (pydoclint + flake8 cohort,
# dep_group dx-python-tools) in the single pypi hub. Consumers never touch
# the lock or hub labels; public entry points live under
# //quality/tools/python.
uv.project(
    hub_name = "pypi",
    lock = "//quality/tools/python:uv.lock",
    pyproject = "//quality/tools/python:pyproject.toml",
)
use_repo(uv, "pypi")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # Couple rustfmt to the selected stable toolchain instead of
    # the rules_rust nightly default, so rustfmt follows toolchain updates
    # exactly like Clippy with no second nightly pin.
    rustfmt_version = "1.98.0",
    # Pinned default of rules_rust 0.74.0 (rust/private/common.bzl),
    # verified from the executed 0.74.0 module tree.
    versions = ["1.98.0"],
    # Issue #411: static-musl Rust std for both Linux profiles. The
    # hermetic-llvm static-only musl targets (native-toolchains.md) are
    # the provisional C/C++ backend; Rust needs its own musl std here so
    # static native closures resolve. Build scripts/proc macros keep
    # execution-platform tools while apps link target musl libs per the
    # build-script contract (docs/generation/rust.md#build-scripts):
    # prebuilt glibc libraries never become musl-compatible by linker
    # change alone. Dynamic musl stays explicitly out of scope.
    extra_target_triples = [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# External-dependency fixture source of truth (WP2). The lockfile is
# regenerated via crate_universe repin on the seed host:
#   CARGO_BAZEL_REPIN=1 bazel build //rust/tests/fixtures/hello:hello
#
# Shell-env contract (issue #472): third-party `cargo_build_script` targets
# render without an explicit `use_default_shell_env` and defer to the global
# `@rules_rust//cargo/settings:use_default_shell_env` flag, pinned `False`
# in `.bazelrc`. A crate that genuinely needs host `PATH` probing opts back
# in narrowly with e.g.
#   crate.annotation(crate = "<name>", build_script_use_default_shell_env = "on")
# Currently zero opt-ins: every third-party script stays hermetic and takes
# only declared `build_script_tools`/`data`/`build_script_env` inputs.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rust/tests/fixtures/hello:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = [
        "//rust/tests/fixtures/hello:Cargo.toml",
        "//generation/result:Cargo.toml",
        "//quality/adapter:Cargo.toml",
        "//quality/evaluator:Cargo.toml",
        "//quality/markdown:Cargo.toml",
        "//quality/result:Cargo.toml",
        "//quality/runner:Cargo.toml",
        "//cli/process:Cargo.toml",
        "//cli/apply:Cargo.toml",
        "//cli/atomic_fs:Cargo.toml",
        "//cli/adopt:Cargo.toml",
        "//cli/setup:Cargo.toml",
        "//cli/clean:Cargo.toml",
        "//cli/audit:Cargo.toml",
        "//cli/output:Cargo.toml",
        "//cli/path:Cargo.toml",
        "//cli/proto_validate:Cargo.toml",
        "//cli/schema:Cargo.toml",
        "//cli/bep:Cargo.toml",
        "//cli/cli:Cargo.toml",
        "//cli/diff:Cargo.toml",
        "//cli/digest:Cargo.toml",
        "//cli/lcov:Cargo.toml",
        "//cli/env:Cargo.toml",
        "//cli/codegen:Cargo.toml",
        "//cli/env_plan:Cargo.toml",
        "//cli/fingerprint:Cargo.toml",
        "//cli/test_scratch:Cargo.toml",
        "//cli/roots:Cargo.toml",
        "//cli/docgen:Cargo.toml",
        "//cli/update:Cargo.toml",
        "//cli/bump:Cargo.toml",
        "//cli/ci:Cargo.toml",
        "//env/env_shard:Cargo.toml",
        "//generation/codegen_shard:Cargo.toml",
        "//docs/ir/ir:Cargo.toml",
    ],
)
use_repo(crate, "crates")

# Standalone quality-tool acquisition. One lazy repository
# per tool/platform from generated checked-in metadata, plus an
# execution-platform hub. Registration fetches nothing; each repository
# downloads only when an action needs its artifact. Seed host only
# (issue #298): Linux x86_64 glibc per ADR 0014; remaining required
# hosts stay unqualified gaps until their pins/hosts/floors plus
# JDK/SDK/CRT, route, per-cell coverage, and consumer/release evidence
# lands.
dx_tools = use_extension("//quality/artifacts:extension.bzl", "dx_tools")
dx_tools.platform(
    cpu_x86_64 = "@platforms//cpu:x86_64",
    os_linux = "@platforms//os:linux",
)
use_repo(
    dx_tools,
    "dx_biome_linux_x86_64",
    "dx_buildifier_linux_x86_64",
    "dx_ruff_linux_x86_64",
    "dx_taplo_linux_x86_64",
    "dx_tools",
    "dx_ty_linux_x86_64",
    "dx_vale_linux_x86_64",
)

# Issue #407: nested E2E removed. No second Bazel download; CI uses the
# single canonical `.bazelversion` Bazel via Bazelisk only. Former
# `integration/` CLI-contract coverage lives hermetically under
# `bazel test //...` (exec argv/code unit pins, runner-matrix goldens,
# `DxSubjectInfo` analysis pins, `//:preset_parity_test`); `local_path_override`
# plus `dx_dev` wiring is covered by the adopt-rust smoke in normal CI.
# What is lost: real-daemon exit 3, real Buildifier rewrite.

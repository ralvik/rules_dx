# Nested E2E removed. No second Bazel download; CI uses the
# single canonical `.bazelversion` Bazel via Bazelisk only. Former
# `integration/` CLI-contract coverage lives hermetically under
# `bazel test //...` (exec argv/code unit pins, runner-matrix goldens,
# `DxSubjectInfo` analysis pins, `//:preset_parity_test`); `local_path_override`
# plus `dx_dev` wiring is covered by the adopt-rust smoke in normal CI.
# What is lost: real-daemon exit 3, real Buildifier rewrite.

# JVM quality-tool acquisition (issue #796). Repos owned by `//quality/tools/jvm:repos.bzl`
# (verified by `//quality/tools/jvm:metadata` plus `//tools/ci:pin_consistency_test`); the list
# below must match `JVM_TOOL_REPOS` (`//tools/ci:pin_consistency_test` fails
# on drift). One lazy repository per tool from checked-in metadata (see
# `//quality/tools/jvm:extension.bzl`); no per-platform matrix or hub: JVM
# tools are platform-independent single artifacts run over the shared JDK.
# Registration fetches nothing; each repository downloads only when an
# action needs its artifact (same lazy shape as the `dx_tools`
# per-platform repos). Complete-upstream-artifact plus shared-JDK route:
# single-JAR tools via http_file, binary distributions via http_archive
# with a lib-closure build file. Versions qualified seed-only under issue
# #485 (`java/tests/fixtures/jvm_quality/pins.bzl`); digests pinned in
# repos.bzl (mirrors `//modules:java-scala-kotlin.bzl` `JVM_TOOL_VERSIONS`).
jvm_tools = use_extension("//quality/tools/jvm:extension.bzl", "jvm_tools")
use_repo(
    jvm_tools,
    "jvm_checkstyle",
    "jvm_google_java_format",
    "jvm_ktfmt",
    "jvm_ktlint",
    "jvm_pmd_dist",
    "jvm_spotbugs_dist",
)

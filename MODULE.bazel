use_repo(maven, "maven")

# Pinned PowerShell foundation (ADR 0032). Pins owned by `//modules:powershell.bzl`. 0.2.0 is the
# latest stable in the Bazel Central Registry (BCR-published April 2026;
# verified against Bazel 9.2.0 on the seed host). Single young
# execution-only upstream (`pwsh_binary` plus `pwsh_library` plus
# `pwsh_test` plus `PwshInfo` with a `pwsh` toolchain download extension);
# generation/dependency/env/IDE stories are owned by the PowerShell track
# (issue #972). Portable `pwsh` 7.5.4 is the upstream default (covers
# linux_x64, linux_arm64, osx_arm64, osx_x64, win_x64, win_arm64, so
# Windows arm64 is not an exception here); 7.6.5 LTS observed stays a
# currency candidate. Gallery modules (Pester 5.7.1 plus PSScriptAnalyzer
# 1.25.0) resolve via the exact lock in
# `//third_party/powershell:PSGallery.lock.json` with explicit-path import
# only; consumer `Install-Module`/`Install-PSResource` rejected. Laziness:
# registration fetches nothing; each per-platform toolchain repository
# downloads only when a `pwsh_*` action needs its artifact (same lazy
# shape as the `dx_tools` per-platform repos).
bazel_dep(name = "rules_powershell", version = "0.2.0")

powershell = use_extension("@rules_powershell//powershell:extensions.bzl", "powershell")
# Hub name differs from the upstream default (`powershell_toolchains`) to
# avoid the duplicate-repo collision when both the upstream module and this
# root module declare the extension (the extension creates
# `<name>__<platform>` repos per tag without deduplication).
powershell.toolchain(
    name = "dx_powershell_toolchains",
    version = "7.5.4",
)
use_repo(powershell, "dx_powershell_toolchains")

register_toolchains("@dx_powershell_toolchains//:all")


# Pinned Ruby foundation (ADR 0032). Pins owned by `//modules:ruby.bzl`. 0.28.0 is the
# latest stable in the Bazel Central Registry (Bazel 8 tested per upstream;
# verified against Bazel 9.2.0 on the seed host). Portable Ruby covers
# Linux/macOS x86_64/arm64; Windows falls back to RubyInstaller per ADR 0032.
# RSpec runs through `rb_test` with `main = "@bundle//bin:rspec"` (no new
# rule kind, only the lock story below).
bazel_dep(name = "rules_ruby", version = "0.28.0")

ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")
ruby.toolchain(
    name = "ruby",
    portable_ruby = True,
    version = "3.4.9",
)
ruby.bundle_fetch(
    name = "bundle",
    gem_checksums = {
        "diff-lcs-1.5.0": "49b934001c8c6aedb37ba19daec5c634da27b318a7a3c654ae979d6ba1929b67",
        "rspec-3.13.0": "d490914ac1d5a5a64a0e1400c1d54ddd2a501324d703b8cfe83f458337bab993",
        "rspec-core-3.13.0": "557792b4e88da883d580342b263d9652b6a10a12d5bda9ef967b01a48f15454c",
        "rspec-expectations-3.13.0": "621d48c62262f955421eaa418130744760802cad47e781df70dba4d9f897102e",
        "rspec-mocks-3.13.0": "735a891215758d77cdb5f4721fffc21078793959d1f0ee4a961874311d9b7f66",
        "rspec-support-3.13.1": "48877d4f15b772b7538f3693c22225f2eda490ba65a0515c4e7cf6f2f17de70f",
    },
    gemfile = "//third_party/ruby:Gemfile",

"""Focused Svelte environment plans.

Each `svelte_env_plan` reads the analyzed authoritative providers of one
`svelte_library` wrapper: the preserved `JsInfo` plus `QualitySourcesInfo`.
Focused-target only. Binaries/tests share the same closure through
`data`/runfiles. Repository/root/exact-target orchestration remains issue #506.
"""

load("//quality:fixtures.bzl", "real_source_target")
load("//svelte/env:plan.bzl", "svelte_env_plan")
load("//svelte/env:plan_tests.bzl", "env_plan_tests")

package(default_visibility = ["//visibility:public"])

svelte_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//svelte/tests/fixtures/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

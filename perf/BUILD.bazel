"""Bazel-owned benchmark targets emitting JSON-lines results (issue #215).

Microbenchmarks (Rust-side startup/parsing/resolution/rendering proxies) run
per-PR; scenario benchmarks (scope resolution, generate --check warm) run on
`main` plus `workflow_dispatch` (free-infra budget). Cold generate --check
runs in the perf workflow after `bazel shutdown` so server startup is
measured. No `dx perf` command (ADR 0006 minimal surface).
"""

load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

sh_binary(
    name = "bench_micro",
    srcs = ["bench.sh"],
    args = ["micro"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "bench_scenario_warm",
    srcs = ["bench.sh"],
    args = ["warm"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "bench_cold",
    srcs = ["bench.sh"],
    args = ["cold"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

sh_binary(
    name = "bench_all",
    srcs = ["bench.sh"],
    args = ["all"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

py_binary(
    name = "compare",
    srcs = ["compare.py"],
    main = "compare.py",
)

py_binary(
    name = "regenerate",
    srcs = ["regenerate.py"],
    main = "regenerate.py",
)

# Comparison-machinery self-test: feeds synthetic JSON-lines through the
# real compare.py and proves the contract — gated absolute breach fails,
# relative regression warns-but-passes, unknown benchmarks warn-but-pass,
# at-baseline input passes clean. Tagged `no-coverage`: timing harnesses
# stay out of the coverage denominator per the repo coverage preset.
sh_test(
    name = "perf_self_test",
    srcs = ["perf_self_test.sh"],
    args = [
        "$(rootpath :compare.py)",
        "$(rootpath :baseline.json)",
    ],
    data = [
        "baseline.json",
        "compare.py",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

# Rules-lint comparison synthetic-tree harness (issue #86): deterministic
# large-tree generator (mixed clean/dirty) emitting a fairness-pinned JSON
# report skeleton. Report-not-gate, no parity claim; measured runs land
# next. Run by `bazel run //perf:rules_lint_comparison`.
sh_binary(
    name = "rules_lint_comparison",
    srcs = ["rules_lint_comparison.sh"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

# Harness self-test: same seed yields identical trees/digests, dirty mix
# and triggers verified, fairness pins recorded, report-not-gate pinned.
# Tagged `no-coverage`: timing harnesses stay out of the coverage
# denominator per the repo coverage preset.
sh_test(
    name = "rules_lint_comparison_test",
    srcs = ["rules_lint_comparison_test.sh"],
    args = ["$(rootpath :rules_lint_comparison.sh)"],
    data = ["rules_lint_comparison.sh"],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

# Measured-results validation (issue #86): checked-in seed-host numbers
# (perf/rules_lint_results.json) match a fresh harness regeneration,
# pins recorded, quality-sample aquery + timing present, report-not-gate.
# Tagged `no-coverage`: timing data stays out of the coverage denominator.
sh_test(
    name = "rules_lint_results_test",
    srcs = ["rules_lint_results_test.sh"],
    args = [
        "$(rootpath :rules_lint_results.json)",
        "$(rootpath :rules_lint_comparison.sh)",
    ],
    data = [
        "rules_lint_comparison.sh",
        "rules_lint_results.json",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = ["//docs:performance.md"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

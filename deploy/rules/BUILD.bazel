"""Deploy rule fixtures and boundary tests (issues #178, #181)."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":archive.bzl", "archive_release")
load(":archive_tests.bzl", "archive_analysis_tests", "archive_debug_analysis_tests", "archive_unit_tests")
load(":defs.bzl", "dx_deployment")
load(":deploy_tests.bzl", "deploy_analysis_tests", "deploy_app_analysis_tests", "deploy_debug_analysis_tests", "deploy_unit_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "archive.bzl",
    "archive_deploy.sh",
    "archive_tests.bzl",
    "archive_verify.sh",
    "defs.bzl",
    "deploy_tests.bzl",
])

sh_binary(
    name = "deploy_program",
    srcs = ["deploy_program.sh"],
)

sh_binary(
    name = "deploy_app",
    srcs = ["deploy_app.sh"],
)

dx_deployment(
    name = "deploy_default",
    deploy = ":deploy_program",
)

dx_deployment(
    name = "deploy_debug",
    deploy = ":deploy_program",
    profile = "debug",
)

dx_deployment(
    name = "deploy_with_app",
    app = ":deploy_program",
    deploy = ":deploy_app",
)

# Manual negative demo: invalid profiles fail analysis with the helper
# message. Never part of `//...` suites: build explicitly with
# --nobuild to observe the failure.
dx_deployment(
    name = "deploy_invalid",
    deploy = ":deploy_program",
    profile = "staging",
    tags = ["manual"],
)

deploy_unit_tests(name = "deploy_unit")

deploy_analysis_tests(name = "deploy_analysis")

deploy_debug_analysis_tests(name = "deploy_debug_analysis")

deploy_app_analysis_tests(name = "deploy_app_analysis")

# First deploy macro (issue #181): credential-free archive releases over
# the fixture deploy program. The debug variant pins profile passthrough.
archive_release(
    name = "release_demo",
    app = ":deploy_program",
)

archive_release(
    name = "release_demo_debug",
    app = ":deploy_program",
    profile = "debug",
)

archive_unit_tests(name = "archive_unit")

archive_analysis_tests(name = "archive_analysis")

archive_debug_analysis_tests(name = "archive_debug_analysis")

# Tarball contents + checksum validity per release fixture. Tagged
# `no-coverage`: process-spawning tests stay out of the coverage
# denominator per the repo coverage preset. No corpus entry: shell
# sources have no `real_source_target` class.
sh_test(
    name = "release_demo_verify",
    srcs = ["archive_verify.sh"],
    args = [
        "$(rootpath :release_demo_archive)",
        "$(rootpath :release_demo_checksum)",
        "deploy_program",
    ],
    data = [
        ":release_demo_archive",
        ":release_demo_checksum",
    ],
    tags = ["no-coverage"],
)

sh_test(
    name = "release_demo_debug_verify",
    srcs = ["archive_verify.sh"],
    args = [
        "$(rootpath :release_demo_debug_archive)",
        "$(rootpath :release_demo_debug_checksum)",
        "deploy_program",
    ],
    data = [
        ":release_demo_debug_archive",
        ":release_demo_debug_checksum",
    ],
    tags = ["no-coverage"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_analysis",
        ":archive_debug_analysis",
        ":archive_unit",
        ":deploy_analysis",
        ":deploy_app_analysis",
        ":deploy_debug_analysis",
        ":deploy_unit",
        ":release_demo_debug_verify",
        ":release_demo_verify",
    ],
)

# Repository corpus: deploy Starlark owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. Shell fixtures are tooling
# with no quality class and stay outside the corpus.
real_source_target(
    name = "corpus",
    starlark_srcs = [
        "BUILD.bazel",
        "archive.bzl",
        "archive_tests.bzl",
        "defs.bzl",
        "deploy_tests.bzl",
    ],
)

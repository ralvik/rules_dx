"""Deploy rule fixtures and boundary tests."""

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load(":archive.bzl", "archive_deploy")
load(":archive_tests.bzl", "archive_analysis_tests", "archive_debug_analysis_tests", "archive_unit_tests")
load(":defs.bzl", "dx_deployment")
load(":deploy_tests.bzl", "deploy_analysis_tests", "deploy_app_analysis_tests", "deploy_debug_analysis_tests", "deploy_unit_tests")
load(":github.bzl", "github_deploy")
load(":github_tests.bzl", "github_analysis_tests", "github_debug_analysis_tests", "github_unit_tests")
load(":pypi.bzl", "pypi_deploy")
load(":pypi_tests.bzl", "pypi_analysis_tests", "pypi_debug_analysis_tests", "pypi_unit_tests")

package(default_visibility = ["//visibility:public"])

exports_files([
    "archive.bzl",
    "archive_deploy.sh",
    "archive_tests.bzl",
    "archive_verify.sh",
    "defs.bzl",
    "deploy_tests.bzl",
    "github.bzl",
    "github_deploy.sh",
    "github_tests.bzl",
    "github_verify.sh",
    "launcher.bzl",
    "pypi.bzl",
    "pypi_tests.bzl",
])

# Hermetic build tools for `archive_deploy`: deterministic
# tar.gz + sha256 via the managed Python 3.12 toolchain, no host
# `tar`/`sha256sum`/`shasum`. Declared as genrule `tools` so action
# keys cover the tool bytes and the sandbox runs no host PATH lookup.
py_binary(
    name = "archiver",
    srcs = ["archiver.py"],
    main = "archiver.py",
)

py_binary(
    name = "hasher",
    srcs = ["hasher.py"],
    main = "hasher.py",
)

# Shared wheelhouse logic for `pypi_deploy` launchers plus `py_test`.
# The launchers expand this template per instance; the test imports it.
py_library(
    name = "pypi_deploy_lib",
    srcs = ["pypi_deploy.py"],
    imports = ["."],
)

sh_binary(
    name = "deploy_program",
    srcs = ["deploy_program.sh"],
)

sh_binary(
    name = "deploy_app",
    srcs = ["deploy_app.sh"],
)

dx_deployment(
    name = "deploy_default",
    deploy = ":deploy_program",
)

dx_deployment(
    name = "deploy_debug",
    deploy = ":deploy_program",
    profile = "debug",
)

dx_deployment(
    name = "deploy_with_app",
    app = ":deploy_program",
    deploy = ":deploy_app",
)

# Manual negative demo: invalid profiles fail analysis with the helper
# message. Never part of `//...` suites: build explicitly with
# --nobuild to observe the failure.
dx_deployment(
    name = "deploy_invalid",
    deploy = ":deploy_program",
    profile = "staging",
    tags = ["manual"],
)

deploy_unit_tests(name = "deploy_unit")

deploy_analysis_tests(name = "deploy_analysis")

deploy_debug_analysis_tests(name = "deploy_debug_analysis")

deploy_app_analysis_tests(name = "deploy_app_analysis")

# First deploy macro: credential-free archive releases over
# the fixture deploy program. The debug variant pins profile passthrough.
archive_deploy(
    name = "release_demo",
    app = ":deploy_program",
)

archive_deploy(
    name = "release_demo_debug",
    app = ":deploy_program",
    profile = "debug",
)

archive_unit_tests(name = "archive_unit")

archive_analysis_tests(name = "archive_analysis")

archive_debug_analysis_tests(name = "archive_debug_analysis")

# Tarball contents + checksum validity per release fixture
# No-coverage: process-spawning test; see docs/contributing/build-conventions.md.
sh_test(
    name = "release_demo_verify",
    srcs = ["archive_verify.sh"],
    args = [
        "$(rootpath :release_demo_archive)",
        "$(rootpath :release_demo_checksum)",
        "deploy_program",
    ],
    data = [
        ":release_demo_archive",
        ":release_demo_checksum",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    # POSIX deploy fixtures (:deploy_program, :deploy_app) stay portable.
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "release_demo_debug_verify",
    srcs = ["archive_verify.sh"],
    args = [
        "$(rootpath :release_demo_debug_archive)",
        "$(rootpath :release_demo_debug_checksum)",
        "deploy_program",
    ],
    data = [
        ":release_demo_debug_archive",
        ":release_demo_debug_checksum",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

test_suite(
    name = "all",
    tests = [
        ":archive_analysis",
        ":archive_debug_analysis",
        ":archive_unit",
        ":deploy_analysis",
        ":deploy_app_analysis",
        ":deploy_debug_analysis",
        ":deploy_unit",
        ":github_analysis",
        ":github_debug_analysis",
        ":github_demo_verify",
        ":github_unit",
        ":pypi_analysis",
        ":pypi_debug_analysis",
        ":pypi_deploy_test",
        ":pypi_unit",
        ":release_demo_debug_verify",
        ":release_demo_verify",
    ],
)

# Second deploy macro: draft-only GitHub Releases over the
# archive fixtures, proving macro composition (archive outputs become
# release assets). The debug variant pins profile passthrough. Draft
# verification runs with GH_RELEASE_DRY_RUN=1: no network, no mutation.
github_deploy(
    name = "github_demo",
    artifacts = [
        ":release_demo_archive",
        ":release_demo_checksum",
    ],
)

github_deploy(
    name = "github_demo_debug",
    artifacts = [
        ":release_demo_archive",
        ":release_demo_checksum",
    ],
    profile = "debug",
)

github_unit_tests(name = "github_unit")

github_analysis_tests(name = "github_analysis")

github_debug_analysis_tests(name = "github_debug_analysis")

# Would-run command + draft-only flags per release fixture
# No-coverage: process-spawning test; see docs/contributing/build-conventions.md.
sh_test(
    name = "github_demo_verify",
    srcs = ["github_verify.sh"],
    args = [
        "$(rootpath :github_demo_program)",
        "v0.0.0-dryrun",
        "release_demo.tar.gz",
        "release_demo.tar.gz.sha256",
    ],
    data = [":github_demo_program"],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

# Third deploy macro: local-first PyPI publisher over deterministic
# dummy distributions. The debug variant pins profile passthrough. The
# `py_test` below exercises the local wheelhouse build with no network.
genrule(
    name = "pypi_demo_wheel",
    outs = ["pypi_demo-0.0.0-py3-none-any.whl"],
    cmd = "printf 'pypi-demo-wheel-bytes-v1' > $@",
)

genrule(
    name = "pypi_demo_sdist",
    outs = ["pypi_demo-0.0.0.tar.gz"],
    cmd = "printf 'pypi-demo-sdist-bytes-v1' > $@",
)

pypi_deploy(
    name = "pypi_demo",
    sdist = ":pypi_demo_sdist",
    wheel = ":pypi_demo_wheel",
)

pypi_deploy(
    name = "pypi_demo_debug",
    profile = "debug",
    sdist = ":pypi_demo_sdist",
    wheel = ":pypi_demo_wheel",
)

pypi_unit_tests(name = "pypi_unit")

pypi_analysis_tests(name = "pypi_analysis")

pypi_debug_analysis_tests(name = "pypi_debug_analysis")

# Local wheelhouse output per demo distribution
# No-coverage: process-spawning test; see docs/contributing/build-conventions.md.
py_test(
    name = "pypi_deploy_test",
    srcs = ["pypi_deploy_test.py"],
    imports = ["."],
    main = "pypi_deploy_test.py",
    tags = ["no-coverage"],
    deps = [":pypi_deploy_lib"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "archive.bzl",
        "archive_tests.bzl",
        "defs.bzl",
        "deploy_tests.bzl",
        "github.bzl",
        "github_tests.bzl",
        "launcher.bzl",
        "pypi.bzl",
        "pypi_tests.bzl",
    ],
    tags = ["corpus"],
)

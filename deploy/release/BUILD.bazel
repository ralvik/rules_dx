# Seed fixture: reuse the portable POSIX deploy program as the SBOM
# subject (no new binary needed; SBOM binds exact artifact bytes).
matrix_unit_tests(name = "matrix_unit")

sbom_unit_tests(name = "sbom_unit")

notice_unit_tests(name = "notice_unit")

signing_unit_tests(name = "signing_unit")

bcr_unit_tests(name = "bcr_unit")

# SBOM demo over the seed release tarball: proves SPDX +
# provenance bind the exact artifact bytes. Verified by the portable
# `dx_release_tools_test` SBOM unit (no Linux-only shell harness).
sbom_release(
    name = "sbom_demo",
    artifact = "//deploy/rules:release_demo_archive",
)

# NOTICE demo over an invented distributed-tier root: proves the
# aggregated NOTICE bundles the audited-inventory words with
# byte-identical rebuilds. Verified by the portable
# `dx_release_tools_test` NOTICE unit plus `dx_verify --notice`.
notice_bundle(
    name = "notice_demo",
    inventory = ":notice_demo_inventory.txt",
    root = "//deploy/release:notice_demo",
    texts = [
        ":notice_demo_a.txt",
        ":notice_demo_b.txt",
    ],
)

# Signing demo over the SBOM demo outputs plus the NOTICE bundle:
# proves the dry-run would-sign path binds Sigstore keyless +
# attestation for the SBOM pair and the NOTICE without network.
# Verified by the portable `dx_release_tools_test` signing unit.
signed_release(
    name = "signing_demo",
    artifacts = [
        ":sbom_demo_spdx",
        ":sbom_demo_provenance",
        ":notice_demo_notice",
    ],
    identity = "https://github.com/ralvik/rules_dx/.github/workflows/release.yml@refs/tags/v0.0.0-dryrun",
)

# BCR demo at the unpublishable shape: proves the would-submit PR prints
# without submitting. Verified by the portable `dx_release_tools_test`
# BCR unit.
bcr_check(
    name = "bcr_demo",
    inputs = [":sbom_demo_spdx"],
    module_name = "rules_dx",
    version = "0.0.0",
)

# Human-run driver dry-run gate (owner approval + tag ceiling). The
# `release_driver` rust_binary below is the driver; its dry-run plan is
# pinned by the portable `dx_release_tools_test` release unit.

notice_file_tests(
    name = "notice_demo_contains_words",
    notice = ":notice_demo_notice",
)

test_suite(
    name = "all",
    tests = [
        ":bcr_unit",
        ":dx_release_tools_test",
        ":matrix_unit",
        ":notice_demo_contains_words",
        ":notice_unit",
        ":sbom_unit",
        ":signing_unit",
    ],
)


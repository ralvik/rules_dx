# Hermetic build tools for SBOM/provenance + BCR source:
# digest + JSON via Rust, no host
# `sha256sum`/`shasum`/`python3`. Declared as genrule `tools`.
rust_library(
    name = "dx_release_tools",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "deploy/dx_release_tools",
        normal = True,
    ),
    crate_name = "dx_release_tools",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "hex",
            "serde_json",
            "sha2",
        ],
        package_name = "deploy/dx_release_tools",
    ),
)

rust_binary(
    name = "sbom_spdx_gen",
    srcs = ["src/bin_sbom_spdx_gen.rs"],
    aliases = aliases(
        package_name = "deploy/dx_release_tools",
        normal = True,
    ),
    crate_name = "sbom_spdx_gen",
    crate_root = "src/bin_sbom_spdx_gen.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "hex",
            "serde_json",
            "sha2",
        ],
        package_name = "deploy/dx_release_tools",
    ) + [":dx_release_tools"],
)


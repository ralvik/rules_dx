"""Repository GitHub metadata corpus."""

load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# The consumer CI template harness (//tools/ci:consumer_*_test, issue
# #99) executes the real embedded scripts, so the workflow file is
# exported for hermetic test data. ci.yml stays out: it has no quality
# class and no embedded contract scripts. publish-dry-run.yml is exported
# as a link-resolution sibling for //docs:corpus (issue #12 dogfood).
exports_files([
    "workflows/publish-dry-run.yml",
    "workflows/reusable-consumer.yml",
])

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//docs:contributing/local-workflows.md",
        "//docs:testing/README.md",
    ],
    markdown_srcs = [
        "ISSUE_TEMPLATE/bug_report.md",
        "ISSUE_TEMPLATE/feature_proposal.md",
        "PULL_REQUEST_TEMPLATE.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

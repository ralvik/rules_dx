# Bazel outputs and local configuration
/bazel-*
user.bazelrc
**/user.bazelrc

# Local agent instructions
AGENTS.local.md

# Ralph Loop local state (machine-managed)
.opencode/ralph-loop.local.md

# Release outputs (never commit; rebuilt locally on demand)
# No tags, GitHub releases, or registry submissions without explicit owner approval.
/dist/
/release/

# Operating systems
.DS_Store
**/.DS_Store

# Temporary files and caches
.cache/
.direnv/
.tmp/
__pycache__/
*.pyc
opencode.json

# Coverage artifacts (llvm-cov profraw/profdata spill to the checkout
# root when coverage binaries run; never commit — rebuilt on demand.
# Keeps `git status --porcelain` clean-checks honest, e.g. the
# publish dry-run's checkout-left-clean proof.)
*.profraw
*.profdata
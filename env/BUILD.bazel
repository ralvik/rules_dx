"""Bootstrap environment registry (M11 WP1-WP2): tool records, staged trees, and fixtures."""

load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//quality:fixtures.bzl", "real_source_target")
load(":defs.bzl", "environment_config", "environment_tool", "environment_tree")
load(":defs_tests.bzl", "env_config_analysis_tests", "env_default_config_analysis_tests", "env_default_tree_analysis_tests", "env_defs_unit_tests", "env_tree_analysis_tests")
load(":plan.bzl", "dx_env_shard", "env_plan_subject", "rust_env_shard")
load(":plan_tests.bzl", "env_plan_analysis_tests", "env_plan_defs_unit_tests")

package(default_visibility = ["//visibility:public"])

# Fixture host executable backing the environment_tool subjects below.
sh_binary(
    name = "tool_sh",
    srcs = ["tool.sh"],
)

environment_tool(
    name = "tool_alpha",
    aliases = ["a"],
    bin_name = "alpha",
    executable = ":tool_sh",
)

environment_tool(
    name = "tool_beta",
    bin_name = "beta",
    executable = ":tool_sh",
)

# Nested config proving transitive composition: the outer config under
# test reaches tool_beta only through config_inner.
environment_config(
    name = "config_inner",
    tools = [":tool_beta"],
)

environment_config(
    name = "config_under_test",
    tools = [
        ":config_inner",
        ":tool_alpha",
    ],
)

env_defs_unit_tests(name = "env_defs_unit")

env_config_analysis_tests(name = "env_config_analysis")

# Staged tree subject: one symlink per host name plus versioned
# management metadata, observed for layout and platform rendering.
environment_tree(
    name = "tree_under_test",
    config = ":config_under_test",
)

env_tree_analysis_tests(name = "env_tree_analysis")

env_default_config_analysis_tests(name = "env_default_config_analysis")

env_default_tree_analysis_tests(name = "env_default_tree_analysis")

# Frozen marker schema: field numbers are the compatibility
# surface; see `marker.proto` and the managed-state doc.
proto_library(
    name = "marker_proto",
    srcs = ["marker.proto"],
)

rust_prost_library(
    name = "marker_proto_rs",
    proto = ":marker_proto",
)

# Normalized environment plan shard schema: field numbers
# are the compatibility surface; see `plan.proto` and `plan.bzl`.
# `EnvironmentInfo` stays PATH-tool-only; this is the internal plan
# contract collected through the private `dx_env_plans` output group.
proto_library(
    name = "plan_proto",
    srcs = ["plan.proto"],
)

rust_prost_library(
    name = "plan_proto_rs",
    proto = ":plan_proto",
)

env_plan_defs_unit_tests(name = "env_plan_defs_unit")

# Shard-emission and collection fixtures (M25 WP2 slice 2): two disjoint
# leaf shards chained through `deps` prove transitive aspect collection,
# while the Rust adapter fixture proves the narrow dx_rust_library edge
# through the verified crate source bound by its EXEC_PATH suffix.
dx_env_shard(
    name = "env_shard_alpha",
    entries = ["runtime|stable-x86_64"],
    integration = "rust",
)

dx_env_shard(
    name = "env_shard_beta",
    entries = ["abi|gnu"],
    integration = "rust",
    deps = [":env_shard_alpha"],
)

rust_env_shard(
    name = "env_rust_fixture",
    entries = ["runtime|stable-x86_64|env/env_shard/src/lib.rs"],
    integration = "rust",
    target = "//env/env_shard",
)

env_plan_subject(
    name = "env_plan_chain_subject",
    target = ":env_shard_beta",
)

env_plan_subject(
    name = "env_plan_rust_subject",
    target = ":env_rust_fixture",
)

env_plan_analysis_tests(name = "env_plan_analysis")

# Default runnable environment (M11 WP2-WP3, O62): the curated doctor probe
# plus the module-matched `dx` CLI and the user-facing `markdown_check`
# quality binary, all contributed through the same public
# `environment_tool` path. Internal pipeline binaries (`quality_runner`,
# `quality_evaluator`) are intentionally not exposed, per the managed
# environment tool-exposure contract.
sh_binary(
    name = "doctor",
    srcs = ["doctor.sh"],
)

environment_tool(
    name = "doctor_tool",
    bin_name = "doctor",
    executable = ":doctor",
)

environment_tool(
    name = "dx_tool",
    bin_name = "dx",
    executable = "//dx/cli:dx",
)

environment_tool(
    name = "quality_markdown_tool",
    bin_name = "quality_markdown",
    executable = "//quality/markdown:quality_markdown",
)

environment_config(
    name = "default_config",
    tools = [
        ":doctor_tool",
        ":dx_tool",
        ":quality_markdown_tool",
    ],
)

environment_tree(
    name = "default_tree",
    config = ":default_config",
)

test_suite(
    name = "all",
    tests = [
        ":env_config_analysis",
        ":env_default_config_analysis",
        ":env_default_tree_analysis",
        ":env_defs_unit",
        ":env_plan_analysis",
        ":env_plan_defs_unit",
        ":env_tree_analysis",
    ],
)

# Repository corpus (M05 WP1 pattern): all Starlark sources in this package
# owned for direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"] + glob(["*.bzl"]),
)

"""Focused Python environment plans.

Each `python_env_plan` reads the analyzed authoritative providers of one
`python_*` wrapper: libraries preserve `PyInfo` plus `PyWheelsInfo`,
binaries and tests preserve `PyInfo` through the executable forwarder.
Focused-target only; repository/root/exact-target orchestration remains issue #506.
"""

load("//python/env:plan.bzl", "python_env_plan")
load("//python/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

python_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//python/tests/fixtures/hello:hello_lib",
)

python_env_plan(
    name = "hello_plan",
    testonly = True,
    target = "//python/tests/fixtures/hello",
)

python_env_plan(
    name = "hello_test_plan",
    testonly = True,
    target = "//python/tests/fixtures/hello:hello_test",
)

python_env_plan(
    name = "main_plan",
    testonly = True,
    target = "//python/tests/fixtures/entries:main",
)

python_env_plan(
    name = "main_bin_plan",
    testonly = True,
    target = "//python/tests/fixtures/entries:main_bin",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
        ":hello_plan",
        ":hello_test_plan",
        ":main_bin_plan",
        ":main_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "aspect.bzl",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

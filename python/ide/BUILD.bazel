"""Upstream Python IDE tool acquisition.

The environment contract reuses the pinned Python interpreter; this package pins its acquisition.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# buildifier: disable=canonical-repository  # issue #914: extension-generated toolchain repos have no apparent name without use_repo
sh_test(
    name = "ide_acquisition_test",
    size = "small",
    timeout = "short",
    srcs = ["ide_acquisition_test.sh"],
    args = select({
        "@platforms//cpu:arm64": ["$(rootpath @@aspect_rules_py++python_interpreters+python_3_12_aarch64_unknown_linux_gnu//:bin/python3)"],
        "//conditions:default": ["$(rootpath @@aspect_rules_py++python_interpreters+python_3_12_x86_64_unknown_linux_gnu//:bin/python3)"],
    }),
    data = select({
        "@platforms//cpu:arm64": ["@@aspect_rules_py++python_interpreters+python_3_12_aarch64_unknown_linux_gnu//:bin/python3"],
        "//conditions:default": ["@@aspect_rules_py++python_interpreters+python_3_12_x86_64_unknown_linux_gnu//:bin/python3"],
    }) + [
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

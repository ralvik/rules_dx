"""M14 seed Python binary and library; consumer of python_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//python/rules:defs.bzl", "python_binary", "python_library", "python_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

python_library(
    name = "hello_lib",
    srcs = ["hello.py"],
    imports = ["."],
)

python_binary(
    name = "hello",
    srcs = ["main.py"],
    imports = ["."],
    main = "main.py",
    deps = [":hello_lib"],
)

python_test(
    name = "hello_test",
    srcs = ["hello_test.py"],
    dep_group = "hello",
    imports = ["."],
    deps = [
        ":hello_lib",
        "@pypi//coverage",
        "@pypi//pytest",
    ],
)

exports_files([
    "pyproject.toml",
    "uv.lock",
])

# Repository corpus: build and project metadata owned for
# direct-Bazel dogfood under the canonical real_fixture_policy. Python
# sources and the uv lock stay dx-owned/unclassified, never corpus sources.
# The lock is a generated third-party manifest, excluded like other locks.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["pyproject.toml"],
)

# Hello smoke as a test target (#87, same pattern as
# //rust/hello:hello_output_test): asserts the seed binary prints the
# expected greeting. Tagged `no-coverage`: process-spawning tests stay
# out of the coverage denominator per the repo coverage preset. No corpus
# entry: shell sources have no `real_source_target` class.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello"],
    tags = ["no-coverage"],
)

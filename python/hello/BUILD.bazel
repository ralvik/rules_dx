"""M14 seed Python binary and library; consumer of dx_py_* wrappers."""

load("//python/rules:defs.bzl", "dx_py_binary", "dx_py_library")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

dx_py_library(
    name = "hello_lib",
    srcs = ["hello.py"],
    imports = ["."],
)

dx_py_binary(
    name = "hello",
    srcs = ["main.py"],
    imports = ["."],
    main = "main.py",
    deps = [":hello_lib"],
)

# Repository corpus (M05 WP1): build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. Python sources stay dx-owned
# (M14 wrappers), never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

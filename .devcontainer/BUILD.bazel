"""Dogfooded `dx init` devcontainer definition (issue #183)."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Parity fixture: `dx init` scaffold output must stay byte-identical to
# the checked-in definition, so the definition we ship is the one we
# boot. A drifting hand copy is worse than none.
sh_test(
    name = "devcontainer_parity_test",
    srcs = ["devcontainer_parity_test.sh"],
    args = [
        "$(rootpath :devcontainer.json)",
        "$(rootpath //cli/cli:dx)",
    ],
    data = [
        ":devcontainer.json",
        "//cli/cli:dx",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

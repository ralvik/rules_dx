"""Dogfooded `dx init` devcontainer definition (issue #183, snapshot workflow issue #322)."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files(["Dockerfile.prebuilt"])

# Parity fixture: `dx init` scaffold output is a snapshot of the
# checked-in definition, so the definition we ship is the one we
# boot (snapshot + schema, UPDATE_EXPECT refreshes the golden).
sh_test(
    name = "devcontainer_parity_test",
    srcs = ["devcontainer_parity_test.sh"],
    args = [
        "$(rootpath :devcontainer.json)",
        "$(rootpath //cli/cli:dx)",
    ],
    data = [
        ":devcontainer.json",
        "//cli/cli:dx",
        "//tools/sh:lib",
        "//tools/sh:snapshot",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

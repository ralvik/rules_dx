"""M18 seed Vue single-file component; consumer of dx_vue_* wrappers."""

load("//javascript/rules:defs.bzl", "dx_js_binary", "dx_js_library", "dx_js_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//vue/rules:defs.bzl", "dx_vue_library")

package(default_visibility = ["//visibility:public"])

dx_vue_library(
    name = "hello_lib",
    srcs = ["Hello.vue"],
)

dx_js_library(
    name = "helper_lib",
    srcs = ["helper.js"],
)

dx_js_test(
    name = "hello_test",
    srcs = ["Hello.test.js"],
    data = [
        ":Hello.vue",
        ":helper_lib",
        "//:node_modules/@vue/compiler-sfc",
        "//:node_modules/vue",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

# Repository corpus (M05 WP1): build metadata owned for direct-Bazel

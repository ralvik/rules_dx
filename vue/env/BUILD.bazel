"""Focused Vue environment plans.

Each `vue_env_plan` reads the analyzed authoritative providers of one
`vue_library` wrapper: the preserved `JsInfo` plus `QualitySourcesInfo`.
Focused-target only. Binaries/tests share the same closure through
`data`/runfiles. Repository/root/exact-target orchestration remains.
"""

load("//quality:fixtures.bzl", "real_source_target")
load("//vue/env:plan.bzl", "vue_env_plan")
load("//vue/env:plan_tests.bzl", "env_plan_tests")

package(default_visibility = ["//visibility:private"])

vue_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//vue/tests/fixtures/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

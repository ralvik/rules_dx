"""JVM Maven lockfile package (ADR 0019).

The authoritative Maven dependency lock for the admitted JVM foundations
(Java, Kotlin, Scala managed route): `maven_install.json` via
`rules_jvm_external` (`lock_file` plus fail-closed repin checking). The
lockfile is generated by `REPIN=1 bazel run @maven//:pin` and never edited
by hand; every entry carries its sha256 so the Bazel downloader verifies
each artifact. Consumers never load this package directly; they depend on
`@maven//:<artifact>` labels. Version pins live in `pins.bzl`
contract, checked by `bazel run //tools/ci:maven_lock_qualification`).
"""

load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "maven_install.json",
    "pins.bzl",
])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "pins.bzl",
    ],
    tags = ["corpus"],
)

"""NuGet Paket lockfile package (ADR 0019).

The authoritative NuGet dependency lock for the admitted .NET foundations
(C#, F#): `paket.dependencies` plus `paket.lock` via `paket2bazel` into the
`paket.main` hub (`//third_party/dotnet/deps`). The lock files are
maintainer-owned pins (restored with `dotnet paket install`, regenerated
with `bazel run @rules_dotnet//tools/paket2bazel -- --dependencies-file
$PWD/third_party/dotnet/paket.dependencies --output-folder
$PWD/third_party/dotnet/deps`) and never edited by hand; every entry
carries its sha512 so the Bazel downloader verifies each artifact.
Consumers never load this package directly; they depend on
`@paket.main//<package>` labels. Members are FSharp.Core 10.1.201 (F#
assemblies need the FSharp.Core runtime asset next to the app; plain
fsc output alone throws FileNotFoundException at startup) plus the xUnit
v3 4.0.0 runner closure pinned (xunit.v3 4.0.0 plus
xunit.analyzers 2.0.0 with the MTP runner transitive).
"""

load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "dotnet-tools.json",
    "paket.dependencies",
    "paket.lock",
])

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

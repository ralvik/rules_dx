"""Repository examples corpus."""

load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# The consumer CI template harness (//tools/ci:consumer_*_test, issue
# #99) pins the starter caller contract, so caller.yml is exported for
# hermetic test data. The pin-sync harness
# (//tools/ci:examples_pins_test, issue #209) reads both example
# callers, so both are exported.
exports_files([
    "consumer-ci/caller.yml",
    "docs-ci/caller.yml",
])

# Repository corpus: example Markdown owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. Adopt-example READMEs
# are unclassified link-resolution siblings for the index links above
# (directory targets resolve to their README.md index), never checked
# sources of this package.
real_source_target(
    name = "corpus",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//examples/adopt-cpp:README.md",
        "//examples/adopt-csharp:README.md",
        "//examples/adopt-fsharp:README.md",
        "//examples/adopt-go:README.md",
        "//examples/adopt-java:README.md",
        "//examples/adopt-js-ts:README.md",
        "//examples/adopt-kotlin:README.md",
        "//examples/adopt-polyglot:README.md",
        "//examples/adopt-python:README.md",
        "//examples/adopt-rust:README.md",
        "//examples/adopt-scala:README.md",
    ],
    markdown_srcs = [
        "README.md",
        "consumer-ci/README.md",
        "docs-ci/README.md",
    ],
    starlark_srcs = ["BUILD.bazel"],
)

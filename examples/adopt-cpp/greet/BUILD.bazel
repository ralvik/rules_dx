"""Adopted foreign C++ tree: handwritten owners preserved through generation."""

load("@rules_dx//cc/rules:defs.bzl", "cc_library", "cc_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# Handwritten: the generator never emits cc_test; test-owned `*_test.cc`
# stays out of the generated library and this rule survives regeneration.
# GoogleTest v1.18.0 plus explicit -std=c++17 floor over the pinned
# @googletest hub (hash authority: MODULE.bazel.lock integrity plus
# per-archive sha256; C/C++ has no ecosystem lockfile). The cc wrapper
# rewrites `-std=` to MSVC `/std:` plus `/Zc:__cplusplus` on Windows so
# the `__cplusplus` floor proof below reports the selected standard.
cc_test(
    name = "greet_test",
    srcs = ["greet_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":greet",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "greet",
    srcs = [
        "greet.cc",
        "helper.cc",
    ],
    hdrs = [
        "greet.h",
        "helper.h",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

<!-- Foreign SDK-style project marker: adopted without upstream changes. The
     F# Gazelle extension reads only `.fs` sources; this file records the
     foreign SDK-style layout without participating in Bazel resolution
     (NuGet lock wiring stays open under #7). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>

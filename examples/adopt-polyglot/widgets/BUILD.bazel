load("@rules_dx//javascript/rules:defs.bzl", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")

javascript_library(
    name = "jest_config",
    srcs = ["jest.config.cjs"],
)

javascript_library(
    name = "widgets",
    srcs = ["widgets.js"],
)

javascript_test(
    name = "widgets_test",
    srcs = ["widgets_test.js"],
    config = "jest.config.cjs",
    data = [":widgets"],
    node_modules = "//:node_modules",
    # First-party .js is ESM (`"type": "module"` in package.json); jest
    # needs VM modules to execute it (same flag as //javascript/hello).
    node_options = ["--experimental-vm-modules"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

"""Adopted foreign PowerShell tree: handwritten owners preserved through generation."""

load("@rules_dx//powershell/rules:defs.bzl", "pwsh_binary", "pwsh_library", "pwsh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# Pinned Gallery dep: Pester 5.7.1 via PSGallery.requirements.psd1 plus
# //third_party/powershell:PSGallery.lock.json (explicit-path import only,
# no Install-Module). The test below runs Pester when the closure is
# vendored and falls back to a plain assert so the workspace stays green
# while the Gallery fetch stays pending.
pwsh_library(
    name = "greet",
    srcs = [
        "Greet.psm1",
        "Greet.psd1",
    ],
)

pwsh_binary(
    name = "hello",
    srcs = ["Hello.ps1"],
    deps = [":greet"],
)

# Handwritten: the generator never emits pwsh_test; test-owned
# `*.Tests.ps1` stays out of the generated library and this rule survives
# regeneration.
pwsh_test(
    name = "greet_test",
    srcs = ["Greet.Tests.ps1"],
    deps = [":greet"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

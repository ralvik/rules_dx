"""Adopted foreign Go tree (#190): corpus ownership for arrival files."""

load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Arrival files (the foreign tree ships no MODULE.bazel and no BUILD
# files) plus the generator-owned BUILD files `//gazelle/go:gazelle`
# emits for them. Generated files stay checked in: regeneration must be a
# no-op. Each generated subpackage carries its own `corpus` rule:
# handwritten unknown-kind rules survive regeneration, while
# cross-package file labels cannot reach into a subpackage. This root
# rule owns only the root arrival files. go.mod is not corpus-applicable
# (audit covers BUILD/MODULE, .bzl/.toml/.md only); the module path is
# the importpath inference root (see //gazelle/go:gazelle).
real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_srcs = ["README.md"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

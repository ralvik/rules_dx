# Seed Bazel configuration. Linux-first, local-only bring-up.
# Shared execution flags live in the vendored preset fragment (issue #2);
# review and change them only through `tools/bazelrc/preset.py`.
import %workspace%/tools/bazelrc/preset.bazelrc

# Project overrides stay explicit here, never in the generated fragment.

# Warnings are errors for every compiled Rust crate (issue #82): deny
# warnings via the rules_rust extra_rustc_flags setting. Third-party
# crate_universe targets stay green because their generated targets carry
# per-target `--cap-lints=allow`, which ceilings lints below deny.
# Intentional-warning fixtures (e.g. quality/testdata/dirty.rs) are data
# consumed by quality aspects through the custom quality_source_target rule
# and are never rustc targets, so this flag cannot fire on them; a fixture
# that ever needs compiling must opt out per-target with --cap-lints=allow.
build --@rules_rust//rust/settings:extra_rustc_flags=--deny=warnings

# Hermetic Java runtime (the JDK baseline stays open under issue #7).
# No host JDK exists on the seed host, so the default local JDK cannot
# resolve; pin the upstream remote JDK 21 (oldest complete LTS in
# rules_java 9.7.0, provisional until the baseline freezes).
build --java_runtime_version=remotejdk_21

# Carry over per-person local flags when present (never committed).
try-import %workspace%/user.bazelrc

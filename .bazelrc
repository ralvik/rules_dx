# Seed Bazel configuration. Linux-first, local-only bring-up.
# Shared execution flags live in the vendored preset fragment (issue #2);
# review and change them only through `tools/bazelrc/src/lib.rs`.
import %workspace%/tools/bazelrc/preset.bazelrc

# Project overrides stay explicit here, never in the generated fragment.

# Warnings are errors for every compiled Rust crate (issue #82): deny
# warnings via the rules_rust extra_rustc_flags setting. Third-party
# crate_universe targets stay green because their generated targets carry
# per-target `--cap-lints=allow`, which ceilings lints below deny.
# Intentional-warning fixtures (e.g. quality/testdata/dirty.rs) are data
# consumed by quality aspects through the custom quality_source_target rule
# and are never rustc targets, so this flag cannot fire on them; a fixture
# that ever needs compiling must opt out per-target with --cap-lints=allow.
build --@rules_rust//rust/settings:extra_rustc_flags=--deny=warnings

# Warnings are errors for first-party C/C++ targets (issue #455): the
# `cc_*` wrappers default `copts` to `-Werror` (see cc/rules/defs.bzl).
# No global `--copt` pin: a global flag would also turn third-party
# external compiles (e.g. protobuf) red, while the wrapper default keeps
# externals green and still fails first-party warnings.

# Warnings are errors for every compiled Java target (issue #455): enable
# all lint checks and turn warnings into errors. Kotlin/Scala wrappers pin
# their own compiler flags (see kotlin/rules, scala/rules); the Java half of
# mixed Kotlin/Java targets inherits -Werror via the Kotlin toolchain
# propagation, so the global flag and the wrapper defaults agree.
build --javacopt=-Werror
build --javacopt=-Xlint:all

# Python runtime warnings are errors in tests (issue #455): DeprecationWarning
# and similar become failures instead of silent stderr. Lint warnings are
# already errors via the Ruff quality gate (ruff.toml plus --fail_on warning).
build --test_env=PYTHONWARNINGS=error

# Hermetic Java runtime (the JDK baseline stays open under issue #7).
# No host JDK exists on the seed host, so the default local JDK cannot
# resolve; pin the upstream remote JDK 21 (oldest complete LTS in
# rules_java 9.7.0, provisional until the baseline freezes). The tool
# (exec-config) runtime must match: quality aspect tools (google-java-format,
# ktfmt, Checkstyle) compile for class file 61 (Java 17+) and the default
# tool runtime is still remotejdk11, which fails at spawn with
# UnsupportedClassVersionError under `dx format`/`dx lint`.
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

# Hermetic Rust build scripts (issue #472): third-party `crate_universe`
# scripts defer to the upstream global default (`True`), so pin it `False`
# here. First-party `cargo_build_script` rules already emit
# `use_default_shell_env = 0` via `gazelle/rust/lang.go`; this flag closes
# the third-party half. A crate that genuinely needs host `PATH` probing
# opts back in narrowly via a per-crate
# `crate.annotation(..., build_script_use_default_shell_env = "on")`
# in `MODULE.bazel` (currently zero opt-ins); never flip this global back
# to `True`.
build --@rules_rust//cargo/settings:use_default_shell_env=False

# Carry over per-person local flags when present (never committed).
# user.bazelrc is resolution-only: per-person registry/flag overrides.
# Canonical lockfile URLs stay bcr.bazel.build (see docs/contributing/local-workflows.md).
try-import %workspace%/user.bazelrc

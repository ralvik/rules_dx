"""Root package for the rules_dx seed."""

load("@rules_dx//quality:native_config.bzl", "biome_config", "buildifier_config", "ruff_config", "rustfmt_config", "vale_config")

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

js_library(
    name = "package_json",
    srcs = ["package.json"],
)

npm_link_all_packages(name = "node_modules")

exports_files([
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".gitignore",
    "MODULE.bazel",
    "package.json",
    "pnpm-lock.yaml",
    ".vale.ini",
    "biome.json",
    "ruff.toml",
    "pnpm-workspace.yaml",
    "licenses.toml",
])

filegroup(
    name = "audit_curator",
    srcs = ["licenses.toml"],
)

sh_test(
    name = "preset_parity_test",
    size = "small",
    timeout = "short",
    srcs = ["preset_parity_test.sh"],
    args = [
        "$(rootpath //tools/bazelrc:preset.bazelrc)",
        "$(rootpath //cli/cli:dx)",
        "$(rootpath //tools/bazelrc:src/lib.rs)",
    ],
    data = [
        "//cli/cli:dx",
        "//tools/bazelrc:preset.bazelrc",
        "//tools/bazelrc:src/lib.rs",
        "//tools/sh:bootstrap",
        "//tools/sh:guards",
        "//tools/sh:lib",
        "//tools/sh:snapshot",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)

ruff_config(
    name = "ruff_config",
    src = "ruff.toml",
    visibility = ["//:__subpackages__"],
)

biome_config(
    name = "biome_config",
    src = "biome.json",
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//docs:README.md",
        "//docs:cli/commands/README.md",
        "//docs:github-ci.md",
        "//examples:README.md",
        "LICENSE",
    ],
    markdown_srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        ".gitleaks.toml",
        "clippy.toml",
        "ruff.toml",
        "rustfmt.toml",
        "licenses.toml",
    ],
)

vale_config(
    name = "vale_config",
    src = ".vale.ini",
    data = ["//quality:corpus_styles/Dx/Markers.yml"],
    visibility = ["//:__subpackages__"],
)

buildifier_config(
    name = "buildifier_config",
    src = ".buildifier.json",
    visibility = ["//:__subpackages__"],
)

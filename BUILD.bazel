load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# Workspace ESM scope marker. javascript_test adds it to every
# test's runfiles so jest's ESM detection resolves first-party .js
# as ESM (see //javascript/rules:defs.bzl). A js_library hop: js rules
# require data files to live in the target's own package, so tests
# reference this target, never //:package.json directly. Upstream
# js_library (not javascript_library): package.json is a scope marker, not
# a JavaScript source, so it must not enter QualitySourcesInfo.
js_library(
    name = "package_json",
    srcs = ["package.json"],
)

# Root importer node_modules facade over the authoritative
# pnpm store. Gazelle maintains per-importer targets later; the root facade
# proves the provider-derived layout first.
npm_link_all_packages(name = "node_modules")

exports_files([
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".gitignore",
    "MODULE.bazel",
    # Workspace ESM scope marker. javascript_test adds it to every
    # test's runfiles so jest's ESM detection resolves first-party .js
    # as ESM (see //javascript/rules:defs.bzl).
    "package.json",
    # Authoritative pnpm lock for //tools/depcheck:repo_locks_test.
    "pnpm-lock.yaml",
    # Single-source config inputs for //tools/ci:config_consistency_test
    # (issue #912): canonical Biome/Ruff plus pnpm workspace, plus the
    # Vale editor-discovery shim (pinned to the corpus policy).
    ".vale.ini",
    "biome.json",
    "ruff.toml",
    "pnpm-workspace.yaml",
    # Audit curator data as a declared Bazel input (See: `docs/cli/commands/audit-update-bazel.md#dx-audit`).
    # `dx audit license` keeps reading the committed `licenses.toml` bytes;
    # exposing the same file as a target lets Bazel-owned analysis declare
    # it as an input so results and cache identity reflect the data
    # actually analyzed.
    "licenses.toml",
])

# Audit curator data as declared Bazel inputs (See: `docs/cli/commands/audit-update-bazel.md#dx-audit`, issue #812).
# The `licenses.toml` policy plus `[[inventory]]` per-package shape is
# unchanged; exposing it here lets Bazel-owned analysis (NOTICE
# aggregation in `deploy/release/notice.bzl`, future audit actions)
# declare the same bytes as inputs so results stay hermetic and cached.
# Advisory snapshots (`.dx/advisory/<set>.json` plus identity
# `.dx/advisory/<set>.meta.json`) ride the same contract via
# `dx_audit::advisory::snapshot_rel` plus `identity_rel`; they are
# acquired, not committed, so no filegroup lists them here.
filegroup(
    name = "audit_curator",
    srcs = ["licenses.toml"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Preset parity fixture; see preset_parity_test.sh.
sh_test(
    name = "preset_parity_test",
    size = "small",
    timeout = "short",
    srcs = ["preset_parity_test.sh"],
    args = [
        "$(rootpath //tools/bazelrc:preset.bazelrc)",
        "$(rootpath //cli/cli:dx)",
        "$(rootpath //tools/bazelrc:src/lib.rs)",
    ],
    data = [
        "//cli/cli:dx",
        "//tools/bazelrc:preset.bazelrc",
        "//tools/bazelrc:src/lib.rs",
        "//tools/sh:bootstrap",
        "//tools/sh:guards",
        "//tools/sh:lib",
        "//tools/sh:snapshot",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)


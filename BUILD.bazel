"""Root package for the rules_dx seed."""

load("@rules_dx//quality:native_config.bzl", "rustfmt_config")

# First-party import mappings: every `# gazelle:resolve` here pins
# one crate name the Rust sources reference to its authoritative Bazel target.
# Root-level directives apply repo-wide (upstream walks parents), so generated
# rules depend on hand-maintained wrapper targets by exact label instead of by
# manifest inference. Labels must stay exact: validation accepts a mapped name
# without checking the target exists; a stale label surfaces later at resolve.
# gazelle:resolve rust dx_apply //cli/apply:dx_apply
# gazelle:resolve rust dx_atomic_fs //cli/atomic_fs:dx_atomic_fs
# gazelle:resolve rust dx_bep //cli/bep:dx_bep
# gazelle:resolve rust dx_clean //cli/clean:dx_clean
# gazelle:resolve rust dx_diff //cli/diff:dx_diff
# gazelle:resolve rust dx_digest //cli/digest:dx_digest
# gazelle:resolve rust dx_lcov //cli/lcov:dx_lcov
# gazelle:resolve rust dx_output //cli/output:dx_output
# gazelle:resolve rust dx_path //cli/path:dx_path
# gazelle:resolve rust dx_process //cli/process:dx_process
# gazelle:resolve rust dx_proto_validate //cli/proto_validate:dx_proto_validate
# gazelle:resolve rust dx_roots //cli/roots:dx_roots
# gazelle:resolve rust dx_schema //cli/schema:dx_schema
# gazelle:resolve rust dx_setup //cli/setup:dx_setup
# gazelle:resolve rust doc_ir_proto //docs/ir:doc_ir_proto_rs
# gazelle:resolve rust documentation_ir //docs/ir/ir:documentation_ir
# gazelle:resolve rust generation_result //generation/result:generation_result
# gazelle:resolve rust marker_proto //env:marker_proto_rs
# gazelle:resolve rust proto //quality:result_proto_rs
# gazelle:resolve rust result_proto //quality:result_proto_rs
# gazelle:resolve rust prost @rules_rust_prost//private/3rdparty/crates:prost
# gazelle:resolve rust quality_adapter //quality/adapter:quality_adapter
# gazelle:resolve rust quality_result //quality/result:quality_result
# gazelle:exclude gazelle/rust/testdata
# M13: quality/testdata is hand-maintained (generated-shape rustfmt_config
# plus fixture subjects prove hint bindings analyze). Repo-wide generation
# demands one config per tool so aspect_hints stays unambiguous; the fixture
# package is excluded like the Gazelle golden tree above.
# gazelle:exclude quality/testdata
# tools/coverage is hand-maintained: the source-only M00 gate CLI links the
# promoted `//cli/lcov:dx_lcov` library with no manifest of its own, so the
# package opts out like the fixtures above.
# gazelle:exclude tools/coverage

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# M16 WP1: workspace ESM scope marker. javascript_test adds it to every
# test's runfiles so jest's ESM detection resolves first-party .js
# as ESM (see //javascript/rules:defs.bzl). A js_library hop: js rules
# require data files to live in the target's own package, so tests
# reference this target, never //:package.json directly. Upstream
# js_library (not javascript_library): package.json is a scope marker, not
# a JavaScript source, so it must not enter QualitySourcesInfo.
js_library(
    name = "package_json",
    srcs = ["package.json"],
)

# M16 WP1 slice 4: root importer node_modules facade over the authoritative
# pnpm store. Gazelle maintains per-importer targets later; the root facade
# proves the provider-derived layout first.
npm_link_all_packages(name = "node_modules")

exports_files([
    ".bazelrc",
    ".bazelversion",
    "MODULE.bazel",
    # M16 WP1: workspace ESM scope marker. javascript_test adds it to every
    # test's runfiles so jest's ESM detection resolves first-party .js
    # as ESM (see //javascript/rules:defs.bzl).
    "package.json",
    # Release notes: link-resolution sibling for //docs:corpus, never a
    # checked source of this package.
    "CHANGELOG.md",
])

# Repository corpus: root Starlark, TOML, and Markdown sources owned for
# direct-Bazel dogfood under the canonical real_fixture_policy. LICENSE,
# the linked docs pages, and CHANGELOG are unclassified link-resolution
# siblings, never checked sources.
real_source_target(
    name = "corpus",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//docs:architecture/README.md",
        "//docs:contributing/local-workflows.md",
        "//docs:decisions/README.md",
        "//docs:environments/environment.md",
        "//docs:product/README.md",
        "//docs:product/scope.md",
        "//docs:product/support-matrix.md",
        "//docs:README.md",
        "//docs:roadmap.md",
        "//docs:testing/README.md",
        "CHANGELOG.md",
        "LICENSE",
    ],
    markdown_srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
    ],
    starlark_srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    toml_srcs = [
        "clippy.toml",
        "rustfmt.toml",
    ],
)

# Parity fixture: `dx init` scaffold output must stay byte-identical to
# the checked-in `renovate.json`, so the config we ship is the one we
# run (issue #3). A drifting hand copy is worse than none.
sh_test(
    name = "renovate_parity_test",
    srcs = ["renovate_parity_test.sh"],
    args = [
        "$(rootpath :renovate.json)",
        "$(rootpath //cli/cli:dx)",
    ],
    data = [
        ":renovate.json",
        "//cli/cli:dx",
    ],
    tags = ["no-coverage"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)

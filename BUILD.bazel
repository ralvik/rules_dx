"""Root package for the rules_dx seed."""

load("@rules_dx//quality:native_config.bzl", "biome_config", "ruff_config", "rustfmt_config")

# Gazelle Rust resolve map (repo-wide directives); see docs/generation/rust.md.
# gazelle:resolve rust dx_apply //cli/apply:dx_apply
# gazelle:resolve rust dx_atomic_fs //cli/atomic_fs:dx_atomic_fs
# gazelle:resolve rust dx_bep //cli/bep:dx_bep
# gazelle:resolve rust dx_clean //cli/clean:dx_clean
# gazelle:resolve rust dx_diff //cli/diff:dx_diff
# gazelle:resolve rust dx_digest //cli/digest:dx_digest
# gazelle:resolve rust dx_lcov //cli/lcov:dx_lcov
# gazelle:resolve rust dx_output //cli/output:dx_output
# gazelle:resolve rust dx_path //cli/path:dx_path
# gazelle:resolve rust dx_process //cli/process:dx_process
# gazelle:resolve rust dx_proto_validate //cli/proto_validate:dx_proto_validate
# gazelle:resolve rust dx_roots //cli/roots:dx_roots
# gazelle:resolve rust dx_schema //cli/schema:dx_schema
# gazelle:resolve rust dx_setup //cli/setup:dx_setup
# gazelle:resolve rust doc_ir_proto //docs/ir:doc_ir_proto_rs
# gazelle:resolve rust documentation_ir //docs/ir/ir:documentation_ir
# gazelle:resolve rust generation_result //generation/result:generation_result
# gazelle:resolve rust marker_proto //env:marker_proto_rs
# gazelle:resolve rust proto //quality:result_proto_rs
# gazelle:resolve rust result_proto //quality:result_proto_rs
# gazelle:resolve rust prost @rules_rust_prost//private/3rdparty/crates:prost
# gazelle:resolve rust quality_adapter //quality/adapter:quality_adapter
# gazelle:resolve rust quality_result //quality/result:quality_result
# gazelle:exclude gazelle/rust/testdata
# Quality/testdata is hand-maintained (generated-shape rustfmt_config
# plus fixture subjects prove hint bindings analyze). Repo-wide generation
# demands one config per tool so aspect_hints stays unambiguous; the fixture
# package is excluded like the Gazelle golden tree above.
# gazelle:exclude quality/testdata
# tools/coverage is hand-maintained: the source-only gate CLI links the
# promoted `//cli/lcov:dx_lcov` library with no manifest of its own, so the
# package opts out like the fixtures above.
# gazelle:exclude tools/coverage
# tools/depcheck/testdata holds depcheck fixtures with intentionally
# unresolved imports (truth table); Gazelle never owns them.
# gazelle:exclude tools/depcheck/testdata
# go/tests/fixtures/cgo holds the handwritten cgo scope fixture with
# `import "C"`; generation fails closed on cgo, so Gazelle never owns it.
# gazelle:exclude go/tests/fixtures/cgo

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# Workspace ESM scope marker. javascript_test adds it to every
# test's runfiles so jest's ESM detection resolves first-party .js
# as ESM (see //javascript/rules:defs.bzl). A js_library hop: js rules
# require data files to live in the target's own package, so tests
# reference this target, never //:package.json directly. Upstream
# js_library (not javascript_library): package.json is a scope marker, not
# a JavaScript source, so it must not enter QualitySourcesInfo.
js_library(
    name = "package_json",
    srcs = ["package.json"],
)

# Root importer node_modules facade over the authoritative
# pnpm store. Gazelle maintains per-importer targets later; the root facade
# proves the provider-derived layout first.
npm_link_all_packages(name = "node_modules")

exports_files([
    ".bazelignore",
    ".bazelrc",
    ".bazelversion",
    ".gitignore",
    "MODULE.bazel",
    # Workspace ESM scope marker. javascript_test adds it to every
    # test's runfiles so jest's ESM detection resolves first-party .js
    # as ESM (see //javascript/rules:defs.bzl).
    "package.json",
    # Release notes: link-resolution sibling for //docs:corpus, never a
    # checked source of this package.
    "CHANGELOG.md",
    # Audit curator data as a declared Bazel input (See: `docs/cli/commands/audit-update-bazel.md#dx-audit`).
    # `dx audit license` keeps reading the committed `licenses.toml` bytes;
    # exposing the same file as a target lets Bazel-owned analysis declare
    # it as an input so results and cache identity reflect the data
    # actually analyzed.
    "licenses.toml",
])

# Audit curator data as declared Bazel inputs (See: `docs/cli/commands/audit-update-bazel.md#dx-audit`, issue #812).
# The `licenses.toml` policy plus `[[inventory]]` per-package shape is
# unchanged; exposing it here lets Bazel-owned analysis (NOTICE
# aggregation in `deploy/release/notice.bzl`, future audit actions)
# declare the same bytes as inputs so results stay hermetic and cached.
# Advisory snapshots (`.dx/advisory/<set>.json` plus identity
# `.dx/advisory/<set>.meta.json`) ride the same contract via
# `dx_audit::advisory::snapshot_rel` plus `identity_rel`; they are
# acquired, not committed, so no filegroup lists them here.
filegroup(
    name = "audit_curator",
    srcs = ["licenses.toml"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Preset parity fixture; see preset_parity_test.sh.
sh_test(
    name = "preset_parity_test",
    srcs = ["preset_parity_test.sh"],
    args = [
        "$(rootpath //tools/bazelrc:preset.bazelrc)",
        "$(rootpath //cli/cli:dx)",
        "$(rootpath //tools/bazelrc:src/lib.rs)",
    ],
    data = [
        "//cli/cli:dx",
        "//tools/bazelrc:preset.bazelrc",
        "//tools/bazelrc:src/lib.rs",
        "//tools/sh:bootstrap",
        "//tools/sh:guards",
        "//tools/sh:lib",
        "//tools/sh:snapshot",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//:__subpackages__"],
)

# Lane A: direct aspect_hints binding; see docs/contributing/build-conventions.md.
ruff_config(
    name = "ruff_config",
    src = "ruff.toml",
    visibility = ["//:__subpackages__"],
)

# Lane A: direct aspect_hints binding; see docs/contributing/build-conventions.md.
biome_config(
    name = "biome_config",
    src = "biome.json",
    visibility = ["//:__subpackages__"],
)

real_source_target(
    name = "corpus_markdown",
    aspect_hints = ["//quality:corpus_vale_config"],
    markdown_siblings = [
        "//docs:README.md",
        "//docs:architecture/README.md",
        "//docs:contributing/local-workflows.md",
        "//docs:decisions/README.md",
        "//docs:environments/environment.md",
        "//docs:product/README.md",
        "//docs:product/scope.md",
        "//docs:product/support-matrix.md",
        "//docs:roadmap.md",
        "//docs:testing/README.md",
        "CHANGELOG.md",
        "LICENSE",
    ],
    markdown_srcs = [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "README.md",
        "SECURITY.md",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "clippy.toml",
        "ruff.toml",
        "rustfmt.toml",
        "licenses.toml",
    ],
)

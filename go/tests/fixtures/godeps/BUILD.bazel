"""Go from_file fixture with an external dep.

External imports resolve strictly via the handwritten dep below plus the
exact resolve mapping (never guessed):
  # gazelle:resolve go github.com/google/go-cmp/cmp @com_github_google_go_cmp//cmp:cmp
"""

load("//go/rules:defs.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

# gazelle:resolve go github.com/google/go-cmp/cmp @com_github_google_go_cmp//cmp:cmp

go_library(
    name = "godeps",
    srcs = ["godeps.go"],
    importpath = "rules_dx/go/tests/fixtures/godeps",
    deps = ["@com_github_google_go_cmp//cmp:cmp"],
)

go_test(
    name = "godeps_test",
    srcs = ["godeps_test.go"],
    embed = [":godeps"],
    deps = ["@com_github_google_go_cmp//cmp:cmp"],
)

exports_files(["pins.bzl"])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "pins.bzl",
    ],
    tags = ["corpus"],
)

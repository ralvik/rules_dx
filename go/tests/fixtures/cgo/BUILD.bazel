"""Handwritten Go cgo scope fixture.

Cgo stays handwritten: the Go Gazelle extension fails closed on
`import "C"`, so this package carries an explicit handwritten
`go_library` with `cgo = True` plus a package-level `go_test` with
`race = on` plus `pure = off`. Gazelle never owns this directory
(see the root `# gazelle:exclude`).
"""

load("//go/rules:defs.bzl", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "cgo",
    srcs = ["cgo.go"],
    cgo = True,
    importpath = "rules_dx/go/tests/fixtures/cgo",
)

go_test(
    name = "cgo_test",
    srcs = ["cgo_test.go"],
    embed = [":cgo"],
    pure = "off",
    race = "on",
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files(["pins.bzl"])

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = [
        "BUILD.bazel",
        "pins.bzl",
    ],
    tags = ["corpus"],
)

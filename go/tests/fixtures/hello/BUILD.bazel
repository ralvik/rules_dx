"""Seed Go binary and library; consumer of go_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//go/rules:defs.bzl", "go_binary", "go_library", "go_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

go_library(
    name = "hello_lib",
    srcs = ["hello.go"],
    importpath = "rules_dx/go/tests/fixtures/hello",
)

go_binary(
    name = "hello",
    srcs = ["main.go"],
    importpath = "rules_dx/go/tests/fixtures/hello/main",
    deps = [":hello_lib"],
)

go_test(
    name = "hello_test",
    srcs = ["hello_test.go"],
    embed = [":hello_lib"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Hello smoke test; no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

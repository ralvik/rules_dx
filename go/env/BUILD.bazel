"""Focused Go environment plans.

Each `go_env_plan` reads the analyzed authoritative providers of one
`go_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `GoArchive` transitive source closure and source/test split.
Focused-target only; repository/root/exact-target orchestration remains.
"""

load("//go/env:plan.bzl", "go_env_plan")
load("//go/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

go_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//go/tests/fixtures/hello:hello_lib",
)

go_env_plan(
    name = "hello_plan",
    testonly = True,
    target = "//go/tests/fixtures/hello",
)

go_env_plan(
    name = "hello_test_plan",
    testonly = True,
    target = "//go/tests/fixtures/hello:hello_test",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
        ":hello_plan",
        ":hello_test_plan",
    ],
    tags = ["no-coverage"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

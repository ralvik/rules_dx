"""Focused Astro environment plans.

Each `astro_env_plan` reads the analyzed authoritative providers of one
`astro_library` wrapper: the preserved `JsInfo` plus `QualitySourcesInfo`.
Focused-target only. Binaries/tests share the same closure through
`data`/runfiles. Repository/root/exact-target orchestration remains M25.
"""

load("//astro/env:plan.bzl", "astro_env_plan")
load("//astro/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

astro_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//astro/tests/fixtures/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

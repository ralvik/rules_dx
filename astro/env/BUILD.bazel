"""Focused Astro environment plans.

Each `astro_env_plan` reads the analyzed authoritative providers of one
`dx_astro_library` wrapper: the preserved `JsInfo` plus `QualitySourcesInfo`.
Focused-target only. Binaries/tests share the same closure through
`data`/runfiles. Repository/root/exact-target orchestration remains M25.
"""

load("//astro/env:plan.bzl", "astro_env_plan")
load("//astro/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

astro_env_plan(
    name = "hello_lib_plan",
    target = "//astro/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

# Repository corpus: plan Starlark owned for direct-Bazel dogfood
# under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
)

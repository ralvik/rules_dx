"""Upstream Astro IDE tool acquisition.

The Astro environment contract reuses the pinned Node toolchain shared with
JavaScript; this package pins its acquisition.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

# buildifier: disable=canonical-repository
sh_test(
    name = "ide_acquisition_test",
    size = "small",
    timeout = "short",
    srcs = ["ide_acquisition_test.sh"],
    args = select({
        "@platforms//cpu:arm64": ["$(rootpath @@rules_nodejs++node+nodejs_linux_arm64//:bin/nodejs/bin/node)"],
        "//conditions:default": ["$(rootpath @@rules_nodejs++node+nodejs_linux_amd64//:bin/nodejs/bin/node)"],
    }),
    data = select({
        "@platforms//cpu:arm64": ["@@rules_nodejs++node+nodejs_linux_arm64//:bin/nodejs/bin/node"],
        "//conditions:default": ["@@rules_nodejs++node+nodejs_linux_amd64//:bin/nodejs/bin/node"],
    }) + [
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

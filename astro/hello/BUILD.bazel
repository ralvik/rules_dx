"""M20 seed Astro component; consumer of astro_* wrappers."""

load("//astro/rules:defs.bzl", "astro_library")
load("//javascript/rules:defs.bzl", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

astro_library(
    name = "hello_lib",
    srcs = ["Hello.astro"],
)

javascript_library(
    name = "helper_lib",
    srcs = ["helper.js"],
)

javascript_test(
    name = "hello_test",
    srcs = ["Hello.test.js"],
    data = [
        ":Hello.astro",
        ":helper_lib",
        "//:node_modules/@astrojs/compiler",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

# Repository corpus: build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. Astro sources stay
# dx-owned, never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

"""M20 seed Astro component; consumer of dx_astro_* wrappers."""

load("//astro/rules:defs.bzl", "dx_astro_library")
load("//javascript/rules:defs.bzl", "dx_js_library", "dx_js_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

dx_astro_library(
    name = "hello_lib",
    srcs = ["Hello.astro"],
)

dx_js_library(
    name = "helper_lib",
    srcs = ["helper.js"],
)

dx_js_test(
    name = "hello_test",
    srcs = ["Hello.test.js"],
    data = [
        ":Hello.astro",
        ":helper_lib",
        "//:node_modules/@astrojs/compiler",
    ],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

# Repository corpus (M05 WP1): build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. Astro sources stay
# dx-owned, never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

"""Focused Scala environment plans.

Each `scala_env_plan` reads the analyzed authoritative providers of one
`scala_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `JavaInfo` toolchain closure by reference.
Focused-target only; repository/root/exact-target orchestration remains M25.
"""

load("//quality:fixtures.bzl", "real_source_target")
load("//scala/env:plan.bzl", "scala_env_plan")
load("//scala/env:plan_tests.bzl", "env_plan_tests")

package(default_visibility = ["//visibility:public"])

scala_env_plan(
    name = "hello_lib_plan",
    target = "//scala/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

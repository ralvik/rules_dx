"""Seed Scala binary and library; consumer of scala_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//scala/rules:defs.bzl", "scala_binary", "scala_library", "scala_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

scala_library(
    name = "hello_lib",
    srcs = ["Hello.scala"],
)

scala_binary(
    name = "hello",
    srcs = ["Main.scala"],
    main_class = "hello.Main",
    deps = [":hello_lib"],
)

scala_test(
    name = "hello_test",
    srcs = ["HelloTest.scala"],
    deps = [
        ":hello_lib",
        "@maven//:org_scalactic_scalactic_2_13",
        "@maven//:org_scalatest_scalatest_2_13",
        "@maven//:org_scalatest_scalatest_flatspec_2_13",
    ],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Hello smoke test; no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    size = "small",
    timeout = "short",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

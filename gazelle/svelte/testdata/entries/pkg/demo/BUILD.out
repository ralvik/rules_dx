load("@rules_dx//svelte/rules:defs.bzl", "svelte_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

svelte_library(
    name = "helper",
    srcs = ["helper.svelte"],
)

svelte_library(
    name = "helper_test",
    srcs = ["helper_test.svelte"],
    deps = [":helper"],
)

svelte_library(
    name = "main",
    srcs = ["main.svelte"],
    deps = [":helper"],
)

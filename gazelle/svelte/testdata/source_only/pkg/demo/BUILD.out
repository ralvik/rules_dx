load("@rules_dx//svelte/rules:defs.bzl", "dx_svelte_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

dx_svelte_library(
    name = "demo",
    srcs = ["demo.svelte"],
    deps = [":helper"],
)

dx_svelte_library(
    name = "helper",
    srcs = ["helper.svelte"],
)

load("@rules_dx//javascript/rules:defs.bzl", "dx_js_binary", "dx_js_library", "dx_js_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

dx_js_library(
    name = "helper",
    srcs = ["helper.js"],
)

dx_js_test(
    name = "helper_test",
    srcs = ["helper_test.js"],
    data = [":helper"],
    node_modules = "//:node_modules",
)

dx_js_library(
    name = "main",
    srcs = ["main.js"],
    deps = [":helper"],
)

dx_js_binary(
    name = "main_bin",
    data = [":main"],
    entry_point = "main.js",
)

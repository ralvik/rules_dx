load("@rules_dx//javascript/rules:defs.bzl", "dx_js_library", "dx_js_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

dx_js_library(
    name = "demo",
    srcs = ["demo.js"],
    deps = [":helper"],
)

dx_js_library(
    name = "helper",
    srcs = ["helper.jsx"],
)

dx_js_test(
    name = "helper_test",
    srcs = ["helper_test.mjs"],
    data = [":helper"],
    node_modules = "//:node_modules",
)

load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_binary", "rust_test")

filegroup(
    name = "assets",
    srcs = ["asset.txt"],
)

rust_binary(
    name = "binary",
    srcs = ["src/main.rs"],
    crate_name = "binary",
    crate_root = "src/main.rs",
)

rust_test(
    name = "binary_test",
    crate = ":binary",
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

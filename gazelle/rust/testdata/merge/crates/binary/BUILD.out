load("@rules_dx//rust/rules:defs.bzl", "dx_rust_binary", "dx_rust_test")

filegroup(
    name = "assets",
    srcs = ["asset.txt"],
)

dx_rust_binary(
    name = "binary",
    srcs = ["src/main.rs"],
    crate_name = "binary",
    crate_root = "src/main.rs",
)

dx_rust_test(
    name = "binary_test",
    crate = ":binary",
)

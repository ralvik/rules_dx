load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//quality:native_config.bzl", "rustfmt_config")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

# gazelle:dx_native_tools rustfmt

# Only the selected tool generates; the skipped file stays unmanaged.

rust_library(
    name = "skip",
    srcs = ["src/lib.rs"],
    aspect_hints = [":rustfmt_config"],
    crate_name = "skip",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
    visibility = ["//crates/skip:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "rustfmt.toml",
        "taplo.toml",
    ],
)

load("@rules_dx//quality:native_config.bzl", "clippy_config")
load("@rules_dx//rust/rules:defs.bzl", "dx_rust_library")

# gazelle:dx_native_tools clippy

# Only the selected tool generates; the skipped file stays unmanaged.

dx_rust_library(
    name = "skip",
    srcs = ["src/lib.rs"],
    aspect_hints = [":clippy_config"],
    crate_name = "skip",
    crate_root = "src/lib.rs",
)

clippy_config(
    name = "clippy_config",
    src = "clippy.toml",
    visibility = ["//crates/skip:__subpackages__"],
)

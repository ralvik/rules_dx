load("@rules_dx//rust/rules:defs.bzl", "rust_library")
load("@rules_dx//quality:native_config.bzl", "rustfmt_config")

rustfmt_config(
    name = "rustfmt_config",
    src = "rustfmt.toml",
)

rust_library(
    name = "removal",
    srcs = ["src/lib.rs"],
    crate_name = "removal",
    crate_root = "src/lib.rs",
    aspect_hints = [":rustfmt_config"],
)

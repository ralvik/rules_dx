load("@rules_dx//rust/rules:defs.bzl", "rust_library")
load("@rules_dx//quality:native_config.bzl", "rustfmt_config")

rustfmt_config(
    name = "rustfmt_cfg",
    src = "custom.toml",
)

rust_library(
    name = "merge",
    srcs = ["src/lib.rs"],
    crate_name = "merge",
    crate_root = "src/lib.rs",
    aspect_hints = [
        ":hand_cfg",
        ":rustfmt_config",
    ],
)

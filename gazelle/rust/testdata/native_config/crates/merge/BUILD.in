load("@rules_dx//rust/rules:defs.bzl", "dx_rust_library")
load("@rules_dx//quality:native_config.bzl", "clippy_config")

clippy_config(
    name = "clippy_cfg",
    src = "custom.toml",
)

dx_rust_library(
    name = "merge",
    srcs = ["src/lib.rs"],
    crate_name = "merge",
    crate_root = "src/lib.rs",
    aspect_hints = [
        ":hand_cfg",
        ":rustfmt_config",
    ],
)

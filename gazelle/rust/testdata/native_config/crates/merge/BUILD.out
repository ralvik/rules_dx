load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//quality:native_config.bzl", "rustfmt_config")
load("@rules_dx//rust/rules:defs.bzl", "rust_library")

rustfmt_config(
    name = "rustfmt_cfg",
    src = "custom.toml",
)

rust_library(
    name = "merge",
    srcs = ["src/lib.rs"],
    aspect_hints = [
        ":hand_cfg",
        ":rustfmt_cfg",
    ],
    crate_name = "merge",
    crate_root = "src/lib.rs",
    visibility = ["//visibility:public"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = [
        "custom.toml",
        "rustfmt.toml",
    ],
)

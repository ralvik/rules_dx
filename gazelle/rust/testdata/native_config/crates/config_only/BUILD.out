load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//quality:native_config.bzl", "taplo_config")

# Config-only package: no Rust sources, just a managed tool config.

taplo_config(
    name = "taplo_config",
    src = "taplo.toml",
    visibility = ["//crates/config_only:__subpackages__"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["taplo.toml"],
)

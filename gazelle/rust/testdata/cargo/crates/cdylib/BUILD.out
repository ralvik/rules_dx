load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_dx//quality:fixtures.bzl", "real_source_target")
load("@rules_dx//rust/rules:defs.bzl", "rust_shared_library", "rust_test")

rust_shared_library(
    name = "flavors_cdylib",
    srcs = ["source/cdylib.rs"],
    aliases = aliases(
        package_name = "crates/flavors-cdylib",
        normal = True,
    ),
    crate_name = "flavors_cdylib",
    crate_root = "source/cdylib.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = crate_deps(
        ["serde_json"],
        package_name = "crates/flavors-cdylib",
    ),
)

rust_test(
    name = "flavors_cdylib_test",
    aliases = aliases(
        package_name = "crates/flavors-cdylib",
        normal = True,
        normal_dev = True,
    ),
    crate = ":flavors_cdylib",
    deps = crate_deps(
        [
            "serde_json",
            "tempfile",
        ],
        package_name = "crates/flavors-cdylib",
    ),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

load("@rules_dx//mdx/rules:defs.bzl", "dx_mdx_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

dx_mdx_library(
    name = "demo",
    srcs = ["demo.mdx"],
    deps = [":helper"],
)

dx_mdx_library(
    name = "helper",
    srcs = ["helper.mdx"],
)

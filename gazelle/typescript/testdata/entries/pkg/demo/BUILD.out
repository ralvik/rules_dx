load("@rules_dx//typescript/rules:defs.bzl", "dx_ts_project")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

dx_ts_project(
    name = "helper",
    srcs = ["helper.ts"],
)

dx_ts_project(
    name = "helper_test",
    srcs = ["helper_test.ts"],
    deps = [":helper"],
)

dx_ts_project(
    name = "main",
    srcs = ["main.ts"],
    deps = [":helper"],
)

load("@rules_dx//javascript/rules:defs.bzl", "javascript_binary")
load("@rules_dx//typescript/rules:defs.bzl", "typescript_project")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

typescript_project(
    name = "helper",
    srcs = ["helper.ts"],
)

typescript_project(
    name = "helper_test",
    srcs = ["helper_test.ts"],
    deps = [":helper"],
)

typescript_project(
    name = "main",
    srcs = ["main.ts"],
    deps = [":helper"],
)

javascript_binary(
    name = "main_bin",
    data = [":main"],
    entry_point = "main.js",
)

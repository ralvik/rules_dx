load("@rules_dx//python/rules:defs.bzl", "python_binary", "python_library", "python_test")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

python_library(
    name = "helper",
    srcs = ["helper.py"],
    imports = ["."],
)

python_test(
    name = "helper_test",
    srcs = ["helper_test.py"],
    imports = ["."],
    deps = [":helper"],
)

python_library(
    name = "main",
    srcs = ["main.py"],
    imports = ["."],
    deps = [":helper"],
)

python_binary(
    name = "main_bin",
    imports = ["."],
    main = "main.py",
    deps = [":main"],
)

load("@rules_dx//astro/rules:defs.bzl", "astro_library")

# A user-owned rule must survive generation unchanged.
filegroup(
    name = "assets",
    srcs = ["README.txt"],
)

astro_library(
    name = "demo",
    srcs = ["demo.astro"],
    deps = [":helper"],
)

astro_library(
    name = "helper",
    srcs = ["helper.astro"],
)

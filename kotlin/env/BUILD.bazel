"""Focused Kotlin environment plans.

Each `kotlin_env_plan` reads the analyzed authoritative providers of one
`kotlin_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `JavaInfo` transitive source-jar closure and source/test split.
Focused-target only; repository/root/exact-target orchestration remains.
"""

load("//kotlin/env:plan.bzl", "kotlin_env_plan")
load("//kotlin/env:plan_tests.bzl", "env_plan_tests")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:private"])

kotlin_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//kotlin/tests/fixtures/hello:hello_lib",
)

kotlin_env_plan(
    name = "hello_plan",
    testonly = True,
    target = "//kotlin/tests/fixtures/hello",
)

kotlin_env_plan(
    name = "hello_test_plan",
    testonly = True,
    target = "//kotlin/tests/fixtures/hello:hello_test",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
        ":hello_plan",
        ":hello_test_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

"""Kotlin JUnit 6.1.3 runner fixture.

Maps the qualified Kotlin runner: default `kotlin_test` wrapper stays the
JUnit 4 seed (`//kotlin/tests/fixtures/hello:hello_test`); the Jupiter
upgrade is the console-launcher `kt_jvm_test` shape pinned here (primary
6.1.3 with native `suspend` support, fallback 5.14.x on JDK <17 via the same
coordinates in `//java/tests/fixtures/junit:pins.bzl`). Unpinned runner is
rejected.
"""

load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

kt_jvm_test(
    name = "hello_jupiter_test",
    srcs = ["HelloJupiterTest.kt"],
    args = [
        "execute",
        "--select-class",
        "hello.HelloJupiterTest",
    ],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    test_class = "hello.HelloJupiterTest",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_console",
        "@maven//:org_junit_platform_junit_platform_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
    deps = [
        "//kotlin/tests/fixtures/hello:hello_lib",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

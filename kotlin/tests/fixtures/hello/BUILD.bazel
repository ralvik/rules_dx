"""M23 seed Kotlin binary and library; consumer of kotlin_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//kotlin/rules:defs.bzl", "kotlin_binary", "kotlin_library", "kotlin_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_visibility = ["//:__subpackages__"],
    default_testonly = True,
)

kotlin_library(
    name = "hello_lib",
    srcs = ["Hello.kt"],
)

kotlin_binary(
    name = "hello",
    srcs = ["Main.kt"],
    main_class = "hello.MainKt",
    deps = [":hello_lib"],
)

kotlin_test(
    name = "hello_test",
    srcs = ["HelloTest.kt"],
    test_class = "hello.HelloTest",
    deps = [
        ":hello_lib",
        "@maven//:junit_junit",
    ],
)

# Repository corpus: build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. Kotlin sources stay
# dx-owned, never corpus sources.
# Hello smoke as a test target (#87, same pattern as
# //rust/tests/fixtures/hello:hello_output_test): asserts the seed binary prints the
# expected greeting. Tagged `no-coverage`: process-spawning tests stay
# out of the coverage denominator per the repo coverage preset. No corpus
# entry: shell sources have no `real_source_target` class.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello", "//tools/sh:lib"],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

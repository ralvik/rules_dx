"""Library owns main.ts plus a thin binary over the compiled output (execution reuses the JS wrappers; there is no typescript_binary)."""

load("//javascript/rules:defs.bzl", "javascript_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/rules:defs.bzl", "typescript_project")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_project(
    name = "helper",
    testonly = True,
    srcs = ["helper.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

typescript_project(
    name = "main",
    testonly = True,
    srcs = ["main.ts"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":helper"],
)

# Thin binary over the reusable owner: the library alone owns `main.ts`;
# the binary carries only the compiled entry point (`main.js`) plus
# `data = [":main"]`, the same shape `dx generate` emits for a recognized
# `main.ts` entry.
javascript_binary(
    name = "main_bin",
    testonly = True,
    data = [":main"],
    entry_point = "main.js",
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

"""Seed TypeScript project; consumer of typescript_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//javascript/rules:defs.bzl", "javascript_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/rules:defs.bzl", "typescript_project", "typescript_test")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

typescript_project(
    name = "hello_lib",
    srcs = [
        "hello.ts",
        "main.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

# The library owns the sources,
# the binary carries the entry point only (same shape as
# //javascript/tests/fixtures/hello:hello; see //typescript/rules:defs.bzl — execution
# reuses the JavaScript wrappers, there is no typescript_binary).
javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

# Seed Jest test over the tsc-compiled output via typescript_test.
# Matches the //javascript/tests/fixtures/hello:hello_test precedent; the
# compiled `*_test.js` naming needs the local jest config (same as
# //javascript/tests/fixtures/entries:helper_test).
typescript_test(
    name = "hello_test",
    srcs = ["hello_test.ts"],
    config = "jest.config.cjs",
    declaration = True,
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [":hello_lib"],
)

# Hello smoke test; no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    size = "small",
    timeout = "short",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

"""M16 seed TypeScript project; consumer of typescript_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//javascript/rules:defs.bzl", "javascript_binary", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/rules:defs.bzl", "typescript_project")

package(
    default_visibility = ["//:__subpackages__"],
    default_testonly = True,
)

typescript_project(
    name = "hello_lib",
    srcs = [
        "hello.ts",
        "main.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

# M16 thin entry over the compiled output: the library owns the sources,
# the binary carries the entry point only (same shape as
# //javascript/tests/fixtures/hello:hello; see //typescript/rules:defs.bzl — execution
# reuses the JavaScript wrappers, there is no typescript_binary).
javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

# Seed Jest test over the tsc-compiled output (static-import coverage of
# TypeScript sources needs the transform slice). Matches the
# //javascript/tests/fixtures/hello:hello_test precedent; the `*_test.js` naming needs
# the local jest config (same as //javascript/tests/fixtures/entries:helper_test).
javascript_test(
    name = "hello_test",
    srcs = ["hello_test.js"],
    config = "jest.config.cjs",
    data = [":hello_lib"],
    node_modules = "//:node_modules",
    node_options = ["--experimental-vm-modules"],
)

# Hello smoke as a test target (#87 pattern, closes the TS hole from #98):
# asserts the seed binary prints the expected greeting. Tagged
# `no-coverage`: process-spawning tests stay out of the coverage
# denominator per the repo coverage preset. No corpus entry: shell
# sources have no `real_source_target` class.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [":hello", "//tools/sh:lib"],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

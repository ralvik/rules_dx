"""Focused TypeScript environment plans.

Each `typescript_env_plan` reads the analyzed authoritative providers of one
`typescript_project` wrapper: the preserved `JsInfo` and `TsConfigInfo` plus
`QualitySourcesInfo`. Focused-target only; repository/root/exact-target
orchestration remains M25.
"""

load("//quality:fixtures.bzl", "real_source_target")
load("//typescript/env:plan.bzl", "typescript_env_plan")
load("//typescript/env:plan_tests.bzl", "env_plan_tests")

package(default_visibility = ["//visibility:public"])

typescript_env_plan(
    name = "hello_lib_plan",
    target = "//typescript/hello:hello_lib",
)

typescript_env_plan(
    name = "helper_plan",
    target = "//typescript/entries:helper",
)

typescript_env_plan(
    name = "main_plan",
    target = "//typescript/entries:main",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
        ":helper_plan",
        ":main_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

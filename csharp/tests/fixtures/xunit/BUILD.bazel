"""Seed C# xUnit fixture (issue #477): csharp_test over pinned xunit.v3 4.0.0."""

load("//csharp/rules:defs.bzl", "csharp_library", "csharp_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

csharp_library(
    name = "greeter_lib",
    srcs = ["Greeter.cs"],
)

# xUnit v3 4.0.0 mapping: plain csharp_test executable with [Fact]/[Theory]
# sources plus the checked-in MTP entry-point shims (XunitEntryPoint plus
# SelfRegisteredExtensions, adapted from `dotnet new xunit3` MSBuild output
# because rules_dotnet compiles with csc). Deps name the pinned Paket hub
# labels directly: xunit.v3 4.0.0 plus xunit.analyzers 2.0.0 with the MTP
# runner closure (core.mtp-v2, assert, extensibility.core, common,
# runner.common, runner.inproc.console, testing.platform,
# testing.platform.msbuild, telemetry). Unpinned runner: rejected per #477.
csharp_test(
    name = "greeter_test",
    srcs = [
        "GreeterTest.cs",
        "SelfRegisteredExtensions.cs",
        "XunitEntryPoint.cs",
    ],
    deps = [
        ":greeter_lib",
        "@paket.main//microsoft.testing.extensions.telemetry",
        "@paket.main//microsoft.testing.extensions.trxreport.abstractions",
        "@paket.main//microsoft.testing.platform",
        "@paket.main//microsoft.testing.platform.msbuild",
        "@paket.main//xunit.analyzers",
        "@paket.main//xunit.v3",
        "@paket.main//xunit.v3.assert",
        "@paket.main//xunit.v3.common",
        "@paket.main//xunit.v3.core.mtp-v2",
        "@paket.main//xunit.v3.extensibility.core",
        "@paket.main//xunit.v3.mtp-v2",
        "@paket.main//xunit.v3.runner.common",
        "@paket.main//xunit.v3.runner.inproc.console",
    ],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

"""M23 seed C# binary and library; consumer of csharp_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//csharp/rules:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

csharp_library(
    name = "hello_lib",
    srcs = ["Hello.cs"],
)

csharp_binary(
    name = "hello",
    srcs = ["Program.cs"],
    deps = [":hello_lib"],
)

csharp_test(
    name = "hello_test",
    srcs = ["HelloTest.cs"],
    deps = [":hello_lib"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Hello smoke test (#87); no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

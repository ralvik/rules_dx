"""M23 seed C# binary and library; consumer of csharp_* wrappers."""

load("//csharp/rules:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "hello_lib",
    srcs = ["Hello.cs"],
)

csharp_binary(
    name = "hello",
    srcs = ["Program.cs"],
    deps = [":hello_lib"],
)

csharp_test(
    name = "hello_test",
    srcs = ["HelloTest.cs"],
    deps = [":hello_lib"],
)

# Repository corpus: build metadata owned for direct-Bazel
# dogfood under the canonical real_fixture_policy. C# sources stay
# dx-owned, never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

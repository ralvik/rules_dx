"""M16 seed JavaScript binary and library; consumer of javascript_* wrappers."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//javascript/rules:defs.bzl", "javascript_binary", "javascript_library", "javascript_test")
load("//quality:fixtures.bzl", "real_source_target")

package(
    default_testonly = True,
    default_visibility = ["//:__subpackages__"],
)

javascript_library(
    name = "hello_lib",
    srcs = ["hello.js"],
    # Lane A: direct aspect_hints binding; see docs/contributing/build-conventions.md.
    aspect_hints = ["//:biome_config"],
)

javascript_binary(
    name = "hello",
    data = [":hello_lib"],
    entry_point = "main.js",
)

javascript_test(
    name = "hello_test",
    srcs = ["hello.test.js"],
    data = [":hello_lib"],
    node_modules = "//:node_modules",
    # First-party .js is ESM (root `"type": "module"`); jest needs VM
    # modules to execute it (same flag as upstream's esm example).
    node_options = ["--experimental-vm-modules"],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
# Hello smoke test (#87); no-coverage process-spawning, see build-conventions.
sh_test(
    name = "hello_output_test",
    srcs = ["hello_output_test.sh"],
    args = ["$(rootpath :hello)"],
    data = [
        ":hello",
        "//tools/sh:lib",
    ],
    tags = ["no-coverage"],
    # Bash-only harness is Linux-only (issue #299 shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    testonly = True,
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

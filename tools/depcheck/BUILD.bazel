sh_test(
    name = "rust_consistency_test",
    srcs = ["consistency_test.sh"],
    args = [
        "rust",
        "$(rootpath :checker_main)",
        "tools/depcheck/testdata/rust",
    ],
    data = [
        ":checker",
        ":checker_main",
        ":rust_testdata",
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
    ],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)


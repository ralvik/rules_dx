# Repository corpus: build file plus all TOML fixtures owned for
# direct-Bazel dogfood under the canonical real_fixture_policy. Python
# sources, Rust sources, JS/TS sources, and locks stay dx-owned or
# testdata (code ownership via test data), never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = glob(["testdata/**/*.toml"]),
)

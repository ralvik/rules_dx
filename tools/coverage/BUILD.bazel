"""Thin entry point over the promoted `dx_lcov` library."""

# Source-only package (no Cargo manifest). The gate library now lives
# at `//cli/lcov:dx_lcov`; this package owns only the `coverage_bin` entry
# point, hand-maintained and excluded from generation in the root BUILD.
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary")

package(default_visibility = ["//:__subpackages__"])

# Cell registry plus per-cell inventories (issue #915): referenced by
# cells.txt rows and gated by coverage_bin; exported here so Bazel
# consumers depend on labels instead of reaching into the source tree.
exports_files([
    "arm64-inventory.txt",
    "cells.txt",
    "macos-arm64-inventory.txt",
    "macos-x86_64-inventory.txt",
    "musl-arm64-inventory.txt",
    "musl-x86_64-inventory.txt",
    "seed-inventory.txt",
    "windows-x86_64-inventory.txt",
])

filegroup(
    name = "cell_inventories",
    srcs = [
        "arm64-inventory.txt",
        "cells.txt",
        "macos-arm64-inventory.txt",
        "macos-x86_64-inventory.txt",
        "musl-arm64-inventory.txt",
        "musl-x86_64-inventory.txt",
        "seed-inventory.txt",
        "windows-x86_64-inventory.txt",
    ],
)

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

rust_binary(
    name = "coverage_bin",
    srcs = ["src/main.rs"],
    crate_name = "coverage",
    crate_root = "src/main.rs",
    deps = ["//cli/lcov:dx_lcov"],
)

# First-party coverage PR summary renderer: presents the
# Bazel-owned gate verdict as the adopted compact summary comment.
# Run by CI via `bazel run //tools/coverage:coverage_comment -- ...`.
sh_binary(
    name = "coverage_comment",
    srcs = ["coverage_comment.sh"],
    # Bash-only harness is Linux-only (shell contract).
    target_compatible_with = ["@platforms//os:linux"],
)

"""M00 coverage gate CLI: thin entry point over the promoted `dx_lcov` library (#74)."""

# M13: source-only package (no Cargo manifest). The gate library now lives
# at `//cli/lcov:dx_lcov`; this package owns only the `coverage_bin` entry
# point, hand-maintained and excluded from generation in the root BUILD.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Repository corpus: build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. Rust sources stay dx-owned
# (M02 wrappers), never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

rust_binary(
    name = "coverage_bin",
    srcs = ["src/main.rs"],
    crate_name = "coverage",
    crate_root = "src/main.rs",
    deps = ["//cli/lcov:dx_lcov"],
)

"""Shared coverage-marker scanner (`coverage_gate`): LCOV parsing and
`LCOV_EXCL_*` validation reused by `dx coverage --min-coverage`."""

# M13: source-only package (no Cargo manifest), so the same-package
# `coverage_gate` import (`use coverage_gate;` in `src/main.rs`) has no
# manifest path edge and the plain `rust_library` provider is not indexed;
# the package-scoped resolve pins it to the hand-maintained `:coverage_gate`
# dep instead of letting generation drop it as unresolvable.
# gazelle:resolve rust coverage_gate //tools/coverage:coverage_gate
load("@rules_dx//rust/rules:defs.bzl", "RUST_EDITION", "rust_binary")
load("@rules_rust//rust:defs.bzl", _rust_library = "rust_library", _rust_test = "rust_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

_rust_library(
    name = "coverage_gate",
    srcs = ["src/lib.rs"],
    crate_name = "coverage_gate",
    edition = RUST_EDITION,
)

_rust_test(
    name = "coverage_gate_test",
    size = "small",
    crate = ":coverage_gate",
    edition = RUST_EDITION,
)

# Repository corpus: build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. Rust sources stay dx-owned
# (M02 wrappers), never corpus sources.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

rust_binary(
    name = "coverage_bin",
    srcs = ["src/main.rs"],
    crate_name = "coverage",
    crate_root = "src/main.rs",
    deps = ["//tools/coverage:coverage_gate"],
)

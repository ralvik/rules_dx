"""M00 implementation-coverage gate (WP4)."""

load("@rules_dx//rust/rules:defs.bzl", "dx_rust_binary", "dx_rust_library", "dx_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "coverage_gate",
    srcs = ["src/lib.rs"],
    crate_name = "coverage_gate",
    edition = "2021",
)

rust_binary(
    name = "check",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [":coverage_gate"],
)

rust_test(
    name = "coverage_gate_test",
    size = "small",
    crate = ":coverage_gate",
    edition = "2021",
)

# Repository corpus (M05 WP1): build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. Rust sources stay dx-owned
# (M02 wrappers), never corpus sources; inventory.txt has no class.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

dx_rust_library(
    name = "coverage",
    srcs = ["src/lib.rs"],
    crate_name = "coverage",
    crate_root = "src/lib.rs",
)

dx_rust_test(
    name = "coverage_test",
    crate = ":coverage",
)

dx_rust_binary(
    name = "coverage_bin",
    srcs = ["src/main.rs"],
    crate_name = "coverage",
    crate_root = "src/main.rs",
    deps = [":coverage_gate"],
)

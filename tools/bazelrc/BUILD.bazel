"""Vendored Bazel execution preset.

`bazel run //tools/bazelrc:preset.update` regenerates the checked-in
fragment from the reviewed inventory in `preset.py`;
`preset.update_test` pins the Bazel pin, the per-release dx stamp, and
the flag inventory via file substring checks on the fragment. Consumers
refresh via `dx update` and gate staleness via `dx update --check`.
"""

load("@rules_python//python:defs.bzl", "py_binary")
load("//quality:fixtures.bzl", "real_source_target")
load(":preset_tests.bzl", "preset_update_tests")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "preset.update",
    srcs = ["preset.py"],
    main = "preset.py",
)

exports_files([
    "preset.bazelrc",
    "preset.py",
])

preset_update_tests(name = "preset.update_test")

test_suite(
    name = "all",
    tests = [":preset.update_test"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "preset_tests.bzl",
    ],
    tags = ["corpus"],
)

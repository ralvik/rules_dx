"""Package-boundary visibility contract (single source).

`visibility.bzl` owns every package default and cross-layer rule; BUILD
files load its scope constants by name and `//tools/ci:visibility_guards`
machine-checks the tree against it.
"""

load("//quality:fixtures.bzl", "real_source_target")
load(":visibility_tests.bzl", "visibility_unit_tests")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "visibility.bzl",
    "visibility_tests.bzl",
])

visibility_unit_tests(name = "visibility_unit")

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "visibility.bzl",
        "visibility_tests.bzl",
    ],
    tags = ["corpus"],
)

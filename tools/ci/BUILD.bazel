"""CI-owned hygiene scripts (issue #80).

`bazel run //tools/ci:corpus_audit` runs the corpus ownership audit:
every applicable checked-in file must have a corpus owner
(`real_source_target`) so the dx quality commands cover the repository
they dogfood. Promoted from an inline ci.yml shell pipeline so the
audit logic is versioned and reviewable.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

sh_binary(
    name = "corpus_audit",
    srcs = ["corpus_audit.sh"],
)

# Manual negative-demo harness (issue #99 item 2): the expected-fail
# demonstrations in libs/starlark/tests/negative plus the
# markdown-no-config subject are `manual`, so wildcard suites never run
# them. Run by CI via `bazel run //tools/ci:manual_negatives` to prove
# each still fails for its documented reason and that no new manual
# test appears without explicit classification.
sh_binary(
    name = "manual_negatives",
    srcs = ["manual_negatives.sh"],
)

# Consumer CI template harness (issue #99 item 1): each script executes
# the REAL embedded contract out of workflows/reusable-consumer.yml
# (platforms-gate, dx-ci aggregation, check guards, pins/threshold)
# over positive, boundary, and mutated-negative matrices, so template
# drift fails `bazel test //tools/ci/...` instead of failing consumers.
sh_test(
    name = "consumer_scheduling_test",
    srcs = ["consumer_scheduling_test.sh"],
    args = ["$(rootpath //.github:workflows/reusable-consumer.yml)"],
    data = ["//.github:workflows/reusable-consumer.yml"],
)

sh_test(
    name = "consumer_aggregate_test",
    srcs = ["consumer_aggregate_test.sh"],
    args = ["$(rootpath //.github:workflows/reusable-consumer.yml)"],
    data = ["//.github:workflows/reusable-consumer.yml"],
)

sh_test(
    name = "consumer_guards_test",
    srcs = ["consumer_guards_test.sh"],
    args = [
        "$(rootpath //.github:workflows/reusable-consumer.yml)",
        "$(rootpath //examples:consumer-ci/caller.yml)",
    ],
    data = [
        "//.github:workflows/reusable-consumer.yml",
        "//examples:consumer-ci/caller.yml",
    ],
)

sh_test(
    name = "consumer_pins_test",
    srcs = ["consumer_pins_test.sh"],
    args = [
        "$(rootpath //.github:workflows/reusable-consumer.yml)",
        "$(rootpath //examples:consumer-ci/caller.yml)",
        "$(rootpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//.github:workflows/reusable-consumer.yml",
        "//examples:consumer-ci/caller.yml",
    ],
)

# Example caller pin-sync harness (issue #209): both example callers
# (consumer-ci, docs-ci) share one reviewed reusable-workflow pin; drift
# between them fails the gate, so a deliberate bump moves both in one
# reviewed change.
sh_test(
    name = "examples_pins_test",
    srcs = ["examples_pins_test.sh"],
    args = [
        "$(rootpath //examples:consumer-ci/caller.yml)",
        "$(rootpath //examples:docs-ci/caller.yml)",
        "$(rootpath //:MODULE.bazel)",
    ],
    data = [
        "//:MODULE.bazel",
        "//examples:consumer-ci/caller.yml",
        "//examples:docs-ci/caller.yml",
    ],
)

# Seed-cell coverage gate harness (issue #89 item 1): runs the real
# scoped `bazel coverage` report through the `check` gate CLI against the
# versioned seed inventory, with mutated-input negatives proving it fails
# closed. Run by CI via `bazel run //tools/ci:coverage_cell`.
sh_binary(
    name = "coverage_cell",
    srcs = ["coverage_cell.sh"],
)

# Target-tag semantics harness (issue #99 item 3): proves `flaky`
# forwards to private upstream tests (off by default), `bazel coverage`
# skips `no-coverage` tests while running untagged ones, and the
# `no-lint` / `no-typecheck` opt-out fixtures stay wired to the
# capability presence suites. Run by CI via
# `bazel run //tools/ci:target_tags`.
sh_binary(
    name = "target_tags",
    srcs = ["target_tags.sh"],
)

# Stage 4 E2E drivers (issue #55): one `manual` (+`exclusive`,
# `local`, `no-sandbox`) sh_test per landed `integration/` scenario plus
# the explicit suite. Wildcard suites (`bazel test //...`,
# `dx test //...`) never run these (manual-tag semantics); CI invokes
# `E2E_WORKSPACE=$GITHUB_WORKSPACE bazel test //tools/ci:e2e
# --test_env=E2E_WORKSPACE`. The pinned-Bazel wrapper comes from the
# `rules_bazel_integration_test` dev-dependency
# (`bazel_binaries.download`, single 9.2.0 pin tracking
# //.bazelversion); scenario files arrive by shell copy, never by label,
# because `integration/` is .bazelignore'd out of the parent universe.
sh_test(
    name = "e2e_clean",
    timeout = "long",
    srcs = ["e2e.sh"],
    args = [
        "clean",
        "0",
        "$(rootpath //cli/cli:dx)",
        "$(rootpath @build_bazel_bazel_9_2_0//:bazel_binary)",
    ],
    data = [
        "//cli/cli:dx",
        "@build_bazel_bazel_9_2_0//:bazel_binary",
    ],
    tags = [
        "exclusive",
        "local",
        "manual",
        "no-sandbox",
    ],
)

# Dirty half of the CLI-contract pin (issue #55): the child has one
# failing `sh_test`, so `dx test //...` must preserve Bazel's
# test-failure code 3 verbatim. Paired with `e2e_clean` (exit 0), this
# is the negative control: always-pass detectors fail here,
# always-fail detectors fail `clean`.
sh_test(
    name = "e2e_dirty",
    timeout = "long",
    srcs = ["e2e.sh"],
    args = [
        "dirty",
        "3",
        "$(rootpath //cli/cli:dx)",
        "$(rootpath @build_bazel_bazel_9_2_0//:bazel_binary)",
    ],
    data = [
        "//cli/cli:dx",
        "@build_bazel_bazel_9_2_0//:bazel_binary",
    ],
    tags = [
        "exclusive",
        "local",
        "manual",
        "no-sandbox",
    ],
)

test_suite(
    name = "e2e",
    tags = [
        "exclusive",
        "local",
        "manual",
        "no-sandbox",
    ],
    tests = [
        ":e2e_clean",
        ":e2e_dirty",
    ],
)

# Repository corpus: build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy. The audit script itself is
# CI tooling, never a corpus source.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

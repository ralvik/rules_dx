"""CI-owned hygiene scripts (issue #80).

`bazel run //tools/ci:corpus_audit` runs the corpus ownership audit:
every applicable checked-in file must have a corpus owner
(`real_source_target`) so the dx quality commands cover the repository
they dogfood. Promoted from an inline ci.yml shell pipeline so the
audit logic is versioned and reviewable.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])


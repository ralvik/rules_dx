"""CI-owned hygiene scripts.

`bazel run //tools/ci:corpus_audit` runs the corpus ownership audit:
every applicable checked-in file must have a corpus owner
(`real_source_target`) so the dx quality commands cover the repository
they dogfood. Promoted from an inline ci.yml shell pipeline so the
audit logic is versioned and reviewable.
"""

load("//quality:fixtures.bzl", "real_source_target")

# Single target list (issue #915): ~160 sh_binary/sh_test targets live in
# four size shards (ci_targets_a/b/c/d.bzl, ~40 each) so files stay
# reviewable; this BUILD file is the only call site (add_a/b/c/d below).
# Targets keep bespoke srcs/args/data per harness, so glob generation stays
# rejected: a glob would silently adopt stray scripts with wrong deps.
load(":ci_targets_a.bzl", "add_a")
load(":ci_targets_b.bzl", "add_b")
load(":ci_targets_c.bzl", "add_c")
load(":ci_targets_d.bzl", "add_d")

package(default_visibility = ["//:__subpackages__"])

add_a()

add_b()

add_c()

add_d()

filegroup(
    name = "warnings_as_errors_testdata",
    srcs = glob(["testdata/warnings/**"]),
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "ci_targets_a.bzl",
        "ci_targets_b.bzl",
        "ci_targets_c.bzl",
        "ci_targets_d.bzl",
    ],
    tags = ["corpus"],
)

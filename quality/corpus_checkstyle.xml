<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Own-tree Checkstyle policy for Java corpus targets (unused imports only).
Mirrors `corpus_vale.ini`: the config reaches the tool as `-c`, never as
an ambient default. Every applicable java_* target must bind this via
`aspect_hints` (Checkstyle has no usable upstream default). -->
<module name="Checker">
  <module name="TreeWalker">
    <module name="UnusedImports"/>
  </module>
</module>

"""M03 WP3 direct-Bazel per-result threshold evaluator."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "quality_evaluator_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "quality/quality_evaluator",
        normal = True,
    ),
    crate_name = "quality_evaluator",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
        ],
        package_name = "quality/quality_evaluator",
    ) + ["//quality/result:quality_result"],
)

rust_binary(
    name = "quality_evaluator",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_evaluator",
        normal = True,
    ),
    crate_name = "quality_evaluator",
    crate_root = "src/main.rs",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
        ],
        package_name = "quality/quality_evaluator",
    ) + [
        ":quality_evaluator_lib",
        "//cli/atomic_fs:dx_atomic_fs",
        "//quality/result:quality_result",
    ],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_evaluator_fmt_test",
    size = "small",
    targets = [
        ":quality_evaluator_lib",
        ":quality_evaluator",
    ],
)

rust_clippy_test(
    name = "quality_evaluator_clippy_test",
    size = "small",
    targets = [
        ":quality_evaluator_lib",
        ":quality_evaluator",
    ],
)

exports_files(["Cargo.toml"])

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

rust_test(
    name = "quality_evaluator_test",
    aliases = aliases(
        package_name = "quality/quality_evaluator",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_evaluator_lib",
    deps = crate_deps(
        [
            "clap",
            "thiserror",
        ],
        package_name = "quality/quality_evaluator",
    ) + ["//quality/result:quality_result"],
)

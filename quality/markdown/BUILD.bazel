"""M04 WP3 repository-owned Markdown link/structure checker crate."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "quality_markdown_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
        ],
        package_name = "quality/quality_markdown",
    ),
)

rust_binary(
    name = "quality_markdown",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
    ),
    crate_name = "quality_markdown",
    crate_root = "src/main.rs",
    deps = [":quality_markdown_lib"],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_markdown_fmt_test",
    size = "small",
    targets = [
        ":quality_markdown",
        ":quality_markdown_lib",
    ],
)

rust_clippy_test(
    name = "quality_markdown_clippy_test",
    size = "small",
    targets = [
        ":quality_markdown",
        ":quality_markdown_lib",
    ],
)

exports_files(["Cargo.toml"])

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

rust_test(
    name = "quality_markdown_test",
    aliases = aliases(
        package_name = "quality/quality_markdown",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_markdown_lib",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
        ],
        package_name = "quality/quality_markdown",
    ),
)

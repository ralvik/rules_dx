    "vale.macos_x86_64.bzl",
    "vale.windows_x86_64.bzl",
])

# Canonical tool versions for //tools/ci:config_consistency_test
# (issue #912): `TOOLS[biome]` owns the Biome `$schema` version.
exports_files(
    ["update.py"],
    visibility = [
        "//quality:__pkg__",
        "//quality:__subpackages__",
        "//tools/ci:__pkg__",
    ],
)

metadata_tests(name = "metadata")

test_suite(
    name = "all",
    tests = [":metadata"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [

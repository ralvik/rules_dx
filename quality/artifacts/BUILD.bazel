"""M04 standalone quality-tool artifact metadata (WP1, O20)."""

load("@rules_python//python:defs.bzl", "py_binary")
load("//quality:fixtures.bzl", "real_source_target")
load(":metadata_tests.bzl", "metadata_tests")

package(default_visibility = [
    "//quality:__pkg__",
    "//quality:__subpackages__",
])

py_binary(
    name = "update",
    srcs = ["update.py"],
    main = "update.py",
)

exports_files([
    "biome.linux_x86_64.bzl",
    "buildifier.linux_x86_64.bzl",
    "ruff.linux_x86_64.bzl",
    "taplo.linux_x86_64.bzl",
    "ty.linux_x86_64.bzl",
    "vale.linux_x86_64.bzl",
])

metadata_tests(name = "metadata")

test_suite(
    name = "all",
    tests = [":metadata"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = [
        "BUILD.bazel",
        "biome.linux_x86_64.bzl",
        "buildifier.linux_x86_64.bzl",
        "extension.bzl",
        "metadata_tests.bzl",
        "ruff.linux_x86_64.bzl",
        "taplo.linux_x86_64.bzl",
        "ty.linux_x86_64.bzl",
        "vale.linux_x86_64.bzl",
    ],
    tags = ["corpus"],
)

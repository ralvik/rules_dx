"""M03 WP2b deterministic shared pipeline runner over synthetic adapters."""

load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_binary", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "quality_runner_lib",
    srcs = [
        "src/lib.rs",
        "src/real.rs",
    ],
    crate_name = "quality_runner",
    edition = "2021",
    deps = [
        "//quality:result_proto_rs",
        "//quality/adapter:quality_adapter",
        "//quality/result:quality_result",
        # The `prost` types must come from the same crate that the
        # generated code implements them against: the toolchain-vendored
        # prost, not a second copy from crate_universe.
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

dx_rust_binary(
    name = "quality_runner",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":quality_runner_lib",
        "//quality/result:quality_result",
    ],
)

dx_rust_test(
    name = "quality_runner_test",
    size = "small",
    crate = ":quality_runner_lib",
    edition = "2021",
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_runner_fmt_test",
    size = "small",
    targets = [
        ":quality_runner_lib",
        ":quality_runner",
    ],
)

rust_clippy_test(
    name = "quality_runner_clippy_test",
    size = "small",
    targets = [
        ":quality_runner_lib",
        ":quality_runner",
    ],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

"""WP2b deterministic shared pipeline runner over synthetic adapters."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = [
    "//quality:__pkg__",
    "//quality:__subpackages__",
])

rust_library(
    name = "quality_runner_lib",
    srcs = [
        "src/lib.rs",
        "src/real.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_runner",
        normal = True,
    ),
    crate_name = "quality_runner",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_runner",
    ) + [
        "//cli/digest:dx_digest",
        "//quality/adapter:quality_adapter",
        "//quality/result:quality_result",
    ],
)

rust_binary(
    name = "quality_runner",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "quality/quality_runner",
        normal = True,
    ),
    crate_name = "quality_runner",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "clap",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_runner",
    ) + [
        ":quality_runner_lib",
        "//cli/atomic_fs:dx_atomic_fs",
        "//cli/output:dx_output",
        "//quality/result:quality_result",
    ],
)

# Authoritative quality identities (pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_runner_fmt_test",
    size = "small",
    targets = [
        ":quality_runner_lib",
        ":quality_runner",
    ],
)

rust_clippy_test(
    name = "quality_runner_clippy_test",
    size = "small",
    targets = [
        ":quality_runner_lib",
        ":quality_runner",
    ],
)

exports_files(["Cargo.toml"])

# Corpus: BUILD ownership; see docs/contributing/build-conventions.md.
rust_test(
    name = "quality_runner_test",
    aliases = aliases(
        package_name = "quality/quality_runner",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_runner_lib",
    deps = crate_deps(
        [
            "clap",
            "tempfile",
            "thiserror",
            "tracing",
        ],
        package_name = "quality/quality_runner",
    ) + [
        "//cli/digest:dx_digest",
        "//quality/result:quality_result",
    ],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

"""M04 real-tool adapter crate: check/fix execution and output parsing."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "quality_adapter",
    srcs = [
        "src/commands.rs",
        "src/exec.rs",
        "src/lib.rs",
        "src/parsers.rs",
        "src/suggest.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_adapter",
        normal = True,
    ),
    crate_name = "quality_adapter",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
        ],
        package_name = "quality/quality_adapter",
    ) + ["//quality/result:quality_result"],
)

dx_rust_test(
    name = "quality_adapter_test",
    size = "small",
    aliases = aliases(
        package_name = "quality/quality_adapter",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_adapter",
    edition = "2021",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
        ],
        package_name = "quality/quality_adapter",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_adapter_fmt_test",
    size = "small",
    targets = [":quality_adapter"],
)

rust_clippy_test(
    name = "quality_adapter_clippy_test",
    size = "small",
    targets = [":quality_adapter"],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

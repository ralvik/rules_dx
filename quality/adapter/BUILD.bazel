"""M04 real-tool adapter crate: check/fix execution and output parsing."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "quality_adapter",
    srcs = [
        "src/commands.rs",
        "src/exec.rs",
        "src/lib.rs",
        "src/parsers/biome.rs",
        "src/parsers/buildifier.rs",
        "src/parsers/eslint.rs",
        "src/parsers/flake8.rs",
        "src/parsers/markdown.rs",
        "src/parsers/mod.rs",
        "src/parsers/prettier.rs",
        "src/parsers/pydoclint.rs",
        "src/parsers/pylint.rs",
        "src/parsers/ruff.rs",
        "src/parsers/rust.rs",
        "src/parsers/rustfmt.rs",
        "src/parsers/taplo.rs",
        "src/parsers/tsc.rs",
        "src/parsers/ty.rs",
        "src/parsers/vale.rs",
    ],
    aliases = aliases(
        package_name = "quality/quality_adapter",
        normal = True,
    ),
    crate_name = "quality_adapter",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "normpath",
            "serde",
            "serde_json",
            "tempfile",
            "thiserror",
        ],
        package_name = "quality/quality_adapter",
    ) + ["//quality/result:quality_result"],
)

rust_test(
    name = "quality_adapter_test",
    size = "small",
    aliases = aliases(
        package_name = "quality/quality_adapter",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_adapter",
    deps = crate_deps(
        [
            "normpath",
            "serde",
            "serde_json",
            "tempfile",
            "thiserror",
        ],
        package_name = "quality/quality_adapter",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_adapter_fmt_test",
    size = "small",
    targets = [":quality_adapter"],
)

rust_clippy_test(
    name = "quality_adapter_clippy_test",
    size = "small",
    targets = [":quality_adapter"],
)

exports_files(["Cargo.toml"])

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["Cargo.toml"],
)

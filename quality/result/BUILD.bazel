"""M03 result-side validation crate over the frozen result schema."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "quality_result",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
    ),
    crate_name = "quality_result",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["thiserror"],
        package_name = "quality/quality_result",
    ) + [
        "//cli/digest:dx_digest",
        "//cli/path:dx_path",
        "//cli/proto_validate:dx_proto_validate",
        "//cli/schema:dx_schema",
        "//quality:result_proto_rs",
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

rust_test(
    name = "quality_result_test",
    size = "small",
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
        normal_dev = True,
    ),
    crate = ":quality_result",
    deps = crate_deps(
        ["thiserror"],
        package_name = "quality/quality_result",
    ) + ["@rules_rust_prost//private/3rdparty/crates:prost"],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_result_fmt_test",
    size = "small",
    targets = [":quality_result"],
)

rust_clippy_test(
    name = "quality_result_clippy_test",
    size = "small",
    targets = [":quality_result"],
)

exports_files(["Cargo.toml"])

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

rust_binary(
    name = "print_result",
    srcs = ["src/print.rs"],
    aliases = aliases(
        package_name = "quality/quality_result",
        normal = True,
    ),
    crate_name = "print_result",
    crate_root = "src/print.rs",
    edition = "2021",
    deps = crate_deps(
        ["thiserror"],
        package_name = "quality/quality_result",
    ) + [":quality_result"],
)

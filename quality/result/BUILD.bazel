"""M03 result-side validation crate over the frozen result schema."""

load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "quality_result",
    srcs = ["src/lib.rs"],
    crate_name = "quality_result",
    edition = "2021",
    deps = [
        "//quality:result_proto_rs",
        "@crates//:blake3",
        # The `prost::Message` trait must come from the same crate that
        # the generated code implements it against: the toolchain-vendored
        # prost, not a second copy from crate_universe.
        "@rules_rust_prost//private/3rdparty/crates:prost",
    ],
)

dx_rust_test(
    name = "quality_result_test",
    size = "small",
    crate = ":quality_result",
    edition = "2021",
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "quality_result_fmt_test",
    size = "small",
    targets = [":quality_result"],
)

rust_clippy_test(
    name = "quality_result_clippy_test",
    size = "small",
    targets = [":quality_result"],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

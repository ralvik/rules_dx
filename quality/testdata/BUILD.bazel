# Manual negative demo: markdown without a vale_config hint must
# fail analysis with the actionable config-required error. The red
# source + subject stay manual (wildcard builds skip them); the
# expect-failure test below is green and proves the diagnostic. Build
# explicitly with --nobuild to observe the raw failure.
real_aspect_subject(
    name = "fixture_real_markdown_no_config_subject",
    tags = ["manual"],
    target = ":fixture_real_markdown_no_config",
)

# Green hermetic proof that Vale-no-config fails analysis
# with the actionable diagnostic. Passes by asserting the failure; the
# subject stopping to fail fails this test.
failure_test(
    name = "fixture_real_markdown_no_config_test",
    expected_failure_substring = "applicable Vale requires declared config",
    target = ":fixture_real_markdown_no_config_subject",
)


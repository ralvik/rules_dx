# Hinted Biome policy for the real-pipeline fixture. Empty
# object selects pinned upstream defaults explicitly, so the hinted run
# proves the config closure reaches the tool as --config-path instead of
# the materialized defaults directory. The config lives in its own
# subdirectory because Biome rejects a --config-path directory that also
# contains linted sources.
biome_config(
    name = "biome_cfg",
    src = "biome_cfg/biome.json",
)

# ESLint flat config for the JavaScript lint opt-in. Minimal
# `no-unused-vars` error proves the `-c` closure reaches the js_binary
# wrapper; the config lives in its own subdirectory so the flat-config
# base path contains the mirrored sources without shadowing them.
eslint_config(
    name = "eslint_cfg",
    src = "eslint_cfg/eslint.config.js",
)


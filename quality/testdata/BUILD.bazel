# Dirty synthetic sources (dirty.py/dirty.rs) were live aspect subjects
# breaking `dx <check> --check //...` (scope 2). Removed:
# dirty coverage lives in the Layer-2 matrix as provider-less
# `generated` bytes with `print_result` goldens (both `*_pass`/`*_fail`
# green), following `tools/depcheck/testdata/` (no live dirty targets).
# `fixture_mixed_clean` below keeps the multi-family (python+rust) proof.

quality_source_target(
    name = "fixture_mixed_clean",
    python_srcs = ["clean.py"],
    rust_srcs = ["clean.rs"],
)

quality_source_target(
    name = "fixture_no_lint",
    python_srcs = ["clean.py"],
    rust_srcs = ["clean.rs"],
    tags = ["no-lint"],
)


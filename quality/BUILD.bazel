# Corpus Vale configuration: every Markdown corpus target binds
# this hint. The style stays narrow (`Dx.Markers` only;
# wont-fix, pinned by `corpus_vale.ini` plus `corpus_styles/Dx/Markers.yml`):
# prose rules are out of scope, native-config owns policy with no hidden preset.
# Strict: the ini carries `[*] BasedOnStyles = Dx` so markers
# enforce (without it Vale reports {}).
vale_config(
    name = "corpus_vale_config",
    src = "corpus_vale.ini",
    data = ["corpus_styles/Dx/Markers.yml"],
)

# Corpus Checkstyle configuration: every applicable Java corpus target
# binds this hint (Checkstyle has no usable upstream default, so stages
# fail without it). Narrow unused-imports policy mirrors the Layer-2
# matrix fixture.
checkstyle_config(
    name = "corpus_checkstyle_config",
    src = "corpus_checkstyle.xml",
)


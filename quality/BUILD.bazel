# Single-source Vale corpus inputs for //tools/ci:config_consistency_test
# (issue #912): the fixture copy in //quality/testdata must stay
# byte-identical (StylesPath differs per package, so the style file itself
# is synced by diff test, not by label sharing).
exports_files([
    "corpus_vale.ini",
    "corpus_styles/Dx/Markers.yml",
])

# Frozen result schema (WP1): field and enum numbers are the
# compatibility surface; see `result.proto` and the protocol doc.
proto_library(
    name = "result_proto",
    srcs = ["result.proto"],
)

rust_prost_library(
    name = "result_proto_rs",
    proto = ":result_proto",
)

# Synthetic fixture policy: proves multi-family aggregation and
# one adapter selected by two families. Tool IDs are synthetic; the real
# family taxonomy and curated defaults belong to the tool baseline.
quality_family(
    name = "rust_family",
    family_id = "rust",
    format = ["fmt-a"],
    lint = [
        "lint-a",
        "lint-b",
    ],
)

quality_family(
    name = "python_family",
    family_id = "python",
    lint = ["lint-a"],
)

workspace_policy(
    name = "fixture_policy",
    families = [
        ":python_family",
        ":rust_family",
    ],
)

# Real fixture policy: selects the initial-adapter tool IDs for
# the source classes. Like the synthetic fixture policy, this is a
# fixture, not curated defaults: the family taxonomy is frozen in
# quality/adapters.bzl and curated defaults in quality/curated_defaults.bzl.
# family_id overlap with the synthetic policy above is intentional
# (issue #915): each workspace_policy resolves its own families, so the
# synthetic rust/python families never merge with the real ones; the
# shared ids prove multi-policy aggregation, not a collision.
# This policy is also the canonical
# workspace policy — every repository corpus target is checked under it
# (fixtures keep it too), so dogfood findings reproduce under one policy.
quality_family(
    name = "real_rust_family",
    family_id = "rust",
    format = ["rustfmt"],
    lint = ["clippy"],
    typecheck = ["rustc"],
)

quality_family(
    name = "real_starlark_family",
    family_id = "starlark",
    format = ["buildifier"],
    lint = ["buildifier"],
)

quality_family(
    name = "real_toml_family",
    family_id = "toml",
    format = ["taplo"],
    lint = ["taplo"],
)

quality_family(
    name = "real_markdown_family",
    family_id = "markdown",
    lint = [
        "markdown_check",
        "vale",
    ],
)

# Real fixture Python family: curated defaults per the tool
# baseline (Ruff lint+format, pydoclint lint, Ty typecheck). Flake8 and
# pylint remain baseline opt-ins owned by WP3. Like the other real
# families, this is a fixture, not the frozen taxonomy.
quality_family(
    name = "real_python_family",
    family_id = "python",
    format = ["ruff"],
    lint = [
        "pydoclint",
        "ruff",
    ],
    typecheck = ["ty"],
)

# Real fixture JavaScript/TypeScript/JSON families: curated
# defaults per the tool baseline (Biome default linter and formatter for
# JavaScript and TypeScript, Biome default linter for JSON, Prettier
# default JSON formatter, tsc typecheck for TypeScript). ESLint stays a
# lint opt-in for the javascript family and Prettier a format alternative
# for the javascript and typescript families; both remain selectable but
# absent below. Like the other real families, this is a fixture, not the
# frozen taxonomy.
quality_family(
    name = "real_javascript_family",
    family_id = "javascript",
    format = ["biome"],
    lint = ["biome"],
)

quality_family(
    name = "real_json_family",
    family_id = "json",
    format = ["prettier"],
    lint = ["biome"],
)

quality_family(
    name = "real_typescript_family",
    family_id = "typescript",
    format = ["biome"],
    lint = ["biome"],
    typecheck = ["tsc"],
)

# Real fixture JVM families: curated defaults per the tool baseline
# (google-java-format format plus Checkstyle/PMD lint for Java, ktfmt
# format plus ktlint lint for Kotlin). SpotBugs stays target-coupled
# (needs JavaInfo, dropped for provider-less fixtures) but remains
# selectable in the lint list so authoritative java_library targets
# keep their stage.
quality_family(
    name = "real_java_family",
    family_id = "java",
    format = ["google_java_format"],
    lint = [
        "checkstyle",
        "pmd",
        "spotbugs",
    ],
)

quality_family(
    name = "real_kotlin_family",
    family_id = "kotlin",
    format = ["ktfmt"],
    lint = ["ktlint"],
)

workspace_policy(
    name = "real_fixture_policy",
    families = [
        ":real_java_family",
        ":real_javascript_family",
        ":real_kotlin_family",
        ":real_json_family",
        ":real_markdown_family",
        ":real_python_family",
        ":real_rust_family",
        ":real_starlark_family",
        ":real_toml_family",
        ":real_typescript_family",
    ],
)

policy_subject(
    name = "policy_under_test",
    policy = ":fixture_policy",
)


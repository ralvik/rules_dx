"""M15 WP1/WP3: private wheel-only Python tool graph (pydoclint + flake8 + pylint).

Ruleset-owned ecosystem graph per tool-acquisition: rules_dx owns the
pyproject/uv.lock, exposes stable entry-point targets through authoritative
Python rules, and hides hub layout from consumers. All tools share the
managed 3.12 interpreter toolchain (no ambient Python).

pydoclint uses `py_console_script_binary` (its `main()` raises SystemExit,
so the upstream `{fn}()` template preserves exit codes). flake8 and pylint
return integer codes from their entry points, which the upstream template
drops (every run exits 0); they use `py_binary` wrappers with explicit
`sys.exit` over the same wheel-only deps.
"""

load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@aspect_rules_py//uv:defs.bzl", "py_console_script_binary")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pyproject.toml",
    "uv.lock",
])

py_console_script_binary(
    name = "pydoclint",
    dep_group = "dx-python-tools",
    pkg = "@pypi//pydoclint",
)

py_binary(
    name = "flake8",
    srcs = ["flake8_main.py"],
    dep_group = "dx-python-tools",
    main = "flake8_main.py",
    deps = ["@pypi//flake8"],
)

py_binary(
    name = "pylint",
    srcs = ["pylint_main.py"],
    dep_group = "dx-python-tools",
    main = "pylint_main.py",
    deps = ["@pypi//pylint"],
)

# Repository corpus (M05 WP1): build and project metadata owned for
# direct-Bazel dogfood under the canonical real_fixture_policy. Python
# entry wrappers and the uv lock stay dx-owned/unclassified, never corpus
# sources. The lock is a generated third-party manifest, excluded like
# other locks.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["pyproject.toml"],
)

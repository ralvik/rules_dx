"""Private wheel-only Python tool graph (pydoclint + flake8 + pylint).

Ruleset-owned ecosystem graph per tool-acquisition: rules_dx owns the
pyproject/uv.lock, exposes stable entry-point targets through authoritative
Python rules, and hides hub layout from consumers. All tools share the
managed 3.12 interpreter toolchain (no ambient Python).

Tools use explicit `py_binary` entry points to preserve exit codes and
avoid console-script discovery through a build-time Bash launcher on Windows.
"""

load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

exports_files([
    "pyproject.toml",
    "uv.lock",
])

py_binary(
    name = "pydoclint",
    srcs = ["pydoclint_main.py"],
    dep_group = "dx-python-tools",
    main = "pydoclint_main.py",
    deps = ["@pypi//pydoclint"],
)

py_binary(
    name = "flake8",
    srcs = ["flake8_main.py"],
    dep_group = "dx-python-tools",
    main = "flake8_main.py",
    deps = ["@pypi//flake8"],
)

py_binary(
    name = "pylint",
    srcs = ["pylint_main.py"],
    dep_group = "dx-python-tools",
    main = "pylint_main.py",
    deps = ["@pypi//pylint"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

real_source_target(
    name = "corpus_toml",
    tags = ["corpus"],
    toml_srcs = ["pyproject.toml"],
)

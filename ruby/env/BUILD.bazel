"""Focused Ruby environment plans.

Each `ruby_env_plan` reads the analyzed authoritative providers of one
`ruby_*` wrapper: `QualitySourcesInfo` for direct sources plus the
preserved `RubyFilesInfo` toolchain closure by reference.
Focused-target only; repository/root/exact-target orchestration remains.
"""

load("//quality:fixtures.bzl", "real_source_target")
load("//ruby/env:plan.bzl", "ruby_env_plan")
load("//ruby/env:plan_tests.bzl", "env_plan_tests")

package(default_visibility = ["//visibility:private"])

ruby_env_plan(
    name = "hello_lib_plan",
    testonly = True,
    target = "//ruby/tests/fixtures/hello:hello_lib",
)

env_plan_tests(
    name = "env_plan_tests",
    subjects = [
        ":hello_lib_plan",
    ],
)

real_source_target(
    name = "corpus_starlark",
    aspect_hints = ["//:buildifier_config"],
    starlark_srcs = [
        "BUILD.bazel",
        "plan.bzl",
        "plan_tests.bzl",
    ],
    tags = ["corpus"],
)

"""Upstream Ruby IDE tool acquisition.

The environment contract reuses the pinned Ruby interpreter; this package pins its acquisition.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//:__subpackages__"])

sh_test(
    name = "ide_acquisition_test",
    size = "small",
    timeout = "short",
    srcs = ["ide_acquisition_test.sh"],
    args = ["$(rootpath @ruby//:ruby)"],
    data = [
        "//tools/sh:bootstrap",
        "//tools/sh:lib",
        "@ruby",
    ],
    tags = ["no-coverage"],
    target_compatible_with = ["@platforms//os:linux"],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

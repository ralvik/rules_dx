load("@crates//:crates.bzl", "aliases", "crate_deps")

"""M07 WP1 + M08 WP1: quality command planning and scope resolution for the `dx` CLI."""

load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_binary", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "dx_cli",
    srcs = [
        "src/args.rs",
        "src/exec.rs",
        "src/finalize.rs",
        "src/generate.rs",
        "src/lib.rs",
        "src/plan.rs",
        "src/reports.rs",
        "src/resolve.rs",
    ],
    aliases = aliases(
        package_name = "dx/dx_cli",
        normal = True,
    ),
    crate_name = "dx_cli",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "libc",
            "quick-xml",
            "serde",
            "serde_json",
        ],
        package_name = "dx/dx_cli",
    ) + [
        "//dx/apply:dx_apply",
        "//dx/bep:dx_bep",
        "//dx/diff:dx_diff",
        "//dx/output:dx_output",
        "//dx/process:dx_process",
        "//generation/result:generation_result",
        "//quality/result:quality_result",
    ],
)

dx_rust_binary(
    name = "dx",
    srcs = ["src/main.rs"],
    aliases = aliases(
        package_name = "dx/dx_cli",
        normal = True,
    ),
    crate_name = "dx",
    crate_root = "src/main.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "libc",
            "quick-xml",
            "serde_json",
        ],
        package_name = "dx/dx_cli",
    ) + [
        ":dx_cli",
        "//dx/output:dx_output",
        "//dx/process:dx_process",
    ],
)

dx_rust_test(
    name = "dx_cli_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_cli",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_cli",
    edition = "2021",
    deps = crate_deps(
        [
            "libc",
            "quick-xml",
            "serde_json",
        ],
        package_name = "dx/dx_cli",
    ) + [
        "//dx/output:dx_output",
        "//dx/process:dx_process",
        "//quality/result:quality_result",
    ],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_cli_fmt_test",
    size = "small",
    targets = [
        ":dx_cli",
        ":dx",
    ],
)

rust_clippy_test(
    name = "dx_cli_clippy_test",
    size = "small",
    targets = [
        ":dx_cli",
        ":dx",
    ],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

"""M06 WP2 public output modes for the `dx` CLI."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//dx:__pkg__", "//dx:__subpackages__"])

rust_library(
    name = "dx_output",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_output",
        normal = True,
    ),
    crate_name = "dx_output",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        ["anstream", "clap", "console", "serde_json", "thiserror", "tracing", "tracing-subscriber"],
        package_name = "dx/dx_output",
    ) + [
        "//dx/digest:dx_digest",
        "//dx/path:dx_path",
        "//dx/schema:dx_schema",
    ],
)

rust_test(
    name = "dx_output_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_output",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_output",
    deps = crate_deps(
        ["anstream", "clap", "console", "serde_json", "thiserror", "tracing", "tracing-subscriber"],
        package_name = "dx/dx_output",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_output_fmt_test",
    size = "small",
    targets = [":dx_output"],
)

rust_clippy_test(
    name = "dx_output_clippy_test",
    size = "small",
    targets = [":dx_output"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

"""M25 WP1 slice 3: normalized codegen plan collection for the `dx` CLI."""

# gazelle:resolve rust codegen_shard //generation/codegen_shard
load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//dx:__pkg__",
    "//dx:__subpackages__",
])

rust_library(
    name = "dx_codegen",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_codegen",
        normal = True,
    ),
    crate_name = "dx_codegen",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
            "thiserror",
        ],
        package_name = "dx/dx_codegen",
    ) + [
        "//dx/bep:dx_bep",
        "//dx/digest:dx_digest",
        "//dx/roots:dx_roots",
        "//generation/codegen_shard",
    ],
)

rust_test(
    name = "dx_codegen_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_codegen",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_codegen",
    deps = crate_deps(
        [
            "serde",
            "serde_json",
            "thiserror",
        ],
        package_name = "dx/dx_codegen",
    ) + [
        "//dx/bep:dx_bep",
        "//generation/codegen_shard",
    ],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_codegen_fmt_test",
    size = "small",
    targets = [":dx_codegen"],
)

rust_clippy_test(
    name = "dx_codegen_clippy_test",
    size = "small",
    targets = [":dx_codegen"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

"""M25 WP3 slice 3: combined setup commit through the shared lock."""

load("@crates//:crates.bzl", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "dx_setup",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_setup",
        normal = True,
    ),
    crate_name = "dx_setup",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "//dx/env:dx_env",
        "//dx/roots:dx_roots",
        "//quality/result:quality_result",
    ],
)

dx_rust_test(
    name = "dx_setup_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_setup",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_setup",
    edition = "2021",
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_setup_fmt_test",
    size = "small",
    targets = [":dx_setup"],
)

rust_clippy_test(
    name = "dx_setup_clippy_test",
    size = "small",
    targets = [":dx_setup"],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

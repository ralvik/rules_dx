"""M25 WP5 slice 1: explicit `dx clean` pruning of unselected managed generations (O60)."""

# gazelle:resolve rust dx_env //dx/env:dx_env
load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//dx:__pkg__",
    "//dx:__subpackages__",
])

rust_library(
    name = "dx_clean",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_clean",
        normal = True,
    ),
    crate_name = "dx_clean",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        ["tempfile", "thiserror"],
        package_name = "dx/dx_clean",
    ) + [
        "//dx/env:dx_env",
        "//dx/setup:dx_setup",
    ],
)

rust_test(
    name = "dx_clean_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_clean",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_clean",
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_clean_fmt_test",
    size = "small",
    targets = [":dx_clean"],
)

rust_clippy_test(
    name = "dx_clean_clippy_test",
    size = "small",
    targets = [":dx_clean"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

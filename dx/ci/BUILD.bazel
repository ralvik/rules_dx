"""M27 WP1 slices 1-7 + WP2 slices 8-9 + WP4 slices 10-11 + WP6 slice 12: pure consumer-CI planning (selection, revision, scheduling, supersession, reporting, fork/aggregate, rerun/scope/retry/scanning, triggers/platforms/no-op/revalidation, caller composition/pins, audit rendering, untrusted validation/thread deltas, preset onboarding)."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//dx:__pkg__", "//dx:__subpackages__"])

rust_library(
    name = "dx_ci",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_ci",
        normal = True,
    ),
    crate_name = "dx_ci",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        ["thiserror"],
        package_name = "dx/dx_ci",
    ),
)

rust_test(
    name = "dx_ci_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_ci",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_ci",
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_ci_fmt_test",
    size = "small",
    targets = [":dx_ci"],
)

rust_clippy_test(
    name = "dx_ci_clippy_test",
    size = "small",
    targets = [":dx_ci"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

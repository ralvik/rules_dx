"""M25 WP2 slice 3: normalized env plan collection for the `dx` CLI."""

# gazelle:resolve rust env_shard //env/env_shard
load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//dx:__pkg__", "//dx:__subpackages__"])

rust_library(
    name = "dx_env_plan",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_env_plan",
        normal = True,
    ),
    crate_name = "dx_env_plan",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        ["thiserror"],
        package_name = "dx/dx_env_plan",
    ) + [
        "//dx/bep:dx_bep",
        "//dx/roots:dx_roots",
        "//env/env_shard",
        "//quality/result:quality_result",
    ],
)

rust_test(
    name = "dx_env_plan_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_env_plan",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_env_plan",
    deps = [
        "//dx/bep:dx_bep",
        "//env/env_shard",
    ],
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_env_plan_fmt_test",
    size = "small",
    targets = [":dx_env_plan"],
)

rust_clippy_test(
    name = "dx_env_plan_clippy_test",
    size = "small",
    targets = [":dx_env_plan"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

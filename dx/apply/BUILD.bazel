"""M06 WP3 apply boundary for the `dx` CLI."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//dx:__pkg__",
    "//dx:__subpackages__",
])

rust_library(
    name = "dx_apply",
    srcs = [
        "src/applier.rs",
        "src/consensus.rs",
        "src/envelope.rs",
        "src/lib.rs",
        "src/validators.rs",
    ],
    aliases = aliases(
        package_name = "dx/dx_apply",
        normal = True,
    ),
    crate_name = "dx_apply",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        [
            "hex",
            "serde",
            "serde_json",
            "sha2",
            "tempfile",
        ],
        package_name = "dx/dx_apply",
    ),
)

rust_test(
    name = "dx_apply_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_apply",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_apply",
    deps = crate_deps(
        [
            "hex",
            "serde",
            "serde_json",
            "sha2",
            "tempfile",
        ],
        package_name = "dx/dx_apply",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_apply_fmt_test",
    size = "small",
    targets = [":dx_apply"],
)

rust_clippy_test(
    name = "dx_apply_clippy_test",
    size = "small",
    targets = [":dx_apply"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

"""M26 WP1 slice 1: pure `dx audit` request planning (O11/O58)."""

load("@crates//:crates.bzl", "aliases", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "rust_library", "rust_test")

package(default_visibility = [
    "//dx:__pkg__",
    "//dx:__subpackages__",
])

rust_library(
    name = "dx_audit",
    srcs = [
        "src/exception.rs",
        "src/lib.rs",
        "src/license_expr.rs",
        "src/license_notice.rs",
        "src/license_policy.rs",
        "src/secrets.rs",
    ],
    aliases = aliases(
        package_name = "dx/dx_audit",
        normal = True,
    ),
    crate_name = "dx_audit",
    crate_root = "src/lib.rs",
    deps = crate_deps(
        [
            "chrono",
            "hex",
            "spdx",
            "thiserror",
            "url",
        ],
        package_name = "dx/dx_audit",
    ),
)

rust_test(
    name = "dx_audit_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_audit",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_audit",
    deps = crate_deps(
        [
            "chrono",
            "hex",
            "spdx",
            "thiserror",
            "url",
        ],
        package_name = "dx/dx_audit",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_audit_fmt_test",
    size = "small",
    targets = [":dx_audit"],
)

rust_clippy_test(
    name = "dx_audit_clippy_test",
    size = "small",
    targets = [":dx_audit"],
)

exports_files(
    ["Cargo.toml"],
    visibility = ["//visibility:public"],
)

# Repository corpus: crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)

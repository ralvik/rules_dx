"""Consumer-facing `//dx` facade (issue #76).

Starlark-only: no `Cargo.toml` / `src/` lives under `dx/`. The Rust
implementation moved to `cli/*`; this package reserves the canonical
consumer labels so external workspaces keep mirroring `//dx`.
Consumer policy defaults to ADR 0011.

PROVISIONAL (open decision O17, flagged for review): `config` is an empty
placeholder so the `@rules_dx//config:workspace` label flag has a resolvable
default. It is not a policy: aspects require the aggregate policy provider,
so selecting this placeholder fails fast at analysis until the typed
per-family sections and thin canonical aggregate land.
"""

load("@gazelle//:def.bzl", "gazelle")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Canonical public generation workflow: repository-wide
# default with scoped traversal from resolved scope (O48). The check
# twin shares the language wiring with upstream `-mode diff` encoded in
# canonical-target wiring (O13 dispatch): same rewrite and intended
# manifest, no workspace writes, nonzero exit on changes.
gazelle(
    name = "generate",
    gazelle = "//gazelle/rust:gazelle",
)

gazelle(
    name = "generate_check",
    gazelle = "//gazelle/rust:gazelle",
    mode = "diff",
)

# Canonical managed-environment bootstrap: installs the default
# staged tool tree into the workspace `.dx/bin` directory.
alias(
    name = "env",
    actual = "//cli/env:env",
)

# Canonical repository-wide codegen selection identity: bare
# `dx codegen` invokes `//dx:codegen`. PROVISIONAL (open decisions O33/O34,
# flagged for review): this empty filegroup only reserves the label so the
# CLI selection identity resolves before the WP4 root benchmark selects the
# effective Bazel roots (`//...` baseline versus query-produced pattern
# file). It contributes no plan records itself.
filegroup(
    name = "codegen",
    srcs = [],
)

filegroup(
    name = "config",
    srcs = [],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

"""Consumer canonical workspace policy package (ADR 0011).

PROVISIONAL (open decision O17, flagged for review): `config` is an empty
placeholder so the `@rules_dx//config:workspace` label flag has a resolvable
default. It is not a policy: aspects require the aggregate policy provider,
so selecting this placeholder fails fast at analysis until the typed
per-family sections and thin canonical aggregate land.
"""

load("@gazelle//:def.bzl", "gazelle")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Canonical public generation workflow (M10 WP1): repository-wide
# default with scoped traversal from resolved scope (O48). The check
# twin shares the language wiring with upstream `-mode diff` encoded in
# canonical-target wiring (O13 dispatch): same rewrite and intended
# manifest, no workspace writes, nonzero exit on changes.
gazelle(
    name = "generate",
    gazelle = "//gazelle/rust:gazelle",
)

gazelle(
    name = "generate_check",
    gazelle = "//gazelle/rust:gazelle",
    mode = "diff",
)

# Canonical managed-environment bootstrap (M11 WP2): installs the default
# staged tool tree into the workspace `.dx/bin` directory.
alias(
    name = "env",
    actual = "//dx/env:env",
)

filegroup(
    name = "config",
    srcs = [],
)

# Repository corpus (M05 WP1): build file owned for direct-Bazel dogfood
# under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
)

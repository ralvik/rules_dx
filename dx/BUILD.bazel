"""Consumer-facing `//dx` facade.

Starlark-only: no `Cargo.toml` / `src/` lives under `dx/`. The Rust
implementation moved to `cli/*`; this package reserves the canonical
consumer labels so external workspaces keep mirroring `//dx`.
Consumer policy defaults to ADR 0011.

Accepted: `config` stays an empty filegroup as the
resolvable default for the `@rules_dx//config:workspace` label flag.
It is not a policy: aspects require the aggregate `QualityPolicyInfo`
provider, so selecting this default fails fast at analysis until a
consumer binds its typed workspace policy. The typed per-family
sections and thin canonical aggregate are frozen in
`//quality:policy.bzl` (`quality_family`, `workspace_policy`,
freeze for) and `//quality:sources.bzl` (`QualitySourcesInfo`,
Freeze for) with validation; aspect binding to the workspace
flag stays deferred per `//quality:aspects.bzl`. Populating this
default with empty families would silently disable every capability
(worse than fail-fast), and duplicating the curated families would
create a second source of truth beside
`//quality:curated_defaults.bzl`. Guard:
`//tools/ci:dx_facade_qualification`.
"""

load("@gazelle//:def.bzl", "gazelle")
load("//quality:fixtures.bzl", "real_source_target")

package(default_visibility = ["//visibility:public"])

# Canonical public generation workflow: repository-wide
# default with scoped traversal from resolved scope. The check
# twin shares the language wiring with upstream `-mode diff` encoded in
# canonical-target wiring (dispatch): same rewrite and intended
# manifest, no workspace writes, nonzero exit on changes.
gazelle(
    name = "generate",
    gazelle = "//gazelle/rust:gazelle",
)

gazelle(
    name = "generate_check",
    gazelle = "//gazelle/rust:gazelle",
    mode = "diff",
)

# Canonical managed-environment bootstrap: installs the default
# staged tool tree into the workspace `.dx/bin` directory.
alias(
    name = "env",
    actual = "//cli/env:env",
)

# Canonical repository-wide codegen selection identity: bare
# `dx codegen` invokes `//dx:codegen`. Accepted: this empty
# filegroup reserves the label so the CLI selection identity resolves.
# It contributes
# no plan records itself; the real plan collector is the
# `dx_codegen_plan_aspect` plus the `dx_codegen_plans` output group
# (frozen in `//generation:codegen.bzl`, mirrored in
# `//cli/codegen`), and the effective roots stay on the frozen `//...`
# baseline per `//cli/roots`. Adding `srcs` would build a central
# eager dependency, which `docs/environments/codegen.md` rejects. Guard:
# `//tools/ci:dx_facade_qualification`.
filegroup(
    name = "codegen",
    srcs = [],
)

# Accepted: empty `//dx:config` default, see the package
# docstring. Guard: `//tools/ci:dx_facade_qualification`.
filegroup(
    name = "config",
    srcs = [],
)

real_source_target(
    name = "corpus_starlark",
    starlark_srcs = ["BUILD.bazel"],
    tags = ["corpus"],
)

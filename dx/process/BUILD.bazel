load("@crates//:crates.bzl", "aliases", "crate_deps")

"""M06 WP1 process boundary for the `dx` CLI."""

load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//quality:fixtures.bzl", "real_source_target")
load("//rust/rules:defs.bzl", "dx_rust_library", "dx_rust_test")

package(default_visibility = ["//visibility:public"])

dx_rust_library(
    name = "dx_process",
    srcs = ["src/lib.rs"],
    aliases = aliases(
        package_name = "dx/dx_process",
        normal = True,
    ),
    crate_name = "dx_process",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = crate_deps(
        ["libc"],
        package_name = "dx/dx_process",
    ),
)

dx_rust_test(
    name = "dx_process_test",
    size = "small",
    aliases = aliases(
        package_name = "dx/dx_process",
        normal = True,
        normal_dev = True,
    ),
    crate = ":dx_process",
    edition = "2021",
    deps = crate_deps(
        ["libc"],
        package_name = "dx/dx_process",
    ),
)

# Authoritative quality identities (M02 pattern): rustfmt and Clippy
# resolve from the pinned toolchain, never from ambient host tools.
rustfmt_test(
    name = "dx_process_fmt_test",
    size = "small",
    targets = [":dx_process"],
)

rust_clippy_test(
    name = "dx_process_clippy_test",
    size = "small",
    targets = [":dx_process"],
)

exports_files(["Cargo.toml"])

# Repository corpus (M05 WP1): crate manifest and build file owned for
# direct-Bazel dogfood under the canonical real_fixture_policy.
real_source_target(
    name = "corpus",
    starlark_srcs = ["BUILD.bazel"],
    toml_srcs = ["Cargo.toml"],
)
